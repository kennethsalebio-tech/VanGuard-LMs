{{> head}}
<body class="flex min-h-full flex-col bg-[#f4f8fc] text-slate-700 antialiased">
  <header class="border-b border-slate-200 bg-white">
    <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5 sm:px-8">
      <a href="/" class="flex items-center gap-3">
        <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-brand-500 shadow-lg shadow-brand-500/20">
          <svg class="h-5 w-5 text-white" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" /></svg>
        </span>
        <span class="text-base font-bold text-navy-900">Vanguard Learning</span>
      </a>
      <div class="flex items-center gap-3">
        {{#if currentUser}}
          <a href="/dashboard" class="text-sm font-semibold text-brand-600 hover:text-brand-700">Dashboard</a>
        {{else}}
          <a href="/login" class="text-sm font-semibold text-brand-600 hover:text-brand-700">Sign in</a>
        {{/if}}
      </div>
    </div>
  </header>

  <main class="mx-auto w-full max-w-2xl flex-1 px-5 py-12">
    <div class="text-center">
      <span class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-brand-50 text-brand-600">
        <svg class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
      </span>
      <h1 class="mt-4 text-2xl font-bold tracking-tight text-navy-900">Verify a certificate</h1>
      <p class="mx-auto mt-2 max-w-md text-sm text-slate-500">Enter the certificate ID or verification code printed on the credential. Verification is public and does not require an account.</p>
    </div>

    <form action="/verify" method="GET" class="mt-6 flex flex-col gap-2 rounded-2xl border border-slate-200 bg-white p-3 shadow-sm sm:flex-row">
      <input name="code" value="{{query}}" type="text" required placeholder="e.g. NWL-2026-0001 or verification code" class="field flex-1" />
      <button type="submit" class="rounded-xl bg-brand-600 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-700">Verify</button>
    </form>

    {{#if searched}}
      {{#if certificate}}
        <div class="mt-6 overflow-hidden rounded-2xl border border-emerald-200 bg-white shadow-card">
          <div class="flex items-center gap-3 bg-emerald-600 px-5 py-4 text-white">
            <span class="flex h-9 w-9 items-center justify-center rounded-full bg-white/15">
              <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
            </span>
            <div>
              <p class="text-sm font-bold">Valid certificate</p>
              <p class="text-xs text-emerald-100">This credential was issued by Vanguard Learning.</p>
            </div>
          </div>
          <dl class="divide-y divide-slate-100 px-5">
            <div class="flex flex-col gap-1 py-3 sm:flex-row sm:items-center sm:justify-between">
              <dt class="text-xs font-semibold uppercase tracking-wide text-slate-400">Learner</dt>
              <dd class="text-sm font-semibold text-navy-900">{{certificate.user.name}}</dd>
            </div>
            <div class="flex flex-col gap-1 py-3 sm:flex-row sm:items-center sm:justify-between">
              <dt class="text-xs font-semibold uppercase tracking-wide text-slate-400">Course</dt>
              <dd class="text-sm font-semibold text-navy-900">{{certificate.courseTitle}}</dd>
            </div>
            <div class="flex flex-col gap-1 py-3 sm:flex-row sm:items-center sm:justify-between">
              <dt class="text-xs font-semibold uppercase tracking-wide text-slate-400">Certificate ID</dt>
              <dd class="font-mono text-sm text-slate-700">{{certificate.certificateId}}</dd>
            </div>
            <div class="flex flex-col gap-1 py-3 sm:flex-row sm:items-center sm:justify-between">
              <dt class="text-xs font-semibold uppercase tracking-wide text-slate-400">Issued</dt>
              <dd class="text-sm text-slate-700">{{formatDate certificate.issuedAt}}</dd>
            </div>
            <div class="flex flex-col gap-1 py-3 sm:flex-row sm:items-center sm:justify-between">
              <dt class="text-xs font-semibold uppercase tracking-wide text-slate-400">Instructor</dt>
              <dd class="text-sm text-slate-700">{{certificate.instructorName}}</dd>
            </div>
          </dl>
        </div>
      {{else}}
        <div class="mt-6 rounded-2xl border border-rose-200 bg-rose-50 p-6 text-center">
          <p class="text-sm font-semibold text-rose-800">No certificate matches “{{query}}”</p>
          <p class="mt-1 text-xs text-rose-700">Check the code for typos, or contact the learning administrator who issued the credential.</p>
        </div>
      {{/if}}
    {{/if}}

    <div class="mt-8 rounded-2xl border border-slate-200 bg-white p-5">
      <p class="text-[10px] font-bold uppercase tracking-[0.14em] text-slate-400">What verification confirms</p>
      <p class="mt-2 text-xs leading-relaxed text-slate-500">A valid result confirms the learner completed every required lesson and passed the final knowledge checks for the named course. It does not expose assessment answers or personal contact details.</p>
    </div>
  </main>

{{> footer}}
