{{> app_start}}

<div class="mb-4 flex flex-col justify-between gap-3 sm:flex-row sm:items-end">
  <div class="min-w-0">
    <div class="flex flex-wrap items-center gap-2">
      <span class="flex items-center gap-1.5 rounded-full bg-emerald-50 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wide text-emerald-700">
        <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-emerald-500"></span>
        Live
      </span>
      <span class="rounded-full bg-slate-100 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wide text-slate-500">{{meeting.course.title}}</span>
      {{#if isModerator}}<span class="rounded-full bg-brand-600 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wide text-white">Host</span>{{/if}}
    </div>
    <h1 class="mt-2 truncate text-xl font-bold tracking-tight text-navy-900 sm:text-2xl">{{meeting.title}}</h1>
    <p class="mt-0.5 text-xs text-slate-500">
      Started {{formatDateTime meeting.startedAt}} ·
      <span id="invited-count">{{counts.invited}}</span> invited ·
      <span id="participant-summary">{{counts.totalJoined}}</span> participating
    </p>
  </div>
  <div class="flex shrink-0 gap-2">
    <a href="/live/{{meeting.id}}" class="rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold text-navy-900 transition hover:bg-slate-50">Meeting details</a>
  </div>
</div>

<div class="grid gap-4 xl:grid-cols-[minmax(0,1fr)_340px]">
  <section class="overflow-hidden rounded-2xl border border-slate-200 bg-navy-950 shadow-card">
    <div class="relative">
      <div id="video-stage" class="grid h-[58vh] min-h-[320px] w-full grid-cols-1 gap-1.5 bg-navy-950 p-1.5"></div>
      <div id="room-status" class="absolute left-3 top-3 z-10 hidden rounded-full bg-amber-500/90 px-2.5 py-1 text-[10px] font-bold text-white shadow">Reconnecting…</div>
      <div id="video-loader" class="absolute inset-0 flex flex-col items-center justify-center gap-3 bg-navy-950 px-6 text-center text-white">
        <span class="h-9 w-9 animate-spin rounded-full border-2 border-white/20 border-t-brand-400"></span>
        <p id="video-status" class="text-sm font-semibold">Initializing your live classroom…</p>
        <p id="video-status-detail" class="max-w-sm text-xs text-slate-400">Allow camera and microphone access when your browser asks. Chat and attendance keep working even if your camera is unavailable.</p>
      </div>
      <div id="video-error" class="absolute inset-0 hidden flex-col items-center justify-center gap-2 bg-navy-950/95 px-6 text-center text-white">
        <span class="flex h-12 w-12 items-center justify-center rounded-2xl bg-rose-500/20 text-rose-300">
          <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        </span>
        <p id="video-error-title" class="text-sm font-semibold">Camera unavailable</p>
        <p id="video-error-detail" class="max-w-md text-xs text-slate-400">Your camera could not be started. Check the browser permission and try again.</p>
        <div class="mt-2 flex flex-wrap items-center justify-center gap-2">
          <button id="btn-retry-camera" type="button" class="rounded-xl bg-brand-600 px-4 py-2 text-xs font-semibold text-white transition hover:bg-brand-700">Try camera again</button>
          <button id="btn-join-audio" type="button" class="rounded-xl border border-white/20 px-4 py-2 text-xs font-semibold text-white transition hover:bg-white/10">Join without camera</button>
        </div>
      </div>
    </div>

    <div class="flex flex-wrap items-center justify-between gap-2 border-t border-white/10 bg-brand-600 px-4 py-3">
      <div class="flex flex-wrap items-center gap-2">
        <button id="btn-mic" type="button" class="inline-flex items-center gap-2 rounded-xl bg-white/10 px-3 py-2 text-xs font-semibold text-white transition hover:bg-white/20">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 18.75a6 6 0 006-6v-1.5m-6 7.5a6 6 0 01-6-6v-1.5m6 13.5v-3.375c0-.621.504-1.125 1.125-1.125h2.25M12 4.5a3 3 0 00-3 3v6a3 3 0 006 0v-6a3 3 0 00-3-3z" /></svg>
          <span id="mic-label">Starting microphone…</span>
        </button>
        <button id="btn-cam" type="button" aria-pressed="false" class="inline-flex items-center gap-2 rounded-xl bg-white/10 px-3 py-2 text-xs font-semibold text-white transition hover:bg-white/20">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" /></svg>
          <span id="cam-label">Starting camera…</span>
        </button>
        <select id="cam-select" aria-label="Camera device" class="hidden max-w-[150px] rounded-xl border-0 bg-white/10 px-2 py-2 text-xs font-semibold text-white focus:ring-2 focus:ring-brand-400"></select>
        {{#if canShareScreen}}
          <button id="btn-share" type="button" class="inline-flex items-center gap-2 rounded-xl bg-white/10 px-3 py-2 text-xs font-semibold text-white transition hover:bg-white/20">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
            <span id="share-label">Share screen</span>
          </button>
        {{/if}}
        {{#if isModerator}}
          <button id="btn-mute-all" type="button" class="hidden items-center gap-2 rounded-xl bg-white/10 px-3 py-2 text-xs font-semibold text-white transition hover:bg-white/20 sm:inline-flex">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z" /><path stroke-linecap="round" stroke-linejoin="round" d="M17 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2" /></svg>
            Mute all
          </button>
        {{/if}}
      </div>
      <div class="flex items-center gap-2">
        <button id="btn-leave" type="button" class="inline-flex items-center gap-2 rounded-xl bg-rose-600 px-4 py-2 text-xs font-semibold text-white transition hover:bg-rose-700">Leave meeting</button>
        {{#if isModerator}}
          <button id="btn-end" type="button" class="inline-flex items-center gap-2 rounded-xl border border-white/20 px-4 py-2 text-xs font-semibold text-white transition hover:bg-white/10">End for all</button>
        {{/if}}
      </div>
    </div>
  </section>

  <aside class="space-y-4">
    <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
      <div class="flex items-center justify-between border-b border-slate-100 px-4 py-3">
        <h2 class="text-sm font-bold text-navy-900">Participants</h2>
        <span class="rounded-full bg-brand-50 px-2 py-0.5 text-[10px] font-bold text-brand-700"><span id="joined-count">{{counts.totalJoined}}</span> connected</span>
      </div>
      <div id="participant-list" class="max-h-64 space-y-1 overflow-y-auto px-2 py-2">
        {{#each participants}}
          <div class="flex items-center gap-2 rounded-lg px-2 py-1.5">
            <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full text-[10px] font-bold text-white" style="background-color: #1e3a6e">{{initials name}}</span>
            <span class="min-w-0 flex-1 truncate text-xs text-slate-700">{{name}}</span>
            {{#if isHost}}<span class="rounded-full bg-brand-600 px-2 py-0.5 text-[8px] font-bold uppercase tracking-wide text-white">Host</span>{{/if}}
          </div>
        {{/each}}
      </div>
      <p class="border-t border-slate-100 px-4 py-2 text-[10px] text-slate-400"><span id="invited-foot">{{counts.invited}}</span> learners invited · participation is recorded for attendance</p>
    </section>

    {{#if chatEnabled}}
      <section class="flex flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <div class="flex items-center justify-between border-b border-slate-100 px-4 py-3">
          <h2 class="text-sm font-bold text-navy-900">Meeting chat</h2>
          <span class="text-[10px] font-semibold uppercase tracking-wide text-slate-400">Live</span>
        </div>
        <div id="chat-messages" class="h-52 space-y-2 overflow-y-auto px-4 py-3 text-xs text-slate-600">
          <p id="chat-empty" class="text-center text-[11px] text-slate-400">No messages yet.</p>
        </div>
        <form id="chat-form" class="border-t border-slate-100 p-3">
          <div class="flex items-center gap-2">
            <input id="chat-input" type="text" maxlength="800" autocomplete="off" placeholder="Message the class…" class="field" />
            <button type="submit" class="shrink-0 rounded-xl bg-brand-600 px-3 py-2 text-xs font-semibold text-white transition hover:bg-brand-700">Send</button>
          </div>
        </form>
      </section>
    {{/if}}
  </aside>
</div>

<script>
  window.__VANGUARD_ROOM__ = {
    id: {{meeting.id}},
    token: {{json token}},
    csrf: {{json csrfToken}},
    userId: {{userId}},
    isModerator: {{#if isModerator}}true{{else}}false{{/if}},
    chatEnabled: {{#if chatEnabled}}true{{else}}false{{/if}},
    canShareScreen: {{#if canShareScreen}}true{{else}}false{{/if}},
    detailsUrl: "/live/{{meeting.id}}",
    rtc: {{json rtc}}
  };
</script>
<script src="/js/live-room.js" defer></script>

{{> app_end}}
