{{> app_start}}

<section class="relative mb-6 overflow-hidden rounded-2xl border border-slate-200 bg-white px-5 py-6 sm:px-7 sm:py-7">
  <div class="pointer-events-none absolute -right-16 -top-24 h-64 w-64 rounded-full bg-brand-100/60 blur-2xl"></div>
  <div class="relative flex flex-col justify-between gap-5 lg:flex-row lg:items-center">
    <div>
      <p class="text-[10px] font-bold uppercase tracking-[0.16em] text-brand-600">Administration</p>
      <h1 class="mt-1 text-2xl font-extrabold tracking-tight text-navy-900 sm:text-[1.7rem]">System overview</h1>
      <p class="mt-1 text-[13px] text-slate-500">Users, courses, enrollments, assessment outcomes, and recent platform activity.</p>
    </div>
    <div class="flex flex-wrap gap-2">
      <a href="/admin/users" class="rounded-lg border border-slate-200 bg-white px-4 py-2.5 text-[13px] font-semibold text-navy-900 transition hover:border-brand-200 hover:bg-brand-50/40">Manage users</a>
      <a href="/admin/reports" class="ui-btn ui-btn-primary !py-2.5 text-[13px]">Open reports</a>
    </div>
  </div>
</section>

<div class="mb-6 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
  <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
    <div class="flex items-start justify-between gap-3">
      <div>
        <p class="text-[10px] font-bold uppercase tracking-[0.12em] text-slate-400">Total users</p>
        <p class="mt-2 text-[2rem] font-extrabold leading-none tracking-tight text-navy-900">{{stats.totalUsers}}</p>
      </div>
      <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-brand-50 text-brand-600"><svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" /></svg></span>
    </div>
    <p class="mt-3 text-[11px] text-slate-400">{{stats.learners}} learners · {{stats.instructors}} instructors</p>
  </div>
  <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
    <div class="flex items-start justify-between gap-3">
      <div>
        <p class="text-[10px] font-bold uppercase tracking-[0.12em] text-slate-400">Employees on record</p>
        <p class="mt-2 text-[2rem] font-extrabold leading-none tracking-tight text-navy-900">{{stats.employees}}</p>
      </div>
      <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-brand-50 text-brand-600"><svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg></span>
    </div>
    <p class="mt-3 text-[11px] text-slate-400">Linked to HR profiles</p>
  </div>
  <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
    <div class="flex items-start justify-between gap-3">
      <div>
        <p class="text-[10px] font-bold uppercase tracking-[0.12em] text-slate-400">Courses</p>
        <p class="mt-2 text-[2rem] font-extrabold leading-none tracking-tight text-navy-900">{{stats.courses}}</p>
      </div>
      <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-brand-50 text-brand-600"><svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" /></svg></span>
    </div>
    <p class="mt-3 text-[11px] text-slate-400">{{stats.activeCourses}} published · {{stats.completedEnrollments}} completions</p>
  </div>
  <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
    <div class="flex items-start justify-between gap-3">
      <div>
        <p class="text-[10px] font-bold uppercase tracking-[0.12em] text-slate-400">Overall completion</p>
        <p class="mt-2 text-[2rem] font-extrabold leading-none tracking-tight text-navy-900">{{stats.overallCompletion}}%</p>
      </div>
      <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-emerald-50 text-emerald-600"><svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg></span>
    </div>
    <p class="mt-3 text-[11px] text-slate-400">{{stats.certificates}} certificates issued</p>
  </div>
</div>

<div class="grid gap-6 xl:grid-cols-3">
  <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm xl:col-span-2">
    <div class="flex items-center justify-between">
      <div>
        <h2 class="text-sm font-bold text-navy-900">Enrollment & completion trend</h2>
        <p class="mt-0.5 text-xs text-slate-400">Last six months</p>
      </div>
      <span class="rounded-full bg-brand-50 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wide text-brand-700">Live data</span>
    </div>
    <div class="mt-4 h-64">
      <canvas id="monthly-chart"></canvas>
    </div>
  </section>

  <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
    <h2 class="text-sm font-bold text-navy-900">Completion by department</h2>
    <p class="mt-0.5 text-xs text-slate-400">Average learner progress</p>
    <div class="mt-4 h-64">
      {{#if chart.departments.length}}
        <canvas id="department-chart"></canvas>
      {{else}}
        <div class="flex h-full items-center justify-center rounded-xl bg-slate-50 text-xs text-slate-400">No department data yet.</div>
      {{/if}}
    </div>
  </section>

  <section class="rounded-2xl border border-slate-200 bg-white shadow-sm xl:col-span-2">
    <div class="flex items-center justify-between border-b border-slate-100 px-5 py-4">
      <h2 class="text-sm font-bold text-navy-900">Course enrollment</h2>
      <a href="/admin/courses" class="text-xs font-semibold text-brand-600">All courses</a>
    </div>
    <div class="h-64 p-5">
      {{#if chart.courses.length}}
        <canvas id="course-chart"></canvas>
      {{else}}
        <div class="flex h-full items-center justify-center rounded-xl bg-slate-50 text-xs text-slate-400">No enrollments yet.</div>
      {{/if}}
    </div>
  </section>

  <section class="rounded-2xl border border-slate-200 bg-white shadow-sm">
    <div class="flex items-center justify-between border-b border-slate-100 px-5 py-4">
      <h2 class="text-sm font-bold text-navy-900">Recent activity</h2>
      <a href="/admin/logs" class="text-xs font-semibold text-brand-600">Audit log</a>
    </div>
    {{#if recentActivity}}
      <div class="divide-y divide-slate-100">
        {{#each recentActivity}}
          <div class="px-5 py-3">
            <p class="text-xs font-semibold text-navy-900">{{action}}</p>
            <p class="mt-0.5 truncate text-[10px] text-slate-400">{{#if user}}{{user.name}}{{else}}System{{/if}} · {{formatDateTime createdAt}}</p>
            {{#if detail}}<p class="mt-0.5 truncate text-[10px] text-slate-500">{{detail}}</p>{{/if}}
          </div>
        {{/each}}
      </div>
    {{else}}
      <p class="px-5 py-8 text-center text-xs text-slate-500">No activity recorded yet.</p>
    {{/if}}
  </section>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
  (function () {
    if (typeof Chart === "undefined") return;
    const monthly = {{{json chart.monthly}}};
    const departments = {{{json chart.departments}}};
    const courses = {{{json chart.courses}}};

    const monthlyEl = document.getElementById("monthly-chart");
    if (monthlyEl) {
      new Chart(monthlyEl, {
        type: "line",
        data: {
          labels: monthly.labels,
          datasets: [
            { label: "Enrollments", data: monthly.enrollments, borderColor: "#0966d5", backgroundColor: "rgba(9,102,213,0.10)", fill: true, tension: 0.35, borderWidth: 2, pointRadius: 3 },
            { label: "Completions", data: monthly.completions, borderColor: "#0e9f6e", backgroundColor: "rgba(14,159,110,0.08)", fill: true, tension: 0.35, borderWidth: 2, pointRadius: 3 },
            { label: "Assessments", data: monthly.assessments, borderColor: "#d97706", backgroundColor: "transparent", tension: 0.35, borderWidth: 2, borderDash: [5, 4], pointRadius: 2 }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { position: "bottom", labels: { boxWidth: 10, font: { size: 10 } } } },
          scales: {
            y: { beginAtZero: true, ticks: { precision: 0, font: { size: 10 } }, grid: { color: "#f1f5f9" } },
            x: { grid: { display: false }, ticks: { font: { size: 10 } } }
          }
        }
      });
    }

    const deptEl = document.getElementById("department-chart");
    if (deptEl) {
      new Chart(deptEl, {
        type: "bar",
        data: {
          labels: departments.map((d) => d.name),
          datasets: [{ label: "Avg progress %", data: departments.map((d) => d.percent), backgroundColor: "#0966d5", borderRadius: 6, maxBarThickness: 34 }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { display: false } },
          scales: {
            y: { beginAtZero: true, max: 100, ticks: { font: { size: 10 }, callback: (v) => v + "%" }, grid: { color: "#f1f5f9" } },
            x: { grid: { display: false }, ticks: { font: { size: 9 } } }
          }
        }
      });
    }

    const courseEl = document.getElementById("course-chart");
    if (courseEl) {
      new Chart(courseEl, {
        type: "bar",
        data: {
          labels: courses.map((c) => c.title.length > 28 ? c.title.slice(0, 28) + "…" : c.title),
          datasets: [
            { label: "Enrolled", data: courses.map((c) => c.enrolled), backgroundColor: "#0b1b3a", borderRadius: 5 },
            { label: "Completed", data: courses.map((c) => c.completed), backgroundColor: "#0e9f6e", borderRadius: 5 }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { position: "bottom", labels: { boxWidth: 10, font: { size: 10 } } } },
          scales: {
            y: { beginAtZero: true, ticks: { precision: 0, font: { size: 10 } }, grid: { color: "#f1f5f9" } },
            x: { grid: { display: false }, ticks: { font: { size: 9 } } }
          }
        }
      });
    }
  })();
</script>

{{> app_end}}
