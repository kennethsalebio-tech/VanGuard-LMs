{{> app_start}}

<div class="mb-6 flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
  <div>
    <div class="mb-2 flex items-center gap-2 text-xs text-slate-400">
      <a href="/admin/finance" class="hover:text-brand-600">Finance &amp; billing</a>
      <span>/</span>
      <span class="text-slate-600">Transactions</span>
    </div>
    <h1 class="text-2xl font-bold tracking-tight text-navy-900 sm:text-3xl">Transactions</h1>
    <p class="mt-1 text-sm text-slate-500">Verified and pending course payments recorded by the billing service.</p>
  </div>
  <a href="/admin/finance" class="rounded-lg border border-slate-300 bg-white px-3 py-2 text-xs font-semibold text-navy-900 transition hover:bg-slate-50">Back to finance</a>
</div>

{{#if error}}
  <div class="rounded-2xl border border-rose-200 bg-white p-6 shadow-sm">
    <h2 class="text-sm font-bold text-navy-900">Transactions could not be loaded</h2>
    <p class="mt-1 text-sm text-slate-600">{{error.message}}</p>
    <p class="mt-2 text-xs text-slate-400">No transaction rows are displayed while the billing service is unavailable.</p>
    <a href="/admin/finance/transactions" class="mt-4 inline-flex rounded-xl bg-brand-600 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-700">Retry</a>
  </div>
{{else}}
  <form action="/admin/finance/transactions" method="GET" class="mb-5 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
    <div class="grid gap-3 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <label for="search" class="label">Search</label>
        <input id="search" name="search" type="search" value="{{query.search}}" placeholder="Reference, learner, email, course or receipt" class="field" />
      </div>
      <div class="lg:col-span-2">
        <label for="status" class="label">Status</label>
        <select id="status" name="status" class="field">
          <option value="">All statuses</option>
          <option value="paid" {{#if (eq query.status "paid")}}selected{{/if}}>Paid</option>
          <option value="pending" {{#if (eq query.status "pending")}}selected{{/if}}>Pending</option>
          <option value="failed" {{#if (eq query.status "failed")}}selected{{/if}}>Failed</option>
          <option value="cancelled" {{#if (eq query.status "cancelled")}}selected{{/if}}>Cancelled</option>
          <option value="refunded" {{#if (eq query.status "refunded")}}selected{{/if}}>Refunded</option>
        </select>
      </div>
      <div class="lg:col-span-2">
        <label for="courseId" class="label">Course</label>
        <select id="courseId" name="courseId" class="field">
          <option value="">All courses</option>
          {{#each courses}}
            <option value="{{courseId}}" {{#if (eq courseId ../query.courseId)}}selected{{/if}}>{{title}}</option>
          {{/each}}
        </select>
      </div>
      <div class="lg:col-span-2">
        <label for="from" class="label">From</label>
        <input id="from" name="from" type="date" value="{{query.from}}" class="field" />
      </div>
      <div class="lg:col-span-2">
        <label for="to" class="label">To</label>
        <input id="to" name="to" type="date" value="{{query.to}}" class="field" />
      </div>
    </div>
    <div class="mt-3 flex flex-wrap items-center gap-2">
      <button type="submit" class="rounded-xl bg-brand-600 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-700">Apply filters</button>
      <a href="/admin/finance/transactions" class="rounded-xl border border-slate-300 px-4 py-2.5 text-sm font-semibold text-navy-900 transition hover:bg-slate-50">Reset</a>
      <span class="text-[11px] text-slate-400">{{number data.pagination.total}} transaction{{#if (ne data.pagination.total 1)}}s{{/if}} match</span>
    </div>
  </form>

  <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
    {{#if data.items.length}}
      <div class="overflow-x-auto">
        <table class="min-w-full text-left text-sm">
          <thead class="bg-slate-50 text-[10px] uppercase tracking-wide text-slate-500">
            <tr>
              <th class="px-5 py-3 font-semibold"><a href="{{links.sort.createdAt}}" class="hover:text-brand-600">Transaction</a></th>
              <th class="px-4 py-3 font-semibold"><a href="{{links.sort.learnerName}}" class="hover:text-brand-600">Learner</a></th>
              <th class="px-4 py-3 font-semibold"><a href="{{links.sort.courseTitle}}" class="hover:text-brand-600">Course</a></th>
              <th class="px-4 py-3 font-semibold">Method</th>
              <th class="px-4 py-3 font-semibold"><a href="{{links.sort.amount}}" class="hover:text-brand-600">Amount</a></th>
              <th class="px-4 py-3 font-semibold">Payment date</th>
              <th class="px-4 py-3 font-semibold"><a href="{{links.sort.status}}" class="hover:text-brand-600">Status</a></th>
              <th class="px-5 py-3 font-semibold">Receipt</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {{#each data.items}}
              <tr class="hover:bg-slate-50/60">
                <td class="px-5 py-3">
                  <p class="font-mono text-[11px] font-semibold text-navy-900">{{reference}}</p>
                  <p class="text-[10px] text-slate-400">{{formatDateTime createdAt}}</p>
                </td>
                <td class="px-4 py-3">
                  <p class="text-xs font-semibold text-navy-900">{{learnerName}}</p>
                  <p class="text-[10px] text-slate-400">{{learnerEmail}}</p>
                </td>
                <td class="max-w-[240px] px-4 py-3 text-xs text-slate-600"><span class="line-clamp-2">{{courseTitle}}</span></td>
                <td class="px-4 py-3 text-[11px] text-slate-500">{{paymentMethod}}</td>
                <td class="px-4 py-3 text-xs font-semibold text-navy-900">{{peso amount currency}}</td>
                <td class="px-4 py-3 text-[11px] text-slate-500">{{#if paidAt}}{{formatDateTime paidAt}}{{else}}—{{/if}}</td>
                <td class="px-4 py-3">{{> payment-badge status=status}}</td>
                <td class="px-5 py-3">
                  {{#if receiptNumber}}
                    <a href="/admin/finance/receipts/{{reference}}" class="rounded-lg border border-slate-300 px-2.5 py-1 text-[11px] font-semibold text-navy-900 transition hover:bg-slate-50">Receipt</a>
                  {{else}}
                    <span class="text-[11px] text-slate-400">—</span>
                  {{/if}}
                </td>
              </tr>
            {{/each}}
          </tbody>
        </table>
      </div>

      <div class="flex flex-wrap items-center justify-between gap-3 border-t border-slate-100 px-5 py-4">
        <p class="text-[11px] text-slate-400">
          Page {{data.pagination.page}} of {{data.pagination.pages}} · {{data.pagination.perPage}} per page
        </p>
        <div class="flex items-center gap-2">
          {{#if links.prev}}
            <a href="{{links.prev}}" class="rounded-lg border border-slate-300 px-3 py-1.5 text-xs font-semibold text-navy-900 transition hover:bg-slate-50">Previous</a>
          {{/if}}
          {{#if links.next}}
            <a href="{{links.next}}" class="rounded-lg border border-slate-300 px-3 py-1.5 text-xs font-semibold text-navy-900 transition hover:bg-slate-50">Next</a>
          {{/if}}
        </div>
      </div>
    {{else}}
      <p class="px-5 py-14 text-center text-sm text-slate-500">No transactions match these filters.</p>
    {{/if}}
  </div>
{{/if}}

{{> app_end}}
