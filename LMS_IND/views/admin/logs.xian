{{> app_start}}

<div class="mb-6 flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
  <div>
    <p class="text-xs font-bold uppercase tracking-[0.16em] text-brand-600">Governance</p>
    <h1 class="mt-1.5 text-2xl font-bold tracking-tight text-navy-900 sm:text-3xl">Audit logs</h1>
    <p class="mt-1 text-sm text-slate-500">The most recent 200 recorded actions across authentication, courses, assessments, and administration.</p>
  </div>
  <span class="rounded-full border border-slate-200 bg-white px-3 py-1.5 text-xs font-semibold text-slate-600">{{logs.length}} entries</span>
</div>

<div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
  {{#if logs.length}}
    <div class="max-h-[70vh] overflow-auto">
      <table class="min-w-full text-left text-xs">
        <thead class="sticky top-0 z-10 bg-slate-50 text-[10px] uppercase tracking-wide text-slate-500">
          <tr>
            <th class="px-5 py-3 font-semibold">When</th>
            <th class="px-4 py-3 font-semibold">Actor</th>
            <th class="px-4 py-3 font-semibold">Action</th>
            <th class="px-4 py-3 font-semibold">Entity</th>
            <th class="px-4 py-3 font-semibold">Detail</th>
            <th class="px-5 py-3 font-semibold">IP</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          {{#each logs}}
            <tr class="hover:bg-slate-50/60">
              <td class="whitespace-nowrap px-5 py-2.5 text-[10px] text-slate-400">{{formatDateTime createdAt}}</td>
              <td class="px-4 py-2.5">
                {{#if user}}
                  <p class="font-semibold text-navy-900">{{user.name}}</p>
                  <p class="text-[10px] capitalize text-slate-400">{{user.role}}</p>
                {{else}}
                  <span class="text-slate-400">System</span>
                {{/if}}
              </td>
              <td class="px-4 py-2.5 font-medium text-slate-700">{{action}}</td>
              <td class="px-4 py-2.5 text-slate-500">{{#if entityType}}<span class="capitalize">{{entityType}}</span>{{#if entityId}} #{{entityId}}{{/if}}{{else}}—{{/if}}</td>
              <td class="max-w-[320px] px-4 py-2.5"><p class="truncate text-slate-500">{{#if detail}}{{detail}}{{else}}—{{/if}}</p></td>
              <td class="px-5 py-2.5 font-mono text-[10px] text-slate-400">{{#if ip}}{{ip}}{{else}}—{{/if}}</td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  {{else}}
    <p class="px-5 py-14 text-center text-sm text-slate-500">No activity has been recorded yet.</p>
  {{/if}}
</div>

<p class="mt-4 text-[11px] text-slate-400">Audit entries are append-only in the application. Database-level retention and external SIEM export are not configured in this build.</p>

{{> app_end}}
