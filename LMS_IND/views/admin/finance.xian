{{> app_start}}

<div class="mb-6 flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
  <div>
    <p class="text-xs font-bold uppercase tracking-[0.16em] text-brand-600">Administration</p>
    <h1 class="mt-1.5 text-2xl font-bold tracking-tight text-navy-900 sm:text-3xl">Finance &amp; billing</h1>
    <p class="mt-1 text-sm text-slate-500">Revenue, payments and paid course sales served live by the Vanguard billing service.</p>
  </div>
  <div class="flex flex-wrap items-center gap-2">
    <a href="/admin/finance/simulated" class="inline-flex items-center gap-2 rounded-lg border border-amber-300 bg-amber-50 px-3 py-2 text-xs font-semibold text-amber-800 transition hover:bg-amber-100">
      <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
      Simulated payments
    </a>
    <a href="/admin/finance" class="rounded-lg border border-slate-300 bg-white px-3 py-2 text-xs font-semibold text-navy-900 transition hover:bg-slate-50">Refresh</a>
    <a href="/admin/finance/transactions" class="rounded-xl bg-brand-600 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-700">Transactions</a>
  </div>
</div>

{{#if error}}
  <div class="rounded-2xl border border-rose-200 bg-white p-6 shadow-sm">
    <div class="flex items-start gap-3">
      <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-rose-50 text-rose-600">
        <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
      </span>
      <div>
        <h2 class="text-sm font-bold text-navy-900">Finance data could not be loaded</h2>
        <p class="mt-1 text-sm text-slate-600">{{error.message}}</p>
        <p class="mt-2 text-xs text-slate-400">No finance figures are shown while the billing service is unavailable, so nothing on this page can be mistaken for real revenue. All other LMS features keep working.</p>
        <p class="mt-2 text-[11px] text-slate-400">Reference: {{error.code}}{{#if error.status}} · HTTP {{error.status}}{{/if}}</p>
        <a href="/admin/finance" class="mt-4 inline-flex items-center gap-2 rounded-xl bg-brand-600 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-700">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" /></svg>
          Retry connection
        </a>
      </div>
    </div>
  </div>
{{else}}
  {{#if data.environment.checkoutNotice}}
    <div class="mb-5 flex items-start gap-3 rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900">
      <svg class="mt-0.5 h-4 w-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z" /></svg>
      <span><strong>{{#if (eq data.environment.mode "sandbox")}}Test payment environment.{{else}}Live payment environment.{{/if}}</strong> {{data.environment.checkoutNotice}}</span>
    </div>
  {{/if}}

  <div class="mb-6 grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
    <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <div class="flex items-start justify-between">
        <p class="text-[11px] font-bold uppercase tracking-[0.12em] text-slate-400">Total revenue</p>
        <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-emerald-50 text-xs font-bold text-emerald-700">₱</span>
      </div>
      <p class="mt-3 text-3xl font-extrabold text-navy-900">{{peso data.totals.revenue}}</p>
      <p class="mt-1 text-xs text-slate-400">Verified successful payments only</p>
    </article>

    <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <p class="text-[11px] font-bold uppercase tracking-[0.12em] text-slate-400">Successful payments</p>
      <p class="mt-3 text-3xl font-extrabold text-navy-900">{{number data.totals.successfulPayments}}</p>
      <p class="mt-1 text-xs text-slate-400">Receipts issued automatically</p>
    </article>

    <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <p class="text-[11px] font-bold uppercase tracking-[0.12em] text-slate-400">Pending payments</p>
      <p class="mt-3 text-3xl font-extrabold text-amber-600">{{number data.totals.pendingPayments}}</p>
      <p class="mt-1 text-xs text-slate-400">Awaiting provider confirmation</p>
    </article>

    <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <p class="text-[11px] font-bold uppercase tracking-[0.12em] text-slate-400">Failed payments</p>
      <p class="mt-3 text-3xl font-extrabold text-rose-600">{{number data.totals.failedPayments}}</p>
      <p class="mt-1 text-xs text-slate-400">Failed or cancelled checkouts</p>
    </article>

    <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <p class="text-[11px] font-bold uppercase tracking-[0.12em] text-slate-400">Paid course sales</p>
      <p class="mt-3 text-3xl font-extrabold text-navy-900">{{number data.totals.paidCourseSales}}</p>
      <p class="mt-1 text-xs text-slate-400">{{number data.totals.paidCourses}} courses currently priced</p>
    </article>

    <article class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <p class="text-[11px] font-bold uppercase tracking-[0.12em] text-slate-400">Refunds</p>
      <p class="mt-3 text-3xl font-extrabold text-sky-700">{{number data.totals.refunds}}</p>
      <p class="mt-1 text-xs text-slate-400">{{peso data.totals.refundedAmount}} refunded</p>
    </article>
  </div>

  <div class="mb-6 grid gap-4 xl:grid-cols-3">
    <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm xl:col-span-2">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-sm font-bold text-navy-900">Revenue analytics</h2>
          <p class="mt-0.5 text-xs text-slate-400">Monthly verified revenue, last 6 months</p>
        </div>
        <span class="rounded-full bg-slate-100 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wide text-slate-500">{{data.environment.provider}}</span>
      </div>
      <div class="mt-4 h-64">
        <canvas id="finance-revenue-chart"></canvas>
      </div>
    </section>

    <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <h2 class="text-sm font-bold text-navy-900">Course sales performance</h2>
      <p class="mt-0.5 text-xs text-slate-400">Top paid courses by revenue</p>
      {{#if data.courseSales.length}}
        <div class="mt-4 space-y-3">
          {{#each data.courseSales}}
            <div class="rounded-xl border border-slate-100 bg-slate-50/70 p-3">
              <div class="flex items-start justify-between gap-3">
                <p class="line-clamp-2 text-xs font-semibold text-navy-900">{{courseTitle}}</p>
                <span class="shrink-0 text-xs font-bold text-navy-900">{{peso revenue}}</span>
              </div>
              <p class="mt-1 text-[11px] text-slate-400">{{sales}} sale{{#if (gt sales 1)}}s{{/if}}</p>
            </div>
          {{/each}}
        </div>
      {{else}}
        <p class="mt-4 rounded-xl border border-dashed border-slate-200 px-3 py-8 text-center text-xs text-slate-400">No paid course sales recorded yet.</p>
      {{/if}}
    </section>
  </div>

  <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-100 px-5 py-4">
      <div>
        <h2 class="text-sm font-bold text-navy-900">Recent transactions</h2>
        <p class="mt-0.5 text-xs text-slate-400">Latest payments recorded by the billing service</p>
      </div>
      <a href="/admin/finance/transactions" class="text-xs font-semibold text-brand-600 hover:text-brand-700">View all transactions →</a>
    </div>
    {{#if data.recentTransactions.length}}
      <div class="overflow-x-auto">
        <table class="min-w-full text-left text-sm">
          <thead class="bg-slate-50 text-[10px] uppercase tracking-wide text-slate-500">
            <tr>
              <th class="px-5 py-3 font-semibold">Transaction</th>
              <th class="px-4 py-3 font-semibold">Learner</th>
              <th class="px-4 py-3 font-semibold">Course</th>
              <th class="px-4 py-3 font-semibold">Amount</th>
              <th class="px-4 py-3 font-semibold">Date</th>
              <th class="px-4 py-3 font-semibold">Status</th>
              <th class="px-5 py-3 font-semibold">Receipt</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            {{#each data.recentTransactions}}
              <tr class="hover:bg-slate-50/60">
                <td class="px-5 py-3 font-mono text-[11px] font-semibold text-navy-900">{{reference}}</td>
                <td class="px-4 py-3">
                  <p class="text-xs font-semibold text-navy-900">{{learnerName}}</p>
                  <p class="text-[10px] text-slate-400">{{learnerEmail}}</p>
                </td>
                <td class="max-w-[220px] px-4 py-3 text-xs text-slate-600"><span class="line-clamp-1">{{courseTitle}}</span></td>
                <td class="px-4 py-3 text-xs font-semibold text-navy-900">{{peso amount currency}}</td>
                <td class="px-4 py-3 text-[11px] text-slate-500">{{formatDate paidAt}}{{#unless paidAt}}{{formatDate createdAt}}{{/unless}}</td>
                <td class="px-4 py-3">{{> payment-badge status=status}}</td>
                <td class="px-5 py-3">
                  {{#if receiptNumber}}
                    <a href="/admin/finance/receipts/{{reference}}" class="rounded-lg border border-slate-300 px-2.5 py-1 text-[11px] font-semibold text-navy-900 transition hover:bg-slate-50">View</a>
                  {{else}}
                    <span class="text-[11px] text-slate-400">Available when paid</span>
                  {{/if}}
                </td>
              </tr>
            {{/each}}
          </tbody>
        </table>
      </div>
    {{else}}
      <p class="px-5 py-14 text-center text-sm text-slate-500">No transactions have been recorded yet.</p>
    {{/if}}
  </section>

  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
  <script>
    (function () {
      if (typeof Chart === "undefined") return;
      const series = {{{json data.monthlyRevenue}}};
      const canvas = document.getElementById("finance-revenue-chart");
      if (!canvas || !series.length) return;
      new Chart(canvas, {
        type: "line",
        data: {
          labels: series.map((row) => row.label),
          datasets: [
            {
              label: "Revenue (PHP)",
              data: series.map((row) => row.revenue),
              borderColor: "#0966d5",
              backgroundColor: "rgba(9, 102, 213, 0.10)",
              fill: true,
              tension: 0.35,
              pointRadius: 3,
              pointBackgroundColor: "#0966d5"
            }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { display: false },
            tooltip: {
              callbacks: {
                label: (item) => "PHP " + Number(item.raw).toLocaleString("en-PH", { minimumFractionDigits: 2 })
              }
            }
          },
          scales: {
            y: {
              beginAtZero: true,
              ticks: { font: { size: 10 }, callback: (value) => "₱" + Number(value).toLocaleString("en-PH") },
              grid: { color: "#f1f5f9" }
            },
            x: { grid: { display: false }, ticks: { font: { size: 10 } } }
          }
        }
      });
    })();
  </script>
{{/if}}

{{> app_end}}
