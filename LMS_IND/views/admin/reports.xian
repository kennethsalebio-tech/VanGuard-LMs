{{> app_start}}

<div class="mb-6 flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
  <div>
    <p class="text-xs font-bold uppercase tracking-[0.16em] text-brand-600">Analytics</p>
    <h1 class="mt-1.5 text-2xl font-bold tracking-tight text-navy-900 sm:text-3xl">Reports & analytics</h1>
    <p class="mt-1 text-sm text-slate-500">Compliance, completion, assessment outcomes, and enrollment detail. Export any dataset to CSV.</p>
  </div>
  <div class="flex flex-wrap gap-2">
    {{#each exportTypes}}
      <a href="/admin/reports/export/{{this}}" class="rounded-lg border border-slate-300 bg-white px-3 py-2 text-xs font-semibold capitalize text-navy-900 transition hover:bg-slate-50">{{this}} CSV</a>
    {{/each}}
  </div>
</div>

<div class="mb-6 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
  <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
    <p class="text-[11px] font-bold uppercase tracking-[0.12em] text-slate-400">Employee compliance</p>
    <p class="mt-3 text-3xl font-extrabold text-navy-900">{{compliance.stats.compliance}}%</p>
    <p class="mt-1 text-xs text-slate-400">{{compliance.stats.employees}} employees</p>
  </div>
  <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
    <p class="text-[11px] font-bold uppercase tracking-[0.12em] text-slate-400">Assignments completed</p>
    <p class="mt-3 text-3xl font-extrabold text-emerald-600">{{compliance.stats.completedAssignments}}</p>
    <p class="mt-1 text-xs text-slate-400">{{compliance.stats.pendingAssignments}} pending</p>
  </div>
  <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
    <p class="text-[11px] font-bold uppercase tracking-[0.12em] text-slate-400">Certificates issued</p>
    <p class="mt-3 text-3xl font-extrabold text-navy-900">{{certificates.length}}</p>
    <p class="mt-1 text-xs text-slate-400">Across all courses</p>
  </div>
  <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
    <p class="text-[11px] font-bold uppercase tracking-[0.12em] text-slate-400">Overdue assignments</p>
    <p class="mt-3 text-3xl font-extrabold {{#if compliance.stats.overdueAssignments}}text-rose-600{{else}}text-emerald-600{{/if}}">{{compliance.stats.overdueAssignments}}</p>
    <p class="mt-1 text-xs text-slate-400">Past due date</p>
  </div>
</div>

<div class="grid gap-6 xl:grid-cols-2">
  <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
    <div class="flex items-center justify-between border-b border-slate-100 px-5 py-4">
      <h2 class="text-sm font-bold text-navy-900">Course completion</h2>
      <a href="/admin/reports/export/completion" class="text-xs font-semibold text-brand-600">Export</a>
    </div>
    <div class="overflow-x-auto">
      <table class="min-w-full text-left text-xs">
        <thead class="bg-slate-50 text-[10px] uppercase tracking-wide text-slate-500">
          <tr><th class="px-5 py-2.5 font-semibold">Course</th><th class="px-3 py-2.5 font-semibold">Enrolled</th><th class="px-3 py-2.5 font-semibold">Completed</th><th class="px-3 py-2.5 font-semibold">Rate</th><th class="px-5 py-2.5 font-semibold">Avg progress</th></tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          {{#each courseRows}}
            <tr class="hover:bg-slate-50/60">
              <td class="max-w-[200px] px-5 py-2.5"><p class="truncate font-semibold text-navy-900">{{course.title}}</p><p class="text-[10px] text-slate-400">{{course.instructor.name}}</p></td>
              <td class="px-3 py-2.5 text-slate-600">{{enrolled}}</td>
              <td class="px-3 py-2.5 font-semibold text-emerald-600">{{completed}}</td>
              <td class="px-3 py-2.5 text-slate-600">{{rate}}%</td>
              <td class="px-5 py-2.5">
                <div class="flex items-center gap-2">
                  <div class="h-1.5 w-16 overflow-hidden rounded-full bg-slate-100"><div class="h-full rounded-full bg-brand-500" style="width: {{avgProgress}}%"></div></div>
                  <span class="text-[10px] text-slate-500">{{avgProgress}}%</span>
                </div>
              </td>
            </tr>
          {{/each}}
        </tbody>
      </table>
      {{#unless courseRows.length}}<p class="px-5 py-8 text-center text-xs text-slate-500">No course data.</p>{{/unless}}
    </div>
  </section>

  <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
    <div class="flex items-center justify-between border-b border-slate-100 px-5 py-4">
      <h2 class="text-sm font-bold text-navy-900">Recent assessment attempts</h2>
      <a href="/admin/reports/export/assessments" class="text-xs font-semibold text-brand-600">Export</a>
    </div>
    <div class="max-h-[420px] overflow-y-auto">
      <table class="min-w-full text-left text-xs">
        <thead class="sticky top-0 bg-slate-50 text-[10px] uppercase tracking-wide text-slate-500">
          <tr><th class="px-5 py-2.5 font-semibold">Learner</th><th class="px-3 py-2.5 font-semibold">Lesson</th><th class="px-3 py-2.5 font-semibold">Score</th><th class="px-3 py-2.5 font-semibold">Result</th><th class="px-5 py-2.5 font-semibold">Date</th></tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          {{#each attempts}}
            <tr class="hover:bg-slate-50/60">
              <td class="max-w-[140px] px-5 py-2.5"><p class="truncate font-medium text-navy-900">{{user.name}}</p><p class="truncate text-[10px] text-slate-400">{{course.title}}</p></td>
              <td class="max-w-[140px] px-3 py-2.5"><p class="truncate text-slate-600">{{lesson.title}}</p></td>
              <td class="px-3 py-2.5 font-semibold text-navy-900">{{score}}/{{totalQuestions}}</td>
              <td class="px-3 py-2.5">
                {{#if passed}}<span class="rounded-full bg-emerald-50 px-2 py-0.5 text-[9px] font-bold uppercase text-emerald-700">Pass</span>
                {{else}}<span class="rounded-full bg-rose-50 px-2 py-0.5 text-[9px] font-bold uppercase text-rose-700">Fail</span>{{/if}}
              </td>
              <td class="px-5 py-2.5 text-[10px] text-slate-400">{{formatDate submittedAt}}</td>
            </tr>
          {{/each}}
        </tbody>
      </table>
      {{#unless attempts.length}}<p class="px-5 py-8 text-center text-xs text-slate-500">No submitted attempts yet.</p>{{/unless}}
    </div>
  </section>

  <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm xl:col-span-2">
    <div class="flex items-center justify-between border-b border-slate-100 px-5 py-4">
      <h2 class="text-sm font-bold text-navy-900">Employee compliance detail</h2>
      <a href="/admin/reports/export/compliance" class="text-xs font-semibold text-brand-600">Export</a>
    </div>
    <div class="overflow-x-auto">
      <table class="min-w-full text-left text-xs">
        <thead class="bg-slate-50 text-[10px] uppercase tracking-wide text-slate-500">
          <tr><th class="px-5 py-2.5 font-semibold">Employee</th><th class="px-3 py-2.5 font-semibold">Department</th><th class="px-3 py-2.5 font-semibold">Position</th><th class="px-3 py-2.5 font-semibold">Assigned</th><th class="px-3 py-2.5 font-semibold">Completed</th><th class="px-3 py-2.5 font-semibold">Overdue</th><th class="px-5 py-2.5 font-semibold">Compliance</th></tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          {{#each compliance.rows}}
            <tr class="hover:bg-slate-50/60">
              <td class="px-5 py-2.5"><p class="font-semibold text-navy-900">{{employee.name}}</p><p class="text-[10px] text-slate-400">{{employee.employeeId}} · {{employee.email}}</p></td>
              <td class="px-3 py-2.5 text-slate-600">{{#if employee.department}}{{employee.department.name}}{{else}}—{{/if}}</td>
              <td class="px-3 py-2.5 text-slate-600">{{#if employee.position}}{{employee.position.title}}{{else}}—{{/if}}</td>
              <td class="px-3 py-2.5 text-slate-600">{{assigned}}</td>
              <td class="px-3 py-2.5 font-semibold text-emerald-600">{{completed}}</td>
              <td class="px-3 py-2.5 {{#if overdue}}font-semibold text-rose-600{{else}}text-slate-400{{/if}}">{{overdue}}</td>
              <td class="px-5 py-2.5 font-semibold text-navy-900">{{#if compliance}}{{compliance}}%{{else}}N/A{{/if}}</td>
            </tr>
          {{/each}}
        </tbody>
      </table>
      {{#unless compliance.rows.length}}<p class="px-5 py-8 text-center text-xs text-slate-500">No employee profiles.</p>{{/unless}}
    </div>
  </section>

  <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm xl:col-span-2">
    <div class="flex items-center justify-between border-b border-slate-100 px-5 py-4">
      <h2 class="text-sm font-bold text-navy-900">Recent enrollments</h2>
      <a href="/admin/reports/export/enrollments" class="text-xs font-semibold text-brand-600">Export</a>
    </div>
    <div class="max-h-[360px] overflow-y-auto">
      <table class="min-w-full text-left text-xs">
        <thead class="sticky top-0 bg-slate-50 text-[10px] uppercase tracking-wide text-slate-500">
          <tr><th class="px-5 py-2.5 font-semibold">Learner</th><th class="px-3 py-2.5 font-semibold">Course</th><th class="px-3 py-2.5 font-semibold">Source</th><th class="px-3 py-2.5 font-semibold">Status</th><th class="px-5 py-2.5 font-semibold">Enrolled</th></tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          {{#each enrollments}}
            <tr class="hover:bg-slate-50/60">
              <td class="px-5 py-2.5"><p class="font-medium text-navy-900">{{user.name}}</p><p class="text-[10px] text-slate-400">{{user.email}}</p></td>
              <td class="max-w-[220px] px-3 py-2.5"><p class="truncate text-slate-600">{{course.title}}</p></td>
              <td class="px-3 py-2.5 capitalize text-slate-500">{{source}}</td>
              <td class="px-3 py-2.5"><span class="rounded-full px-2 py-0.5 text-[9px] font-bold uppercase {{#if (eq status "completed")}}bg-emerald-50 text-emerald-700{{else}}bg-brand-50 text-brand-700{{/if}}">{{status}}</span></td>
              <td class="px-5 py-2.5 text-[10px] text-slate-400">{{formatDate createdAt}}</td>
            </tr>
          {{/each}}
        </tbody>
      </table>
      {{#unless enrollments.length}}<p class="px-5 py-8 text-center text-xs text-slate-500">No enrollments yet.</p>{{/unless}}
    </div>
  </section>
</div>

{{> app_end}}
