{{> app_start}}

<div class="mb-5 no-print flex items-center justify-between gap-3">
  <div>
    <a href="/admin/finance/transactions" class="text-xs font-semibold text-slate-400 hover:text-brand-600">← Back to transactions</a>
    <h1 class="mt-2 text-2xl font-bold tracking-tight text-navy-900">Payment receipt</h1>
  </div>
  {{#if receipt}}
    <button type="button" onclick="window.print()" class="rounded-xl bg-brand-600 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-700">Print receipt</button>
  {{/if}}
</div>

{{#if error}}
  <div class="rounded-2xl border border-rose-200 bg-white p-6 shadow-sm">
    <h2 class="text-sm font-bold text-navy-900">Receipt unavailable</h2>
    <p class="mt-1 text-sm text-slate-600">{{error.message}}</p>
    <a href="/admin/finance/transactions" class="mt-4 inline-flex rounded-xl bg-brand-600 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-700">Back to transactions</a>
  </div>
{{else}}
  <section class="print-reset mx-auto max-w-2xl overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-card">
    <div class="border-b border-slate-100 bg-brand-600 px-6 py-5 text-white sm:px-8">
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="text-[10px] font-bold uppercase tracking-[0.18em] text-brand-300">Official receipt</p>
          <h2 class="mt-1 text-xl font-extrabold">Vanguard Learning</h2>
          <p class="mt-1 text-xs text-slate-300">Integrated Learning Management System</p>
        </div>
        <div class="text-right">
          <p class="text-[10px] uppercase tracking-wide text-slate-400">Receipt no.</p>
          <p class="font-mono text-sm font-bold">{{receipt.receiptNumber}}</p>
        </div>
      </div>
    </div>

    <div class="px-6 py-6 sm:px-8">
      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <p class="text-[10px] font-bold uppercase tracking-[0.14em] text-slate-400">Billed to</p>
          <p class="mt-1.5 text-sm font-semibold text-navy-900">{{receipt.learnerName}}</p>
          <p class="text-xs text-slate-500">{{receipt.learnerEmail}}</p>
        </div>
        <div class="sm:text-right">
          <p class="text-[10px] font-bold uppercase tracking-[0.14em] text-slate-400">Issued</p>
          <p class="mt-1.5 text-sm font-semibold text-navy-900">{{formatDateTime receipt.issuedAt}}</p>
          <p class="text-xs text-slate-500">Status: {{receipt.status}}</p>
        </div>
      </div>

      <div class="mt-6 overflow-hidden rounded-xl border border-slate-200">
        <table class="min-w-full text-left text-sm">
          <thead class="bg-slate-50 text-[10px] uppercase tracking-wide text-slate-500">
            <tr>
              <th class="px-4 py-2.5 font-semibold">Description</th>
              <th class="px-4 py-2.5 text-right font-semibold">Amount</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="px-4 py-3">
                <p class="text-sm font-semibold text-navy-900">{{receipt.courseTitle}}</p>
                <p class="text-[11px] text-slate-400">Course purchase · reference {{receipt.reference}}</p>
              </td>
              <td class="px-4 py-3 text-right text-sm font-semibold text-navy-900">{{peso receipt.amount receipt.currency}}</td>
            </tr>
          </tbody>
          <tfoot class="bg-slate-50">
            <tr>
              <td class="px-4 py-3 text-xs font-bold uppercase tracking-wide text-slate-500">Total paid</td>
              <td class="px-4 py-3 text-right text-base font-extrabold text-navy-900">{{peso receipt.amount receipt.currency}}</td>
            </tr>
          </tfoot>
        </table>
      </div>

      <div class="mt-5 grid gap-2 text-xs text-slate-500 sm:grid-cols-2">
        <p><span class="font-semibold text-slate-600">Payment method:</span> {{receipt.paymentMethod}}</p>
        <p><span class="font-semibold text-slate-600">Provider:</span> {{receipt.provider}}</p>
        {{#if receipt.refundedAt}}
          <p><span class="font-semibold text-slate-600">Refunded:</span> {{formatDateTime receipt.refundedAt}} ({{peso receipt.refundAmount receipt.currency}})</p>
        {{/if}}
      </div>

      {{#if (eq receipt.environment "sandbox")}}
        <div class="mt-5 rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-xs text-amber-900">
          <strong>Test payment environment.</strong> This receipt was generated from a simulated sandbox payment. No real money was collected.
        </div>
      {{/if}}

      <p class="mt-6 border-t border-slate-100 pt-4 text-[11px] leading-relaxed text-slate-400">
        This receipt is generated from the verified payment record held by the Vanguard billing service. Keep the receipt number for your records.
      </p>
    </div>
  </section>

  {{#if (eq receipt.status "paid")}}
    <section class="no-print mt-4 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <h2 class="text-sm font-bold text-navy-900">Refund management</h2>
      <p class="mt-0.5 text-xs text-slate-400">Record a refund on the billing service. Course access is not revoked automatically.</p>
      <form action="/admin/finance/refunds/{{receipt.reference}}" method="POST" data-confirm="Record a full refund for this payment?" class="mt-3 flex flex-col gap-2 sm:flex-row">
        <input type="hidden" name="_csrf" value="{{csrfToken}}" />
        <input type="text" name="reason" maxlength="250" placeholder="Refund reason (optional)" class="field flex-1" />
        <button type="submit" class="rounded-xl border border-rose-300 bg-rose-50 px-4 py-2.5 text-sm font-semibold text-rose-700 transition hover:bg-rose-100">Refund payment</button>
      </form>
    </section>
  {{/if}}
{{/if}}

{{> app_end}}
