{{> app_start}}

<div class="mb-6">
  <p class="text-xs font-bold uppercase tracking-[0.16em] text-brand-600">Account</p>
  <h1 class="mt-1.5 text-2xl font-bold tracking-tight text-navy-900 sm:text-3xl">Profile & settings</h1>
  <p class="mt-1 text-sm text-slate-500">Manage your display name, contact email, avatar color, and password.</p>
</div>

<div class="grid gap-6 xl:grid-cols-3">
  <div class="space-y-6 xl:col-span-2">
    <section class="rounded-2xl border border-slate-200 bg-white shadow-sm">
      <div class="border-b border-slate-100 px-5 py-4">
        <h2 class="text-sm font-bold text-navy-900">Personal information</h2>
      </div>
      <form action="/profile" method="POST" class="p-5 sm:p-6">
        <input type="hidden" name="_csrf" value="{{csrfToken}}" />
        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label for="name" class="label">Full name</label>
            <input id="name" name="name" type="text" required value="{{profile.name}}" class="field" />
          </div>
          <div>
            <label for="email" class="label">Work email</label>
            <input id="email" name="email" type="email" required value="{{profile.email}}" class="field" />
          </div>
          <div>
            <label for="avatarColor" class="label">Avatar color</label>
            <div class="flex items-center gap-3">
              <input id="avatarColor" name="avatarColor" type="color" value="{{profile.avatarColor}}" class="h-10 w-14 cursor-pointer rounded-lg border border-slate-300 bg-white p-1" />
              <span class="text-xs text-slate-400">Used for your avatar initials across the LMS.</span>
            </div>
          </div>
          <div>
            <label class="label">Role</label>
            <p class="field bg-slate-50 capitalize text-slate-500">{{profile.role}}</p>
          </div>
        </div>
        <div class="mt-5 flex justify-end">
          <button type="submit" class="rounded-xl bg-brand-600 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-700">Save changes</button>
        </div>
      </form>
    </section>

    <section class="rounded-2xl border border-slate-200 bg-white shadow-sm">
      <div class="border-b border-slate-100 px-5 py-4">
        <h2 class="text-sm font-bold text-navy-900">Change password</h2>
        <p class="mt-0.5 text-xs text-slate-400">Use at least 8 characters. Your current password is required.</p>
      </div>
      <form action="/profile/password" method="POST" class="p-5 sm:p-6">
        <input type="hidden" name="_csrf" value="{{csrfToken}}" />
        <div class="grid gap-4 sm:grid-cols-3">
          <div>
            <label for="current_password" class="label">Current password</label>
            <input id="current_password" name="current_password" type="password" autocomplete="current-password" required class="field" />
          </div>
          <div>
            <label for="new_password" class="label">New password</label>
            <input id="new_password" name="new_password" type="password" autocomplete="new-password" minlength="8" required class="field" />
          </div>
          <div>
            <label for="confirm_password" class="label">Confirm new password</label>
            <input id="confirm_password" name="confirm_password" type="password" autocomplete="new-password" minlength="8" required class="field" />
          </div>
        </div>
        <div class="mt-5 flex justify-end">
          <button type="submit" class="rounded-xl bg-brand-600 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-700">Update password</button>
        </div>
      </form>
    </section>
  </div>

  <aside class="space-y-4">
    <div class="rounded-2xl border border-slate-200 bg-white p-5 text-center shadow-sm">
      <span class="mx-auto flex h-20 w-20 items-center justify-center rounded-full text-2xl font-bold text-white" style="background-color: {{profile.avatarColor}}">{{initials profile.name}}</span>
      <p class="mt-3 text-base font-bold text-navy-900">{{profile.name}}</p>
      <p class="text-xs text-slate-400">{{profile.email}}</p>
      <span class="mt-2 inline-flex rounded-full bg-brand-50 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wide text-brand-700">{{profile.role}}</span>
    </div>

    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <p class="text-[10px] font-bold uppercase tracking-[0.14em] text-slate-400">Employment</p>
      <dl class="mt-3 space-y-3 text-xs">
        <div>
          <dt class="text-slate-400">Employee ID</dt>
          <dd class="mt-0.5 font-semibold text-navy-900">{{#if profile.employeeId}}{{profile.employeeId}}{{else}}Not linked{{/if}}</dd>
        </div>
        <div>
          <dt class="text-slate-400">Department</dt>
          <dd class="mt-0.5 font-semibold text-navy-900">{{#if profile.department}}{{profile.department.name}}{{else}}Unassigned{{/if}}</dd>
        </div>
        <div>
          <dt class="text-slate-400">Position</dt>
          <dd class="mt-0.5 font-semibold text-navy-900">{{#if profile.position}}{{profile.position.title}}{{else}}Unassigned{{/if}}</dd>
        </div>
        <div>
          <dt class="text-slate-400">Employment status</dt>
          <dd class="mt-0.5 font-semibold capitalize text-navy-900">{{profile.employmentStatus}}</dd>
        </div>
        <div>
          <dt class="text-slate-400">Last sign-in</dt>
          <dd class="mt-0.5 font-semibold text-navy-900">{{#if profile.lastLoginAt}}{{formatDateTime profile.lastLoginAt}}{{else}}—{{/if}}</dd>
        </div>
      </dl>
      {{#if (eq profile.role "learner")}}
        <p class="mt-4 border-t border-slate-100 pt-3 text-[11px] leading-relaxed text-slate-400">HR manages employment details. Contact your administrator to update your department or position.</p>
      {{/if}}
    </div>

    <div class="rounded-2xl bg-navy-900 p-5 text-white">
      <p class="text-[10px] font-bold uppercase tracking-[0.16em] text-brand-300">Account security</p>
      <p class="mt-2 text-sm leading-relaxed text-slate-300">Sessions are protected with HTTP-only cookies and CSRF tokens. Sign-in attempts are rate limited.</p>
      <a href="/logout" class="mt-4 inline-flex text-xs font-semibold text-white underline underline-offset-4">Sign out of this device</a>
    </div>
  </aside>
</div>

{{> app_end}}
