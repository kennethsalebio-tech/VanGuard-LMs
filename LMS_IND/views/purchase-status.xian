{{> app_start}}

<div class="mb-4 flex items-center gap-2 text-xs text-slate-400">
  <a href="/courses" class="hover:text-brand-600">Catalog</a>
  <span>/</span>
  <a href="/courses/{{course.id}}" class="truncate hover:text-brand-600">{{course.title}}</a>
  <span>/</span>
  <span class="text-slate-600">Purchase status</span>
</div>

<div class="mx-auto max-w-2xl">
  <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-card">
    <div class="border-b border-slate-100 px-6 py-5">
      <p class="text-[10px] font-bold uppercase tracking-[0.16em] text-brand-600">Course purchase</p>
      <h1 class="mt-1 text-xl font-bold text-navy-900">{{course.title}}</h1>
      <p class="mt-1 text-sm text-slate-500">{{peso course.price course.currency}} · reference {{purchase.reference}}</p>
    </div>

    <div class="px-6 py-6">
      {{#if error}}
        <div class="rounded-xl border border-rose-200 bg-rose-50 px-4 py-4 text-sm text-rose-800">
          <p class="font-semibold">We could not confirm your payment right now</p>
          <p class="mt-1 text-xs">{{error.message}}</p>
          <p class="mt-2 text-xs">Your payment has not been marked as verified, so the course stays locked. Please check again in a moment.</p>
        </div>
        <div class="mt-5 flex flex-wrap gap-2">
          <a href="/courses/{{course.id}}/purchase/{{purchase.reference}}" class="rounded-xl bg-brand-600 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-700">Check again</a>
          <a href="/courses/{{course.id}}" class="rounded-xl border border-slate-300 px-4 py-2.5 text-sm font-semibold text-navy-900 transition hover:bg-slate-50">Back to course</a>
        </div>
      {{else if (eq purchase.status "paid")}}
        <div class="flex items-start gap-3 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-4 text-emerald-900">
          <svg class="mt-0.5 h-5 w-5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
          <div>
            <p class="text-sm font-bold">Payment verified — course unlocked</p>
            <p class="mt-1 text-xs">Your enrollment is active. You can start with the first lesson right away.</p>
            {{#if purchase.receiptNumber}}
              <p class="mt-2 text-[11px]">Receipt {{purchase.receiptNumber}} · paid {{formatDateTime purchase.paidAt}}</p>
            {{/if}}
          </div>
        </div>
        <a href="/courses/{{course.id}}" class="mt-5 flex w-full items-center justify-center gap-2 rounded-xl bg-brand-600 px-4 py-3 text-sm font-semibold text-white transition hover:bg-brand-700">
          Start learning
          <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
        </a>
      {{else if (eq purchase.status "pending")}}
        <div class="flex items-start gap-3 rounded-xl border border-amber-200 bg-amber-50 px-4 py-4 text-amber-900">
          <svg class="mt-0.5 h-5 w-5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 2m6-2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          <div>
            <p class="text-sm font-bold">Payment pending</p>
            <p class="mt-1 text-xs">The payment provider has not confirmed this transaction yet. The course unlocks automatically as soon as verification succeeds.</p>
            <p class="mt-2 text-[11px]">Returning to this page never unlocks the course by itself — access is granted only after the billing service verifies the payment.</p>
          </div>
        </div>
        <div class="mt-5 flex flex-wrap gap-2">
          <a href="/courses/{{course.id}}/purchase/{{purchase.reference}}" class="rounded-xl bg-brand-600 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-700">Check status</a>
          <form action="/courses/{{course.id}}/purchase" method="POST">
            <input type="hidden" name="_csrf" value="{{csrfToken}}" />
            <button type="submit" class="rounded-xl border border-slate-300 px-4 py-2.5 text-sm font-semibold text-navy-900 transition hover:bg-slate-50">Continue to payment page</button>
          </form>
          <a href="/courses/{{course.id}}" class="rounded-xl border border-slate-300 px-4 py-2.5 text-sm font-semibold text-navy-900 transition hover:bg-slate-50">Back to course</a>
        </div>
      {{else if (eq purchase.status "refunded")}}
        <div class="rounded-xl border border-sky-200 bg-sky-50 px-4 py-4 text-sm text-sky-900">
          <p class="font-semibold">This purchase was refunded</p>
          <p class="mt-1 text-xs">Contact the administrator if you need access again. A new purchase is required.</p>
        </div>
        <a href="/courses/{{course.id}}" class="mt-5 inline-flex rounded-xl bg-brand-600 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-700">Back to course</a>
      {{else}}
        <div class="rounded-xl border border-rose-200 bg-rose-50 px-4 py-4 text-sm text-rose-900">
          <p class="font-semibold">Payment not completed</p>
          <p class="mt-1 text-xs">This transaction was {{purchase.status}}. No access was granted and nothing else will be charged until you start a new checkout.</p>
        </div>
        <div class="mt-5 flex flex-wrap gap-2">
          <form action="/courses/{{course.id}}/purchase" method="POST">
            <input type="hidden" name="_csrf" value="{{csrfToken}}" />
            <button type="submit" class="rounded-xl bg-brand-600 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-700">Try payment again</button>
          </form>
          <a href="/courses/{{course.id}}" class="rounded-xl border border-slate-300 px-4 py-2.5 text-sm font-semibold text-navy-900 transition hover:bg-slate-50">Back to course</a>
        </div>
      {{/if}}

      <dl class="mt-6 grid gap-2 border-t border-slate-100 pt-4 text-xs text-slate-500 sm:grid-cols-2">
        <div><dt class="font-semibold text-slate-600">Amount</dt><dd>{{peso purchase.amount purchase.currency}}</dd></div>
        <div><dt class="font-semibold text-slate-600">Payment method</dt><dd>{{purchase.provider}}</dd></div>
        <div><dt class="font-semibold text-slate-600">Started</dt><dd>{{formatDateTime purchase.createdAt}}</dd></div>
        <div><dt class="font-semibold text-slate-600">Status</dt><dd class="capitalize">{{purchase.status}}</dd></div>
      </dl>
    </div>
  </section>
</div>

{{> app_end}}
