{{> head}}
<body class="min-h-full bg-[#f4f8fc] text-slate-700 antialiased">
  <div id="sidebar-overlay" class="fixed inset-0 z-30 hidden bg-navy-900/40 backdrop-blur-sm lg:hidden" onclick="toggleSidebar(false)"></div>

  <aside id="sidebar" class="fixed inset-y-0 left-0 z-40 flex w-[272px] max-w-[85vw] -translate-x-full flex-col border-r border-slate-200 bg-white transition-transform duration-200 ease-out lg:max-w-none lg:translate-x-0">
    <div class="flex h-[72px] shrink-0 items-center justify-between gap-3 border-b border-slate-100 px-5">
      <a href="/" class="flex items-center gap-3">
        <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-brand-500 shadow-lg shadow-brand-500/20">
          <svg class="h-5 w-5 text-white" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
          </svg>
        </span>
        <span>
          <span class="block text-[15px] font-extrabold leading-tight tracking-tight text-navy-900">Vanguard Learning</span>
          <span class="mt-0.5 block text-[9px] font-bold uppercase tracking-[0.16em] text-slate-400">Integrated LMS</span>
        </span>
      </a>
      <button type="button" onclick="toggleSidebar(false)" class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg text-slate-400 transition hover:bg-slate-100 hover:text-navy-900 lg:hidden" aria-label="Close menu">
        <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
      </button>
    </div>

    <nav class="flex-1 overflow-y-auto px-3 py-4">
      {{#if (eq currentUser.role "learner")}}
        <p class="px-3 pb-2 text-[10px] font-bold uppercase tracking-[0.14em] text-slate-400">Overview</p>
        <div class="space-y-0.5">
          <a href="/dashboard" class="group flex items-center gap-3 rounded-lg px-3 py-2.5 text-[13px] font-medium transition {{isActive currentPath "/dashboard"}}">
            <svg class="h-[18px] w-[18px] shrink-0" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" /></svg>
            Dashboard
          </a>
          <a href="/courses" class="group flex items-center gap-3 rounded-lg px-3 py-2.5 text-[13px] font-medium transition {{isActive currentPath "/courses"}}">
            <svg class="h-[18px] w-[18px] shrink-0" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" /></svg>
            My courses
          </a>
          <a href="/assessments" class="group flex items-center gap-3 rounded-lg px-3 py-2.5 text-[13px] font-medium transition {{isActive currentPath "/assessments"}}">
            <svg class="h-[18px] w-[18px] shrink-0" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" /></svg>
            Assessments
          </a>
          <a href="/billing" class="group flex items-center gap-3 rounded-lg px-3 py-2.5 text-[13px] font-medium transition {{isActive currentPath "/billing"}}">
            <svg class="h-[18px] w-[18px] shrink-0" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 10h18M5 6h14a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2zm3 8h4" /></svg>
            Billing
            <span class="ml-auto rounded-md border border-amber-200 bg-amber-50 px-1.5 py-0.5 text-[9px] font-bold uppercase tracking-wide text-amber-700">Demo</span>
          </a>
        </div>

        <p class="px-3 pb-2 pt-6 text-[10px] font-bold uppercase tracking-[0.14em] text-slate-400">Learning</p>
        <div class="space-y-0.5">
          <a href="/live" class="group flex items-center gap-3 rounded-lg px-3 py-2.5 text-[13px] font-medium transition {{isActive currentPath "/live"}}">
            <svg class="h-[18px] w-[18px] shrink-0" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" /></svg>
            Live classes
          </a>
          <a href="/certificates" class="group flex items-center gap-3 rounded-lg px-3 py-2.5 text-[13px] font-medium transition {{isActive currentPath "/certificates"}}">
            <svg class="h-[18px] w-[18px] shrink-0" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" /></svg>
            Certificates
          </a>
          <a href="/notifications" class="group flex items-center gap-3 rounded-lg px-3 py-2.5 text-[13px] font-medium transition {{isActive currentPath "/notifications"}}">
            <svg class="h-[18px] w-[18px] shrink-0" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" /></svg>
            Notifications
            {{#if unreadCount}}<span class="ml-auto rounded-full bg-brand-500 px-2 py-0.5 text-[10px] font-bold text-white">{{unreadCount}}</span>{{/if}}
          </a>
        </div>
      {{/if}}

      {{#if (eq currentUser.role "instructor")}}
        <p class="px-3 pb-2 text-[10px] font-bold uppercase tracking-[0.14em] text-slate-400">Teaching</p>
        <div class="space-y-0.5">
          <a href="/instructor" class="group flex items-center gap-3 rounded-lg px-3 py-2.5 text-[13px] font-medium transition {{#if (eq currentPath "/instructor")}}bg-brand-50 font-semibold text-brand-700{{else}}text-slate-600 hover:bg-slate-50 hover:text-navy-900{{/if}}">
            <svg class="h-[18px] w-[18px] shrink-0" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" /></svg>
            Dashboard
          </a>
          <a href="/instructor/courses" class="group flex items-center gap-3 rounded-lg px-3 py-2.5 text-[13px] font-medium transition {{isActive currentPath "/instructor/courses"}}">
            <svg class="h-[18px] w-[18px] shrink-0" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" /></svg>
            My courses
          </a>
          <a href="/instructor/live" class="group flex items-center gap-3 rounded-lg px-3 py-2.5 text-[13px] font-medium transition {{isActive currentPath "/instructor/live"}}">
            <svg class="h-[18px] w-[18px] shrink-0" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" /></svg>
            Live classroom
          </a>
          <a href="/instructor/learners" class="group flex items-center gap-3 rounded-lg px-3 py-2.5 text-[13px] font-medium transition {{isActive currentPath "/instructor/learners"}}">
            <svg class="h-[18px] w-[18px] shrink-0" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" /></svg>
            Learner monitoring
          </a>
        </div>
        <a href="/instructor/courses/new" class="mt-4 flex items-center justify-center gap-2 rounded-lg bg-brand-500 px-4 py-2.5 text-[13px] font-semibold text-white shadow-sm shadow-brand-500/20 transition hover:bg-brand-600">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" /></svg>
          Create course
        </a>
      {{/if}}

      {{#if (eq currentUser.role "superadmin")}}
        <p class="px-3 pb-2 text-[10px] font-bold uppercase tracking-[0.14em] text-slate-400">Administration</p>
        <div class="space-y-0.5">
          <a href="/admin" class="group flex items-center gap-3 rounded-lg px-3 py-2.5 text-[13px] font-medium transition {{#if (eq currentPath "/admin")}}bg-brand-50 font-semibold text-brand-700{{else}}text-slate-600 hover:bg-slate-50 hover:text-navy-900{{/if}}">
            <svg class="h-[18px] w-[18px] shrink-0" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" /></svg>
            Dashboard
          </a>
          <a href="/admin/users" class="group flex items-center gap-3 rounded-lg px-3 py-2.5 text-[13px] font-medium transition {{isActive currentPath "/admin/users"}}">
            <svg class="h-[18px] w-[18px] shrink-0" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
            User management
          </a>
          <a href="/admin/courses" class="group flex items-center gap-3 rounded-lg px-3 py-2.5 text-[13px] font-medium transition {{isActive currentPath "/admin/courses"}}">
            <svg class="h-[18px] w-[18px] shrink-0" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" /></svg>
            Course management
          </a>
          <a href="/admin/reports" class="group flex items-center gap-3 rounded-lg px-3 py-2.5 text-[13px] font-medium transition {{isActive currentPath "/admin/reports"}}">
            <svg class="h-[18px] w-[18px] shrink-0" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 002 2h-2a2 2 0 01-2-2z" /></svg>
            Reports &amp; analytics
          </a>
          <a href="/admin/finance" class="group flex items-center gap-3 rounded-lg px-3 py-2.5 text-[13px] font-medium transition {{isActive currentPath "/admin/finance"}}">
            <svg class="h-[18px] w-[18px] shrink-0" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24"><rect x="2" y="5" width="20" height="14" rx="2" /><path stroke-linecap="round" d="M2 10h20M6 15h4" /></svg>
            Finance &amp; Billing
          </a>
          <a href="/admin/logs" class="group flex items-center gap-3 rounded-lg px-3 py-2.5 text-[13px] font-medium transition {{isActive currentPath "/admin/logs"}}">
            <svg class="h-[18px] w-[18px] shrink-0" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
            Audit logs
          </a>
        </div>
      {{/if}}

      <p class="px-3 pb-2 pt-6 text-[10px] font-bold uppercase tracking-[0.14em] text-slate-400">Account</p>
      <div class="space-y-0.5">
        <a href="/notifications" class="group flex items-center gap-3 rounded-lg px-3 py-2.5 text-[13px] font-medium transition {{isActive currentPath "/notifications"}}">
          <svg class="h-[18px] w-[18px] shrink-0" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" /></svg>
          Notifications
          {{#if unreadCount}}<span class="ml-auto rounded-full bg-brand-500 px-2 py-0.5 text-[10px] font-bold text-white">{{unreadCount}}</span>{{/if}}
        </a>
        <a href="/profile" class="group flex items-center gap-3 rounded-lg px-3 py-2.5 text-[13px] font-medium transition {{isActive currentPath "/profile"}}">
          <svg class="h-[18px] w-[18px] shrink-0" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
          Profile &amp; settings
        </a>
      </div>
    </nav>

    <div class="border-t border-slate-100 p-4">
      <div class="flex items-center gap-3 rounded-xl border border-slate-200 bg-slate-50/70 p-2.5">
        <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full text-[11px] font-bold text-white" style="background-color: {{currentUser.avatarColor}}">{{initials currentUser.name}}</span>
        <div class="min-w-0 flex-1">
          <p class="truncate text-[12px] font-semibold text-navy-900">{{currentUser.name}}</p>
          <p class="truncate text-[10px] capitalize text-slate-400">
            {{#if (eq currentUser.role "superadmin")}}Super administrator{{else}}{{currentUser.role}}{{/if}}
          </p>
        </div>
        <a href="/logout" title="Sign out" class="rounded-lg p-1.5 text-slate-400 transition hover:bg-white hover:text-brand-600">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" /></svg>
        </a>
      </div>
    </div>
  </aside>

  <div class="app-shell lg:pl-[272px]">
    <header id="topbar" class="no-print sticky top-0 z-20 flex h-16 items-center justify-between gap-4 border-b border-slate-200 bg-white/95 px-4 backdrop-blur sm:px-6 lg:px-8">
      <div class="flex min-w-0 items-center gap-3">
        <button type="button" onclick="toggleSidebar(true)" class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-lg text-slate-500 transition hover:bg-slate-100 lg:hidden" aria-label="Open menu">
          <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" /></svg>
        </button>
        <div class="min-w-0">
          <p class="text-[10px] font-bold uppercase tracking-[0.14em] text-slate-400">Workspace</p>
          <p class="truncate text-[13px] font-semibold text-navy-900">{{#if title}}{{title}}{{else}}Vanguard Learning{{/if}}</p>
        </div>
      </div>
      <div class="flex items-center gap-2 sm:gap-3">
        <a href="/courses" class="hidden rounded-lg px-3 py-2 text-xs font-semibold text-slate-600 transition hover:bg-slate-50 hover:text-brand-600 md:block">Course catalog</a>
        <div class="hidden h-7 w-px bg-slate-200 md:block"></div>
        <a href="/notifications" class="relative rounded-lg p-2.5 text-slate-500 transition hover:bg-slate-50 hover:text-navy-900" aria-label="Notifications">
          <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" /></svg>
          {{#if unreadCount}}<span class="absolute right-2 top-2 h-2 w-2 rounded-full bg-brand-500 ring-2 ring-white"></span>{{/if}}
        </a>
        <a href="/profile" class="flex items-center gap-2.5 rounded-lg py-1 pl-1 pr-2 transition hover:bg-slate-50">
          <span class="flex h-8 w-8 items-center justify-center rounded-full text-[11px] font-bold text-white" style="background-color: {{currentUser.avatarColor}}">{{initials currentUser.name}}</span>
          <span class="hidden text-left sm:block">
            <span class="block max-w-[150px] truncate text-[11px] font-semibold text-navy-900">{{currentUser.name}}</span>
            <span class="block text-[10px] capitalize text-slate-400">{{currentUser.role}}</span>
          </span>
        </a>
      </div>
    </header>

    <main class="mx-auto w-full max-w-[1440px] px-4 pb-16 pt-6 sm:px-6 lg:px-8">
      {{#if success_msg}}
        <div class="mb-5 flex items-start gap-3 rounded-xl border border-emerald-200 bg-emerald-50/80 px-4 py-3 text-sm text-emerald-800">
          <svg class="mt-0.5 h-4 w-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
          <span>{{success_msg}}</span>
        </div>
      {{/if}}
      {{#if error_msg}}
        <div class="mb-5 flex items-start gap-3 rounded-xl border border-rose-200 bg-rose-50/80 px-4 py-3 text-sm text-rose-800">
          <svg class="mt-0.5 h-4 w-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          <span>{{error_msg}}</span>
        </div>
      {{/if}}
      {{#if info_msg}}
        <div class="mb-5 flex items-start gap-3 rounded-xl border border-sky-200 bg-sky-50/80 px-4 py-3 text-sm text-sky-800">
          <svg class="mt-0.5 h-4 w-4 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          <span>{{info_msg}}</span>
        </div>
      {{/if}}
