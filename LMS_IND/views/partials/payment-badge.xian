<span class="inline-flex items-center rounded-full px-2 py-0.5 text-[10px] font-bold uppercase tracking-wide {{#if (eq status "paid")}}bg-emerald-50 text-emerald-700{{else if (eq status "pending")}}bg-amber-50 text-amber-700{{else if (eq status "refunded")}}bg-sky-50 text-sky-700{{else if (eq status "failed")}}bg-rose-50 text-rose-700{{else}}bg-slate-100 text-slate-500{{/if}}">{{status}}</span>
