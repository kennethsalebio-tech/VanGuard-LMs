{{> app_start}}

<div class="mb-6">
  <p class="text-xs font-bold uppercase tracking-[0.16em] text-brand-600">Assessments</p>
  <h1 class="mt-1.5 text-2xl font-bold tracking-tight text-navy-900 sm:text-3xl">Knowledge checks</h1>
  <p class="mt-1 text-sm text-slate-500">Every lesson ends with a randomized check. Your results and attempts are recorded here.</p>
</div>

<div class="grid gap-6 xl:grid-cols-3">
  <section class="xl:col-span-2">
    <div class="rounded-2xl border border-slate-200 bg-white shadow-sm">
      <div class="flex items-center justify-between border-b border-slate-100 px-5 py-4">
        <h2 class="text-sm font-bold text-navy-900">Awaiting your attempt</h2>
        <span class="rounded-full bg-amber-50 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wide text-amber-700">{{pending.length}} pending</span>
      </div>
      {{#if pending}}
        <div class="divide-y divide-slate-100">
          {{#each pending}}
            <div class="flex flex-col gap-3 px-5 py-4 sm:flex-row sm:items-center sm:justify-between">
              <div class="min-w-0">
                <p class="text-sm font-semibold text-navy-900">{{lesson.title}}</p>
                <p class="mt-0.5 text-xs text-slate-400">{{lesson.course.title}}</p>
                <div class="mt-2 flex items-center gap-3 text-[11px] text-slate-400">
                  <span class="capitalize">{{status}}</span>
                  {{#if attempts}}<span>·</span><span>{{attempts}} attempt(s)</span>{{/if}}
                  {{#if bestScore}}<span>·</span><span>Best {{bestScore}}/{{totalQuestions}}</span>{{/if}}
                </div>
              </div>
              <div class="flex shrink-0 gap-2">
                <a href="/learn/{{lessonId}}" class="rounded-lg border border-slate-300 px-3 py-2 text-xs font-semibold text-navy-900 transition hover:bg-slate-50">Study</a>
                <a href="/learn/{{lessonId}}/quiz" class="rounded-lg bg-brand-600 px-3 py-2 text-xs font-semibold text-white transition hover:bg-brand-700">Take check</a>
              </div>
            </div>
          {{/each}}
        </div>
      {{else}}
        <div class="px-5 py-12 text-center">
          <span class="mx-auto flex h-12 w-12 items-center justify-center rounded-xl bg-emerald-50 text-emerald-600">
            <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
          </span>
          <p class="mt-3 text-sm font-semibold text-navy-900">Nothing pending</p>
          <p class="mt-1 text-xs text-slate-500">Unlocked lessons will appear here. Continue a course to open your next check.</p>
          <a href="/courses" class="mt-4 inline-flex text-sm font-semibold text-brand-600">Browse courses →</a>
        </div>
      {{/if}}
    </div>

    <div class="mt-6 rounded-2xl border border-slate-200 bg-white shadow-sm">
      <div class="border-b border-slate-100 px-5 py-4">
        <h2 class="text-sm font-bold text-navy-900">Attempt history</h2>
      </div>
      {{#if attempts}}
        <div class="overflow-x-auto">
          <table class="min-w-full text-left text-sm">
            <thead class="bg-slate-50 text-[10px] uppercase tracking-wide text-slate-500">
              <tr>
                <th class="px-5 py-3 font-semibold">Lesson</th>
                <th class="px-4 py-3 font-semibold">Course</th>
                <th class="px-4 py-3 font-semibold">Score</th>
                <th class="px-4 py-3 font-semibold">Result</th>
                <th class="px-4 py-3 font-semibold">Submitted</th>
                <th class="px-5 py-3 text-right font-semibold">Action</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              {{#each attempts}}
                <tr class="hover:bg-slate-50/70">
                  <td class="max-w-[220px] px-5 py-3">
                    <p class="truncate text-xs font-semibold text-navy-900">{{lesson.title}}</p>
                    <p class="mt-0.5 text-[10px] text-slate-400">Attempt {{attemptNumber}}</p>
                  </td>
                  <td class="max-w-[180px] px-4 py-3"><p class="truncate text-xs text-slate-500">{{lesson.course.title}}</p></td>
                  <td class="px-4 py-3">
                    {{#if (eq status "submitted")}}
                      <span class="text-xs font-bold text-navy-900">{{score}}/{{totalQuestions}}</span>
                    {{else}}
                      <span class="text-xs text-slate-400">In progress</span>
                    {{/if}}
                  </td>
                  <td class="px-4 py-3">
                    {{#if (eq status "submitted")}}
                      {{#if passed}}
                        <span class="rounded-full bg-emerald-50 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wide text-emerald-700">Passed</span>
                      {{else}}
                        <span class="rounded-full bg-rose-50 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wide text-rose-700">Not passed</span>
                      {{/if}}
                    {{else}}
                      <span class="rounded-full bg-amber-50 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wide text-amber-700">Open</span>
                    {{/if}}
                  </td>
                  <td class="px-4 py-3 text-xs text-slate-400">{{#if submittedAt}}{{formatDateTime submittedAt}}{{else}}—{{/if}}</td>
                  <td class="px-5 py-3 text-right">
                    {{#if (eq status "submitted")}}
                      <a href="/learn/{{lessonId}}/quiz/result/{{id}}" class="rounded-lg border border-slate-300 px-3 py-1.5 text-[11px] font-semibold text-navy-900 transition hover:bg-slate-50">Review</a>
                    {{else}}
                      <a href="/learn/{{lessonId}}/quiz" class="rounded-lg bg-brand-600 px-3 py-1.5 text-[11px] font-semibold text-white">Resume</a>
                    {{/if}}
                  </td>
                </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
      {{else}}
        <p class="px-5 py-10 text-center text-sm text-slate-500">No attempts yet. Your first knowledge check will be saved here.</p>
      {{/if}}
    </div>
  </section>

  <aside class="space-y-4">
    <div class="rounded-2xl border border-slate-200 bg-white p-5">
      <p class="text-[10px] font-bold uppercase tracking-[0.14em] text-slate-400">How it is graded</p>
      <div class="mt-3 space-y-3 text-xs text-slate-500">
        <p><span class="font-semibold text-navy-900">5 questions</span> are drawn at random from the lesson's approved question bank.</p>
        <p><span class="font-semibold text-navy-900">4 correct answers</span> (80%) are required to pass. The pass mark is configurable per course.</p>
        <p><span class="font-semibold text-navy-900">Server-side grading.</span> The answer key is never sent to your browser.</p>
        <p><span class="font-semibold text-navy-900">Unique sets.</span> Question and option order change each attempt, not each device.</p>
      </div>
    </div>
    <div class="rounded-2xl bg-navy-900 p-5 text-white">
      <p class="text-[10px] font-bold uppercase tracking-[0.16em] text-brand-300">Need to retry?</p>
      <p class="mt-2 text-sm leading-relaxed text-slate-300">If you did not pass, reopen the lesson, review the material, and start a new attempt. Availability depends on the course's retake policy.</p>
      <a href="/courses" class="mt-4 inline-flex text-xs font-semibold text-white underline underline-offset-4">Go to my courses</a>
    </div>
  </aside>
</div>

{{> app_end}}
