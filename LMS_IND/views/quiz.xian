{{> app_start}}

<div class="mx-auto max-w-3xl">
  <div class="mb-5 flex flex-col justify-between gap-3 sm:flex-row sm:items-end">
    <div>
      <p class="text-xs font-bold uppercase tracking-[0.16em] text-brand-600">Knowledge check</p>
      <h1 class="mt-1.5 text-xl font-bold tracking-tight text-navy-900 sm:text-2xl">{{lesson.title}}</h1>
      <p class="mt-1 text-sm text-slate-500">{{lesson.course.title}} · Attempt {{attempt.attemptNumber}}</p>
    </div>
    <span class="inline-flex w-fit items-center gap-2 rounded-full border border-slate-200 bg-white px-3 py-1.5 text-xs font-semibold text-slate-600">
      <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" /></svg>
      {{items.length}} questions
    </span>
  </div>

  <div class="mb-5 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm">
    <div class="flex items-center justify-between text-xs">
      <span class="font-semibold text-navy-900"><span id="answered-count">0</span> of {{items.length}} answered</span>
      <span class="text-slate-400">Pass mark: {{assessment.passScore}} / {{items.length}}</span>
    </div>
    <div class="mt-2 h-2 overflow-hidden rounded-full bg-slate-100">
      <div id="quiz-progress" class="h-full w-0 rounded-full bg-brand-500 transition-all duration-200"></div>
    </div>
    <p class="mt-2 text-[11px] text-slate-400">Questions and answer choices are randomized per attempt. The answer key is graded on the server.</p>
  </div>

  <form id="quiz-form" action="/learn/{{lesson.id}}/quiz" method="POST" class="space-y-4">
    <input type="hidden" name="_csrf" value="{{csrfToken}}" />
    <input type="hidden" name="attemptId" value="{{attempt.id}}" />

    {{#each items}}
      <fieldset class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <div class="flex items-start gap-3 border-b border-slate-100 px-5 py-4">
          <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-navy-900 text-xs font-bold text-white">{{add @index 1}}</span>
          <div class="min-w-0">
            <p class="text-sm font-semibold leading-relaxed text-navy-900">{{prompt}}</p>
            <p class="mt-1 text-[10px] font-bold uppercase tracking-wide text-slate-400">{{#if (eq type "true_false")}}True or false{{else}}Multiple choice{{/if}}</p>
          </div>
        </div>
        <div class="space-y-2 px-5 py-4">
          {{#each options}}
            <label class="flex cursor-pointer items-center gap-3 rounded-xl border border-slate-200 px-4 py-3 transition hover:border-brand-300 hover:bg-brand-50/30 has-[:checked]:border-brand-500 has-[:checked]:bg-brand-50">
              <input type="radio" name="answer_{{../questionId}}" value="{{id}}" class="h-4 w-4 shrink-0 accent-brand-600" />
              <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-slate-100 text-[11px] font-bold text-slate-600">{{letter}}</span>
              <span class="text-sm text-slate-700">{{text}}</span>
            </label>
          {{/each}}
        </div>
      </fieldset>
    {{/each}}

    <div id="unanswered-warning" class="hidden rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-xs font-semibold text-amber-800">
      Answer every question before submitting.
    </div>

    <div class="sticky bottom-4 flex flex-col items-center justify-between gap-3 rounded-2xl border border-slate-200 bg-white/95 p-4 shadow-lg backdrop-blur sm:flex-row">
      <a href="/learn/{{lesson.id}}" class="text-xs font-semibold text-slate-500 hover:text-navy-900">Exit without submitting</a>
      <button type="submit" class="flex w-full items-center justify-center gap-2 rounded-xl bg-brand-600 px-6 py-3 text-sm font-semibold text-white transition hover:bg-brand-700 sm:w-auto">
        Submit answers
        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
      </button>
    </div>
  </form>
</div>

<script>
  (function () {
    const form = document.getElementById("quiz-form");
    const total = {{items.length}};
    const count = document.getElementById("answered-count");
    const bar = document.getElementById("quiz-progress");
    const warning = document.getElementById("unanswered-warning");
    function refresh() {
      const answered = new Set(
        new FormData(form).keys()
      );
      let n = 0;
      form.querySelectorAll("fieldset").forEach((fieldset) => {
        if (fieldset.querySelector("input[type=radio]:checked")) n += 1;
      });
      count.textContent = n;
      bar.style.width = total ? `${Math.round((n / total) * 100)}%` : "0%";
      if (n === total) warning.classList.add("hidden");
    }
    form.addEventListener("change", refresh);
    form.addEventListener("submit", function (event) {
      let n = 0;
      form.querySelectorAll("fieldset").forEach((fieldset) => {
        if (fieldset.querySelector("input[type=radio]:checked")) n += 1;
      });
      if (n < total) {
        event.preventDefault();
        warning.classList.remove("hidden");
        warning.scrollIntoView({ behavior: "smooth", block: "center" });
      }
    });
    refresh();
  })();
</script>

{{> app_end}}
