{{> app_start}}

<div class="mb-6 flex flex-col justify-between gap-3 sm:flex-row sm:items-end">
  <div>
    <p class="text-xs font-bold uppercase tracking-[0.16em] text-brand-600">Inbox</p>
    <h1 class="mt-1.5 text-2xl font-bold tracking-tight text-navy-900 sm:text-3xl">Notifications</h1>
    <p class="mt-1 text-sm text-slate-500">Course updates, assessment results, assignments, and system messages.</p>
  </div>
  {{#if notifications.length}}
    <form action="/notifications/read-all" method="POST">
      <input type="hidden" name="_csrf" value="{{csrfToken}}" />
      <button type="submit" class="rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold text-navy-900 transition hover:bg-slate-50">Mark all as read</button>
    </form>
  {{/if}}
</div>

<div class="mx-auto max-w-4xl">
  {{#if notifications}}
    <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
      <div class="divide-y divide-slate-100">
        {{#each notifications}}
          <div class="flex flex-col gap-3 px-5 py-4 sm:flex-row sm:items-start {{#unless isRead}}bg-brand-50/30{{/unless}}">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl
              {{#if (eq type "assessment")}}bg-amber-50 text-amber-600
              {{else if (eq type "certificate")}}bg-emerald-50 text-emerald-600
              {{else if (eq type "course")}}bg-brand-50 text-brand-600
              {{else if (eq type "lesson")}}bg-indigo-50 text-indigo-600
              {{else if (eq type "live_class")}}bg-brand-50 text-brand-600
              {{else}}bg-slate-100 text-slate-500{{/if}}">
              {{#if (eq type "assessment")}}
                <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" /></svg>
              {{else if (eq type "certificate")}}
                <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
              {{else if (eq type "live_class")}}
                <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" /></svg>
              {{else}}
                <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" /></svg>
              {{/if}}
            </span>
            <div class="min-w-0 flex-1">
              <div class="flex items-start justify-between gap-3">
                <div>
                  <p class="text-sm {{#unless isRead}}font-bold text-navy-900{{else}}font-semibold text-slate-700{{/unless}}">{{title}}</p>
                  <p class="mt-0.5 text-[10px] font-semibold uppercase tracking-wide text-slate-400">{{type}} · {{formatDateTime createdAt}}</p>
                </div>
                {{#unless isRead}}<span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-brand-500"></span>{{/unless}}
              </div>
              <p class="mt-1.5 text-sm leading-relaxed text-slate-500">{{message}}</p>
              <div class="mt-2.5 flex flex-wrap items-center gap-3">
                {{#if link}}
                  <a href="/notifications/{{id}}/open" class="text-xs font-semibold text-brand-600 hover:text-brand-700">Open →</a>
                {{/if}}
                {{#unless isRead}}
                  <form action="/notifications/{{id}}/read" method="POST">
                    <input type="hidden" name="_csrf" value="{{csrfToken}}" />
                    <button type="submit" class="text-xs font-medium text-slate-400 hover:text-slate-600">Mark as read</button>
                  </form>
                {{/unless}}
              </div>
            </div>
          </div>
        {{/each}}
      </div>
    </div>
  {{else}}
    <div class="rounded-2xl border border-dashed border-slate-300 bg-white px-6 py-14 text-center">
      <span class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-slate-100 text-slate-400">
        <svg class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" /></svg>
      </span>
      <h2 class="mt-4 text-lg font-bold text-navy-900">You are all caught up</h2>
      <p class="mt-1 text-sm text-slate-500">New course, lesson, assessment, and certificate updates will appear here.</p>
    </div>
  {{/if}}
</div>

{{> app_end}}
