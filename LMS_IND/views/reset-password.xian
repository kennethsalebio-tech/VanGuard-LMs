{{> head}}
<body class="flex min-h-full flex-col bg-[#f4f8fc] text-slate-700 antialiased">
  <header class="border-b border-slate-200 bg-white">
    <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-3 px-4 sm:px-8">
      <a href="/" class="flex min-w-0 items-center gap-2.5 sm:gap-3">
        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-brand-500 shadow-lg shadow-brand-500/20">
          <svg class="h-5 w-5 text-white" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" /></svg>
        </span>
        <span class="truncate text-[14px] font-bold text-navy-900 sm:text-base">Vanguard Learning</span>
      </a>
      <a href="/login" class="shrink-0 whitespace-nowrap text-[13px] font-semibold text-brand-600 hover:text-brand-700 sm:text-sm">Back to sign in</a>
    </div>
  </header>

  <main class="mx-auto flex w-full max-w-md flex-1 flex-col justify-center px-5 py-12">
    <div class="rounded-2xl border border-slate-200 bg-white p-7 shadow-card">
      <span class="flex h-12 w-12 items-center justify-center rounded-xl bg-brand-50 text-brand-600">
        <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4" /></svg>
      </span>
      <h1 class="mt-5 text-2xl font-bold tracking-tight text-navy-900">Choose a new password</h1>

      {{#if invalid}}
      <p class="mt-2 text-sm leading-relaxed text-slate-500">
        This reset link is invalid or has expired. Request a new link to continue.
      </p>
      <a href="/forgot-password" class="mt-6 inline-flex w-full items-center justify-center rounded-xl bg-brand-600 px-4 py-3 text-sm font-semibold text-white transition hover:bg-brand-700">Request a new link</a>
      {{else}}
      <p class="mt-2 text-sm leading-relaxed text-slate-500">
        Use at least 8 characters. This link can only be used once.
      </p>

      <div class="mt-5">{{> flash}}</div>

      <form action="/reset-password" method="POST" class="mt-6 space-y-4">
        <input type="hidden" name="_csrf" value="{{csrfToken}}" />
        <input type="hidden" name="token" value="{{token}}" />
        <div>
          <label for="password" class="label">New password</label>
          <input id="password" name="password" type="password" autocomplete="new-password" minlength="8" required class="field" placeholder="At least 8 characters" />
        </div>
        <div>
          <label for="confirm_password" class="label">Confirm password</label>
          <input id="confirm_password" name="confirm_password" type="password" autocomplete="new-password" minlength="8" required class="field" placeholder="Repeat your password" />
        </div>
        <button type="submit" class="w-full rounded-xl bg-brand-600 px-4 py-3 text-sm font-semibold text-white transition hover:bg-brand-700">Update password</button>
      </form>
      {{/if}}
    </div>
  </main>

{{> footer}}
