{{> head}}
<body class="min-h-full bg-white text-slate-700 antialiased">
  <div class="grid min-h-screen lg:grid-cols-[1.02fr_1fr]">
    <aside class="relative hidden overflow-hidden border-r border-slate-200 bg-[#f7fafe] p-12 lg:flex lg:flex-col lg:justify-between">
      <div class="pointer-events-none absolute inset-0 hero-grid"></div>
      <div class="pointer-events-none absolute -right-24 top-16 h-80 w-80 rounded-full bg-brand-100/70 blur-2xl"></div>
      <div class="pointer-events-none absolute -bottom-24 -left-16 h-80 w-80 rounded-full bg-emerald-100/50 blur-2xl"></div>

      <a href="/" class="relative flex items-center gap-3">
        <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-brand-500 shadow-lg shadow-brand-500/20">
          <svg class="h-5 w-5 text-white" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" /></svg>
        </span>
        <span>
          <span class="block text-[15px] font-extrabold leading-tight tracking-tight text-navy-900">Vanguard Learning</span>
          <span class="mt-0.5 block text-[9px] font-bold uppercase tracking-[0.16em] text-slate-400">Integrated LMS</span>
        </span>
      </a>

      <div class="relative max-w-md">
        <span class="eyebrow">Get started</span>
        <h1 class="mt-5 text-[2.4rem] font-extrabold leading-[1.1] tracking-[-0.03em] text-navy-900">
          Your next skill is<br /><span class="text-brand-500">one lesson away.</span>
        </h1>
        <p class="mt-4 text-[14px] leading-relaxed text-slate-600">
          Create a learner account to browse published courses, study converted module lessons,
          and earn verifiable certificates.
        </p>

        <div class="mt-8 rounded-2xl border border-slate-200 bg-white p-5">
          <p class="text-[12px] font-bold text-navy-900">How the lesson gate works</p>
          <ol class="mt-4 space-y-3 text-[12px] text-slate-600">
            <li class="flex gap-3"><span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-brand-50 text-[10px] font-bold text-brand-700">1</span> Study the lesson webpage.</li>
            <li class="flex gap-3"><span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-brand-50 text-[10px] font-bold text-brand-700">2</span> Take 5 randomized questions.</li>
            <li class="flex gap-3"><span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-brand-50 text-[10px] font-bold text-brand-700">3</span> Score 4 out of 5 to unlock the next lesson.</li>
            <li class="flex gap-3"><span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-emerald-50 text-[10px] font-bold text-emerald-700">4</span> Finish the course and get certified.</li>
          </ol>
        </div>
      </div>

      <p class="relative text-[11px] text-slate-400">© 2026 Vanguard Learning · Integrated LMS</p>
    </aside>

    <div class="flex flex-col">
      <div class="flex items-center justify-between border-b border-slate-100 p-5 lg:hidden">
        <a href="/" class="flex items-center gap-2.5">
          <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-brand-500">
            <svg class="h-4 w-4 text-white" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" /></svg>
          </span>
          <span class="text-[13px] font-extrabold text-navy-900">Vanguard Learning</span>
        </a>
        <a href="/login" class="text-[12px] font-semibold text-brand-600">Sign in</a>
      </div>

      <div class="flex flex-1 items-center justify-center px-5 py-10 sm:px-10">
        <div class="w-full max-w-[390px]">
          <span class="eyebrow">Create account</span>
          <h2 class="mt-4 text-[1.8rem] font-extrabold tracking-tight text-navy-900">Start learning</h2>
          <p class="mt-2 text-[13px] text-slate-500">Learner registration. Staff accounts are provisioned by an administrator.</p>

          <div class="mt-6">{{> flash}}</div>

          <form action="/register" method="POST" class="mt-6 space-y-4">
            <input type="hidden" name="_csrf" value="{{csrfToken}}" />
            <div>
              <label for="name" class="label">Full name</label>
              <input id="name" name="name" type="text" autocomplete="name" required class="field" placeholder="Juan Dela Cruz" />
            </div>
            <div>
              <label for="email" class="label">Work email</label>
              <input id="email" name="email" type="email" autocomplete="email" required class="field" placeholder="you@company.com" />
            </div>
            <div>
              <label for="password" class="label">Password</label>
              <input id="password" name="password" type="password" autocomplete="new-password" minlength="8" required class="field" placeholder="At least 8 characters" />
            </div>
            <div>
              <label for="confirm_password" class="label">Confirm password</label>
              <input id="confirm_password" name="confirm_password" type="password" autocomplete="new-password" minlength="8" required class="field" placeholder="Repeat your password" />
            </div>
            <button type="submit" class="ui-btn ui-btn-primary w-full !py-3">Create account</button>
          </form>

          <p class="mt-5 text-center text-[12px] text-slate-500">
            Already registered? <a href="/login" class="font-semibold text-brand-600 hover:text-brand-700">Sign in</a>
          </p>
          <p class="mt-5 text-center text-[11px] leading-relaxed text-slate-400">
            New learners receive onboarding training assignments automatically based on their profile.
          </p>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
