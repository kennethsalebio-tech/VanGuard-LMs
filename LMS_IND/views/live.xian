{{> app_start}}

<div class="mb-6 flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
  <div>
    <p class="text-xs font-bold uppercase tracking-[0.16em] text-brand-600">Live classes</p>
    <h1 class="mt-1.5 text-2xl font-bold tracking-tight text-navy-900 sm:text-3xl">Vanguard Live Classroom</h1>
    <p class="mt-1 text-sm text-slate-500">Join live sessions for the courses you are enrolled in, and see what is scheduled next.</p>
  </div>
  <a href="/courses" class="inline-flex items-center justify-center gap-2 rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold text-navy-900 transition hover:bg-slate-50">My courses</a>
</div>

<div class="space-y-6">
  <section class="overflow-hidden rounded-2xl border border-emerald-200 bg-white shadow-sm">
    <div class="flex items-center justify-between border-b border-emerald-100 bg-emerald-50/60 px-5 py-4">
      <h2 class="flex items-center gap-2 text-sm font-bold text-emerald-900">
        <span class="flex h-2 w-2 rounded-full bg-emerald-500"></span>
        Live now
      </h2>
      <span class="text-[11px] font-semibold text-emerald-700">{{liveNow.length}} session(s)</span>
    </div>
    {{#if liveNow}}
      <div class="divide-y divide-slate-100">
        {{#each liveNow}}
          <div class="flex flex-col gap-3 px-5 py-4 lg:flex-row lg:items-center">
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl text-sm font-bold text-white" style="background-color: {{course.accent}}">{{initials course.title}}</span>
            <div class="min-w-0 flex-1">
              <div class="flex flex-wrap items-center gap-2">
                <p class="truncate text-sm font-semibold text-navy-900">{{title}}</p>
                <span class="rounded-full bg-emerald-50 px-2 py-0.5 text-[9px] font-bold uppercase tracking-wide text-emerald-700">Live</span>
              </div>
              <p class="mt-0.5 text-xs text-slate-500">{{course.title}} · {{instructor.name}}</p>
              <div class="mt-1 flex flex-wrap items-center gap-x-3 gap-y-1 text-[11px] text-slate-400">
                <span>{{counts.joined}} learner(s) participating</span>
                <span>·</span>
                <span>started {{formatDateTime startedAt}}</span>
              </div>
            </div>
            <div class="flex shrink-0 items-center gap-2">
              <a href="/live/{{id}}" class="rounded-lg border border-slate-300 px-3 py-2 text-[11px] font-semibold text-navy-900 transition hover:bg-slate-50">Details</a>
              <a href="/live/{{id}}/room" class="inline-flex items-center gap-1.5 rounded-lg bg-brand-600 px-3 py-2 text-[11px] font-semibold text-white transition hover:bg-brand-700">
                <svg class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" /></svg>
                Join live classroom
              </a>
            </div>
          </div>
        {{/each}}
      </div>
    {{else}}
      <p class="px-5 py-8 text-center text-xs text-slate-500">No live class is running right now. Your instructor’s next session will appear here.</p>
    {{/if}}
  </section>

  <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
    <div class="flex items-center justify-between border-b border-slate-100 px-5 py-4">
      <h2 class="text-sm font-bold text-navy-900">Upcoming live classes</h2>
      <span class="text-[11px] font-semibold text-slate-400">{{upcoming.length}} scheduled</span>
    </div>
    {{#if upcoming}}
      <div class="divide-y divide-slate-100">
        {{#each upcoming}}
          <div class="flex flex-col gap-3 px-5 py-4 sm:flex-row sm:items-center">
            <div class="min-w-0 flex-1">
              <p class="truncate text-sm font-semibold text-navy-900">{{title}}</p>
              <p class="mt-0.5 text-xs text-slate-500">{{course.title}} · {{instructor.name}}</p>
              <p class="mt-1 text-[11px] text-slate-400">{{formatDateTime scheduledStart}} · {{durationMinutes}} min</p>
            </div>
            <div class="flex shrink-0 items-center gap-2">
              <span class="rounded-full bg-amber-50 px-2.5 py-1 text-[9px] font-bold uppercase tracking-wide text-amber-700">Scheduled</span>
              <a href="/live/{{id}}" class="rounded-lg border border-slate-300 px-3 py-1.5 text-[11px] font-semibold text-navy-900 transition hover:bg-slate-50">Details</a>
            </div>
          </div>
        {{/each}}
      </div>
    {{else}}
      <p class="px-5 py-8 text-center text-xs text-slate-500">You have no scheduled live classes.</p>
    {{/if}}
  </section>

  <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
    <div class="flex items-center justify-between border-b border-slate-100 px-5 py-4">
      <h2 class="text-sm font-bold text-navy-900">Past sessions</h2>
      <span class="text-[11px] font-semibold text-slate-400">Your attendance</span>
    </div>
    {{#if past}}
      <div class="divide-y divide-slate-100">
        {{#each past}}
          <div class="flex flex-col gap-3 px-5 py-3.5 sm:flex-row sm:items-center">
            <div class="min-w-0 flex-1">
              <p class="truncate text-xs font-semibold text-navy-900">{{title}}</p>
              <p class="mt-0.5 text-[11px] text-slate-400">{{course.title}} · {{formatDateTime scheduledStart}}</p>
            </div>
            <div class="flex shrink-0 items-center gap-3">
              {{#if myAttendance}}
                <span class="rounded-full bg-emerald-50 px-2.5 py-1 text-[9px] font-bold uppercase tracking-wide text-emerald-700">Attended</span>
                <span class="text-[11px] text-slate-500">{{durationText myAttendance.seconds}}</span>
              {{else}}
                <span class="rounded-full bg-slate-100 px-2.5 py-1 text-[9px] font-bold uppercase tracking-wide text-slate-500">{{status}}</span>
              {{/if}}
              <a href="/live/{{id}}" class="rounded-lg border border-slate-300 px-3 py-1.5 text-[11px] font-semibold text-navy-900 transition hover:bg-slate-50">Details</a>
            </div>
          </div>
        {{/each}}
      </div>
    {{else}}
      <p class="px-5 py-8 text-center text-xs text-slate-500">Completed live classes will appear here with your recorded attendance.</p>
    {{/if}}
  </section>
</div>

{{> app_end}}
