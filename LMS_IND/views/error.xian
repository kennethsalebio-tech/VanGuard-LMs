{{> head}}
<body class="flex min-h-full flex-col bg-[#f4f8fc] text-slate-700 antialiased">
  <header class="border-b border-slate-200 bg-white">
    <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-3 px-4 sm:px-8">
      <a href="/" class="flex min-w-0 items-center gap-2.5 sm:gap-3">
        <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-brand-500 shadow-lg shadow-brand-500/20">
          <svg class="h-5 w-5 text-white" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" /></svg>
        </span>
        <span class="truncate text-[14px] font-bold text-navy-900 sm:text-base">Vanguard Learning</span>
      </a>
      <a href="/login" class="shrink-0 whitespace-nowrap text-[13px] font-semibold text-brand-600 hover:text-brand-700 sm:text-sm">Sign in</a>
    </div>
  </header>

  <main class="mx-auto flex w-full max-w-lg flex-1 flex-col justify-center px-5 py-14 text-center">
    <p class="text-7xl font-extrabold tracking-tight text-brand-600">{{status}}</p>
    <h1 class="mt-3 text-2xl font-bold text-navy-900">{{title}}</h1>
    <p class="mx-auto mt-3 max-w-md text-sm leading-relaxed text-slate-500">{{message}}</p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      {{#if currentUser}}
        <a href="/dashboard" class="rounded-xl bg-brand-600 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-700">Back to dashboard</a>
      {{else}}
        <a href="/login" class="rounded-xl bg-brand-600 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-700">Sign in</a>
        <a href="/" class="rounded-xl border border-slate-300 bg-white px-5 py-2.5 text-sm font-semibold text-navy-900 transition hover:bg-slate-50">Go to homepage</a>
      {{/if}}
    </div>
  </main>

{{> footer}}
