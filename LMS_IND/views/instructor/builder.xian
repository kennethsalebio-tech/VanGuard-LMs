{{> app_start}}

<div class="mb-4 flex items-center gap-2 text-xs text-slate-400">
  <a href="/instructor/courses" class="hover:text-brand-600">My courses</a>
  <span>/</span>
  <span class="truncate text-slate-600">{{course.title}}</span>
</div>

<div class="mb-6 flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
  <div>
    <div class="flex flex-wrap items-center gap-2">
      <span class="rounded-full px-2.5 py-1 text-[10px] font-bold uppercase tracking-wide {{#if (eq course.status "published")}}bg-emerald-50 text-emerald-700{{else if (eq course.status "archived")}}bg-slate-100 text-slate-500{{else}}bg-amber-50 text-amber-700{{/if}}">{{course.status}}</span>
      <span class="rounded-full bg-slate-100 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wide text-slate-500">{{course.level}}</span>
      {{#if course.category}}<span class="text-[11px] font-semibold text-brand-600">{{course.category.name}}</span>{{/if}}
    </div>
    <h1 class="mt-2 text-2xl font-bold tracking-tight text-navy-900 sm:text-3xl">{{course.title}}</h1>
    <p class="mt-1 text-sm text-slate-500">{{learnerCount}} enrolled learners · {{modules.length}} modules · {{course.questionCount}} questions per check</p>
  </div>
  <div class="flex flex-wrap gap-2">
    <a href="/instructor/live/new?courseId={{course.id}}" class="inline-flex items-center gap-2 rounded-xl bg-brand-600 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-700">
      <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" /></svg>
      Live class
    </a>
    <a href="/instructor/courses/{{course.id}}/learners" class="rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold text-navy-900 transition hover:bg-slate-50">Learners</a>
    <a href="/instructor/courses/{{course.id}}/edit" class="rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold text-navy-900 transition hover:bg-slate-50">Settings</a>
    <a href="/courses/{{course.id}}" class="rounded-xl bg-brand-600 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-700">Preview course</a>
  </div>
</div>

<div class="grid gap-6 xl:grid-cols-[minmax(0,1fr)_340px]">
  <div class="space-y-5">
    {{#if modules}}
      <div class="space-y-4">
        {{#each modules}}
          <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
            <div class="flex flex-col gap-2 border-b border-slate-100 bg-slate-50/70 px-5 py-4 sm:flex-row sm:items-center sm:justify-between">
              <div class="flex flex-wrap items-center gap-3">
                <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-navy-900 text-xs font-bold text-white">{{add @index 1}}</span>
                <span class="inline-flex shrink-0 items-center rounded-md px-2 py-0.5 text-[9px] font-extrabold uppercase tracking-[0.12em] ring-1 {{badge.className}}">{{badge.label}}</span>
                <div class="min-w-0">
                  <h2 class="truncate text-sm font-bold text-navy-900">{{title}}</h2>
                  {{#if description}}<p class="mt-0.5 text-[11px] text-slate-500">{{description}}</p>{{/if}}
                </div>
              </div>
              <div class="flex flex-wrap items-center gap-2">
                <span class="rounded-full px-2 py-0.5 text-[9px] font-bold uppercase tracking-wide {{#if (eq status "published")}}bg-emerald-50 text-emerald-700{{else}}bg-slate-100 text-slate-500{{/if}}">{{status}}</span>
                {{#if (eq status "published")}}
                  <form action="/instructor/courses/{{../course.id}}/modules/{{id}}/unpublish" method="POST" data-confirm="Unpublish this module? Learners will no longer see it until it is published again.">
                    <input type="hidden" name="_csrf" value="{{../csrfToken}}" />
                    <button type="submit" class="rounded-lg border border-slate-300 px-2.5 py-1.5 text-[11px] font-semibold text-navy-900 transition hover:bg-white">Unpublish</button>
                  </form>
                {{else}}
                  <form action="/instructor/courses/{{../course.id}}/modules/{{id}}/publish" method="POST">
                    <input type="hidden" name="_csrf" value="{{../csrfToken}}" />
                    <button type="submit" class="rounded-lg bg-emerald-600 px-2.5 py-1.5 text-[11px] font-semibold text-white transition hover:bg-emerald-700">Publish</button>
                  </form>
                {{/if}}
                <span class="text-[11px] font-semibold text-slate-400">{{lessons.length}} lessons</span>
                <form action="/instructor/courses/{{../course.id}}/modules/{{id}}/delete" method="POST" data-confirm="Delete this module? It must be empty.">
                  <input type="hidden" name="_csrf" value="{{../csrfToken}}" />
                  <button type="submit" class="rounded-lg p-1.5 text-slate-400 transition hover:bg-rose-50 hover:text-rose-600" title="Delete module">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                  </button>
                </form>
              </div>
            </div>

            {{#if lessons.length}}
              <div class="divide-y divide-slate-100">
                {{#each lessons}}
                  <div class="flex flex-col gap-3 px-5 py-4 sm:flex-row sm:items-center">
                    <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg {{#if (eq status "published")}}bg-emerald-50 text-emerald-600{{else}}bg-slate-100 text-slate-400{{/if}}">
                      <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" /></svg>
                    </span>
                    <div class="min-w-0 flex-1">
                      <div class="flex flex-wrap items-center gap-2">
                        <a href="/instructor/lessons/{{id}}/edit" class="truncate text-sm font-semibold text-navy-900 hover:text-brand-600">{{title}}</a>
                        <span class="rounded-full px-2 py-0.5 text-[9px] font-bold uppercase tracking-wide {{#if (eq status "published")}}bg-emerald-50 text-emerald-700{{else}}bg-slate-100 text-slate-500{{/if}}">{{status}}</span>
                        {{#unless hasContent}}<span class="rounded-full bg-rose-50 px-2 py-0.5 text-[9px] font-bold uppercase tracking-wide text-rose-700">No content</span>{{/unless}}
                      </div>
                      <div class="mt-1 flex flex-wrap items-center gap-x-3 gap-y-1 text-[11px] text-slate-400">
                        <span>{{durationMinutes}} min</span>
                        <span>·</span>
                        <span class="{{#if (gte approved ../../requiredQuestions)}}text-emerald-600{{else}}text-amber-600{{/if}}">{{approved}} approved</span>
                        {{#if pending}}<span>·</span><span class="text-amber-600">{{pending}} pending</span>{{/if}}
                        {{#if bank}}<span>·</span><span class="capitalize">{{bank.generator}}</span>{{/if}}
                      </div>
                    </div>
                    <div class="flex shrink-0 flex-wrap items-center gap-1.5">
                      <a href="/instructor/lessons/{{id}}/questions" class="rounded-lg border border-slate-300 px-2.5 py-1.5 text-[11px] font-semibold text-navy-900 transition hover:bg-slate-50">Questions</a>
                      <a href="/instructor/lessons/{{id}}/edit" class="rounded-lg border border-slate-300 px-2.5 py-1.5 text-[11px] font-semibold text-navy-900 transition hover:bg-slate-50">Edit</a>
                      <a href="/learn/{{id}}" class="rounded-lg bg-brand-600 px-2.5 py-1.5 text-[11px] font-semibold text-white transition hover:bg-brand-700">Preview</a>
                      <form action="/instructor/lessons/{{id}}/delete" method="POST" data-confirm="Permanently delete this lesson and its question bank?">
                        <input type="hidden" name="_csrf" value="{{../../csrfToken}}" />
                        <button type="submit" class="rounded-lg p-1.5 text-slate-400 transition hover:bg-rose-50 hover:text-rose-600" title="Delete lesson">
                          <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                        </button>
                      </form>
                    </div>
                  </div>
                {{/each}}
              </div>
            {{else}}
              <p class="px-5 py-6 text-center text-xs text-slate-400">No lessons in this module yet. Upload a module below.</p>
            {{/if}}

            <div class="border-t border-slate-100 bg-slate-50/60 px-5 py-4">
              <p class="text-[10px] font-bold uppercase tracking-[0.14em] text-slate-400">Add a lesson to “{{title}}”</p>
              <form action="/instructor/courses/{{../course.id}}/lessons" method="POST" enctype="multipart/form-data" class="module-upload-form doc-upload-form mt-3 space-y-3"
                    data-upload-url="/instructor/courses/{{../course.id}}/upload-preview"
                    data-remove-base="/instructor/courses/{{../course.id}}/uploads"
                    data-csrf="{{../csrfToken}}" data-max-size="26214400">
                <input type="hidden" name="_csrf" value="{{../csrfToken}}" />
                <input type="hidden" name="moduleId" value="{{id}}" />
                <input type="hidden" name="upload_token" value="" data-upload-token />
                <div class="grid gap-3 sm:grid-cols-2">
                  <input name="title" type="text" maxlength="160" placeholder="Lesson title (optional if uploading a file)" class="field" />
                  <input name="durationMinutes" type="number" min="1" max="600" value="15" placeholder="Duration (minutes)" class="field" />
                </div>
                <input name="summary" type="text" maxlength="400" placeholder="Optional one-line summary" class="field" />

                <div class="doc-upload-shell" data-upload-shell>
                  <div class="doc-dropzone" data-dropzone tabindex="0" role="button" aria-label="Upload a source document">
                    <input type="file" name="module_file" class="sr-only" data-file-input
                           accept=".pdf,.docx,.pptx,.xlsx,.txt,.md,.markdown,.html,.htm,.png,.jpg,.jpeg,.gif,.webp" />
                    <span class="doc-dropzone-icon" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path stroke-linecap="round" stroke-linejoin="round" d="M7 16a4 4 0 01-.88-7.9A5.5 5.5 0 0116.9 7H17a5 5 0 010 10h-1M12 12v9m0-9l-3 3m3-3l3 3" /></svg>
                    </span>
                    <p class="doc-dropzone-title">Drag and drop your file here, or <span>browse files</span></p>
                    <p class="doc-dropzone-help">PDF, DOCX, PPTX, XLSX, TXT, Markdown, HTML, PNG, JPG, GIF, or WebP</p>
                    <p class="doc-dropzone-limit">One source document per lesson · Maximum 25 MB</p>
                  </div>
                  <noscript>
                    <input name="module_file" type="file" accept=".pdf,.docx,.pptx,.xlsx,.txt,.md,.markdown,.html,.htm,.png,.jpg,.jpeg,.gif,.webp" class="mt-2 block w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-xs text-slate-500 file:mr-3 file:rounded-md file:border-0 file:bg-brand-50 file:px-3 file:py-1.5 file:text-xs file:font-semibold file:text-brand-700" />
                    <p class="mt-1 text-[10px] text-slate-400">JavaScript is off. Select the source document before converting the lesson.</p>
                  </noscript>

                  <div class="doc-upload-progress" data-progress hidden aria-live="polite">
                    <div class="doc-upload-progress-top">
                      <span class="doc-upload-spinner" data-spinner aria-hidden="true"></span>
                      <div class="min-w-0 flex-1">
                        <p class="doc-upload-status" data-progress-status>Preparing file…</p>
                        <p class="doc-upload-name" data-progress-name></p>
                      </div>
                      <span class="doc-upload-percent" data-progress-percent>0%</span>
                    </div>
                    <div class="doc-progress-track" data-progress-track>
                      <div class="doc-progress-bar" data-progress-bar style="width:0%"></div>
                    </div>
                    <div class="doc-upload-stages" aria-hidden="true">
                      <span data-stage="preparing">Preparing</span>
                      <span data-stage="uploading">Uploading</span>
                      <span data-stage="processing">Processing</span>
                      <span data-stage="preview">Preview</span>
                    </div>
                  </div>

                  <div class="doc-upload-error" data-upload-error hidden role="alert">
                    <span class="doc-error-icon" aria-hidden="true">!</span>
                    <div class="min-w-0 flex-1">
                      <p class="font-semibold">Upload failed</p>
                      <p class="mt-0.5 text-[11px] leading-relaxed" data-error-message></p>
                    </div>
                    <button type="button" class="doc-retry-button" data-retry>Retry upload</button>
                  </div>

                  <div class="doc-upload-result" data-upload-result hidden>
                    <div class="doc-upload-filebar">
                      <span class="doc-file-icon" data-file-icon aria-hidden="true"></span>
                      <div class="min-w-0 flex-1">
                        <p class="doc-file-name" data-file-name></p>
                        <p class="doc-file-meta" data-file-meta></p>
                      </div>
                      <span class="doc-success-check" data-success-check aria-hidden="true">✓</span>
                      <button type="button" class="doc-remove-button" data-remove title="Remove uploaded document">Remove</button>
                    </div>
                    <div class="doc-viewer" data-preview-body></div>
                  </div>
                </div>

                <div>
                  <label class="label">Or paste webpage content</label>
                  <textarea name="content_html" rows="3" class="field doc-paste-field" placeholder="<h2>Topic</h2><p>Lesson content…</p>"></textarea>
                </div>
                <div class="flex justify-end">
                  <button type="submit" data-submit class="inline-flex items-center gap-2 rounded-xl bg-brand-600 px-4 py-2.5 text-xs font-semibold text-white transition hover:bg-brand-700 disabled:cursor-not-allowed disabled:opacity-60">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12" /></svg>
                    Convert to lesson
                  </button>
                </div>
              </form>
            </div>
          </section>
        {{/each}}
      </div>
    {{else}}
      <div class="rounded-2xl border border-dashed border-slate-300 bg-white px-6 py-14 text-center">
        <span class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-brand-50 text-brand-600">
          <svg class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 10h16M4 14h16M4 18h16" /></svg>
        </span>
        <h2 class="mt-4 text-lg font-bold text-navy-900">Start with a module</h2>
        <p class="mx-auto mt-1 max-w-md text-sm text-slate-500">Modules group your lessons. Create one in the panel on the right, then upload the source document.</p>
      </div>
    {{/if}}
  </div>

  <aside class="space-y-4">
    <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <h2 class="text-sm font-bold text-navy-900">Add a module</h2>
      <form action="/instructor/courses/{{course.id}}/modules" method="POST" class="mt-3 space-y-3">
        <input type="hidden" name="_csrf" value="{{csrfToken}}" />
        <div>
          <label for="module-title" class="label">Module title</label>
          <input id="module-title" name="title" type="text" required maxlength="160" class="field" placeholder="e.g. Foundations" />
        </div>
        <div>
          <label for="module-description" class="label">Description (optional)</label>
          <textarea id="module-description" name="description" rows="2" class="field" placeholder="What this module covers"></textarea>
        </div>
        <button type="submit" class="w-full rounded-xl bg-brand-600 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-700">Add module</button>
      </form>
    </section>

    <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <h2 class="text-sm font-bold text-navy-900">Publishing readiness</h2>
      <div class="mt-3 space-y-3 text-xs">
        <div class="flex items-center justify-between">
          <span class="text-slate-500">Modules</span>
          <span class="font-bold text-navy-900">{{modules.length}}</span>
        </div>
        <div class="flex items-center justify-between">
          <span class="text-slate-500">Course status</span>
          <span class="font-bold capitalize text-navy-900">{{course.status}}</span>
        </div>
        <div class="flex items-center justify-between">
          <span class="text-slate-500">Required questions</span>
          <span class="font-bold text-navy-900">{{requiredQuestions}} / lesson</span>
        </div>
      </div>
      <p class="mt-4 rounded-xl bg-slate-50 p-3 text-[11px] leading-relaxed text-slate-500">
        Each lesson must have webpage content and at least {{requiredQuestions}} approved questions before it can be published. Publishing the course makes it available in the catalog.
      </p>
      <a href="/instructor/courses/{{course.id}}/edit" class="mt-3 block rounded-xl border border-slate-300 px-4 py-2.5 text-center text-xs font-semibold text-navy-900 transition hover:bg-slate-50">Course settings</a>
    </section>

    <section class="rounded-2xl bg-navy-900 p-5 text-white">
      <p class="text-[10px] font-bold uppercase tracking-[0.16em] text-brand-300">Conversion pipeline</p>
      <p class="mt-2 text-sm leading-relaxed text-slate-300">PDF, DOCX, and PPTX text is extracted, cleaned, sectioned, and rendered as a responsive webpage. The original upload is saved as a downloadable learning resource.</p>
      <p class="mt-2 text-[11px] text-slate-400">Scanned PDFs require OCR, which is not enabled in this build.</p>
    </section>
  </aside>
</div>

<script src="/js/document-preview.js"></script>
<script src="/js/module-upload.js"></script>
{{> app_end}}
