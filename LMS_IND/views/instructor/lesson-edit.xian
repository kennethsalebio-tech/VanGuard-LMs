{{> app_start}}

<div class="mb-4 flex items-center gap-2 text-xs text-slate-400">
  <a href="/instructor/courses" class="hover:text-brand-600">My courses</a>
  <span>/</span>
  <a href="/instructor/courses/{{lesson.courseId}}/builder" class="max-w-[200px] truncate hover:text-brand-600">{{lesson.course.title}}</a>
  <span>/</span>
  <span class="truncate text-slate-600">{{lesson.title}}</span>
</div>

<div class="mb-5 flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
  <div>
    <div class="flex flex-wrap items-center gap-2">
      <span class="rounded-full px-2.5 py-1 text-[10px] font-bold uppercase tracking-wide {{#if (eq lesson.status "published")}}bg-emerald-50 text-emerald-700{{else}}bg-amber-50 text-amber-700{{/if}}">{{lesson.status}}</span>
      <span class="rounded-full bg-slate-100 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wide text-slate-500">{{lesson.module.title}}</span>
    </div>
    <h1 class="mt-2 text-2xl font-bold tracking-tight text-navy-900">Edit lesson</h1>
    <p class="mt-1 text-sm text-slate-500">{{lesson.durationMinutes}} min · {{lesson.resources.length}} resource(s)</p>
  </div>
  <div class="flex flex-wrap gap-2">
    <a href="/learn/{{lesson.id}}" class="rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold text-navy-900 transition hover:bg-slate-50">Preview lesson</a>
    <a href="/instructor/lessons/{{lesson.id}}/questions" class="rounded-xl bg-brand-600 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-700">Question bank ({{approved}})</a>
  </div>
</div>

<div class="grid gap-6 xl:grid-cols-[minmax(0,1fr)_320px]">
  <form action="/instructor/lessons/{{lesson.id}}" method="POST" class="space-y-5">
    <input type="hidden" name="_csrf" value="{{csrfToken}}" />

    <section class="rounded-2xl border border-slate-200 bg-white shadow-sm">
      <div class="border-b border-slate-100 px-5 py-4">
        <h2 class="text-sm font-bold text-navy-900">Lesson details</h2>
      </div>
      <div class="grid gap-4 p-5 sm:grid-cols-3">
        <div class="sm:col-span-2">
          <label for="title" class="label">Lesson title</label>
          <input id="title" name="title" type="text" required maxlength="160" value="{{lesson.title}}" class="field" />
        </div>
        <div>
          <label for="durationMinutes" class="label">Duration (minutes)</label>
          <input id="durationMinutes" name="durationMinutes" type="number" min="1" max="600" value="{{lesson.durationMinutes}}" class="field" />
        </div>
        <div class="sm:col-span-3">
          <label for="summary" class="label">Summary</label>
          <input id="summary" name="summary" type="text" maxlength="400" value="{{lesson.summary}}" class="field" placeholder="A one-line description for the lesson list" />
        </div>
      </div>
    </section>

    <section class="rounded-2xl border border-slate-200 bg-white shadow-sm">
      <div class="flex flex-col gap-1 border-b border-slate-100 px-5 py-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <h2 class="text-sm font-bold text-navy-900">Webpage content</h2>
          <p class="mt-0.5 text-xs text-slate-400">Auto-converted HTML. Review and edit before publishing.</p>
        </div>
        <span class="text-[11px] text-slate-400">{{#if lesson.sourceName}}Source: {{lesson.sourceName}}{{else}}Authored in the LMS{{/if}}</span>
      </div>
      <div class="p-5">
        {{#if lesson.content.conversionNotes}}
          <div class="mb-3 rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-[11px] leading-relaxed text-slate-500">
            <span class="font-semibold text-slate-700">Conversion notes:</span> {{lesson.content.conversionNotes}}
          </div>
        {{/if}}
        <label for="content_html" class="label">Lesson HTML</label>
        <textarea id="content_html" name="content_html" rows="22" class="field font-mono text-xs leading-relaxed">{{lesson.content.html}}</textarea>
        <p class="mt-1 text-[11px] text-slate-400">Scripts are stripped by the sanitizer. Use headings (h2/h3), paragraphs, lists, and tables for clean lesson typography.</p>
      </div>
    </section>

    <div class="flex flex-col gap-3 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:flex-row sm:items-center sm:justify-between">
      <div>
        <label for="status" class="label">Lesson status</label>
        <select id="status" name="status" class="field sm:w-64">
          <option value="draft" {{#if (eq lesson.status "draft")}}selected{{/if}}>Draft — hidden from learners</option>
          <option value="published" {{#if (eq lesson.status "published")}}selected{{/if}}>Published — visible in course</option>
        </select>
      </div>
      <div class="flex gap-2">
        <a href="/instructor/courses/{{lesson.courseId}}/builder" class="rounded-xl border border-slate-300 px-4 py-2.5 text-sm font-semibold text-navy-900 transition hover:bg-slate-50">Cancel</a>
        <button type="submit" class="rounded-xl bg-brand-600 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-700">Save lesson</button>
      </div>
    </div>
  </form>

  <aside class="space-y-4">
    <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <p class="text-[10px] font-bold uppercase tracking-[0.14em] text-slate-400">Publish gate</p>
      <div class="mt-3 flex items-end justify-between">
        <div>
          <p class="text-2xl font-extrabold text-navy-900">{{approved}}</p>
          <p class="text-[11px] text-slate-400">approved questions</p>
        </div>
        <div class="text-right">
          <p class="text-2xl font-extrabold text-navy-900">{{requiredQuestions}}</p>
          <p class="text-[11px] text-slate-400">required</p>
        </div>
      </div>
      <div class="mt-3 h-2 overflow-hidden rounded-full bg-slate-100">
        <div class="h-full rounded-full {{#if (gte approved requiredQuestions)}}bg-emerald-500{{else}}bg-amber-500{{/if}}" style="width: {{#if (gte approved requiredQuestions)}}100{{else}}{{approved}}{{/if}}%"></div>
      </div>
      {{#if (gte approved requiredQuestions)}}
        <p class="mt-3 rounded-xl bg-emerald-50 p-3 text-[11px] text-emerald-700">Enough approved questions. This lesson can be published.</p>
      {{else}}
        <p class="mt-3 rounded-xl bg-amber-50 p-3 text-[11px] leading-relaxed text-amber-700">Publishing is blocked until {{requiredQuestions}} questions are approved. {{pending}} generated question(s) are waiting for review.</p>
      {{/if}}
      <a href="/instructor/lessons/{{lesson.id}}/questions" class="mt-3 block rounded-xl bg-brand-600 px-4 py-2.5 text-center text-xs font-semibold text-white transition hover:bg-brand-700">Review question bank</a>
    </section>

    {{#if lesson.resources.length}}
      <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
        <p class="text-[10px] font-bold uppercase tracking-[0.14em] text-slate-400">Source resources</p>
        <div class="mt-3 space-y-2">
          {{#each lesson.resources}}
            <div class="rounded-lg border border-slate-200 p-2.5">
              <div class="flex items-center gap-2">
                <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-md bg-brand-50 text-[9px] font-extrabold uppercase text-brand-700">FILE</span>
                <span class="min-w-0 flex-1 truncate text-xs font-semibold text-slate-700">{{fileName}}</span>
              </div>
              <div class="mt-2 flex items-center gap-2">
                <a href="/instructor/resources/{{id}}/preview" class="flex-1 rounded-md bg-brand-600 px-2 py-1.5 text-center text-[10px] font-semibold text-white transition hover:bg-brand-700">View document</a>
                <a href="/resources/{{id}}/download" class="rounded-md border border-slate-200 px-2 py-1.5 text-[10px] font-semibold text-slate-600 transition hover:bg-slate-50">Download</a>
              </div>
            </div>
          {{/each}}
        </div>
      </section>
    {{/if}}

    <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <p class="text-[10px] font-bold uppercase tracking-[0.14em] text-slate-400">Danger zone</p>
      <p class="mt-2 text-[11px] leading-relaxed text-slate-500">Deleting a lesson also deletes its content, resources, and question bank. Lessons with assessment attempts cannot be deleted — unpublish them instead.</p>
      <form action="/instructor/lessons/{{lesson.id}}/delete" method="POST" class="mt-3" data-confirm="Permanently delete this lesson and its question bank?">
        <input type="hidden" name="_csrf" value="{{csrfToken}}" />
        <button type="submit" class="w-full rounded-xl border border-rose-200 bg-rose-50 px-4 py-2.5 text-xs font-semibold text-rose-700 transition hover:bg-rose-100">Delete lesson</button>
      </form>
    </section>
  </aside>
</div>

{{> app_end}}
