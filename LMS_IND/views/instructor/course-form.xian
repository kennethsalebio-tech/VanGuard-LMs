{{> app_start}}

<div class="mb-5">
  <a href="/instructor/courses" class="text-xs font-semibold text-slate-400 hover:text-brand-600">← Back to courses</a>
  <h1 class="mt-2 text-2xl font-bold tracking-tight text-navy-900">{{#if course}}Course settings{{else}}Create a course{{/if}}</h1>
  <p class="mt-1 text-sm text-slate-500">{{#if course}}Update the course details and knowledge-check policy.{{else}}Start with the course identity and assessment policy. You will add modules and lessons next.{{/if}}</p>
</div>

<form action="{{#if course}}/instructor/courses/{{course.id}}{{else}}/instructor/courses{{/if}}" method="POST" class="grid gap-6 xl:grid-cols-3">
  <input type="hidden" name="_csrf" value="{{csrfToken}}" />

  <div class="space-y-6 xl:col-span-2">
    <section class="rounded-2xl border border-slate-200 bg-white shadow-sm">
      <div class="border-b border-slate-100 px-5 py-4">
        <h2 class="text-sm font-bold text-navy-900">Course details</h2>
      </div>
      <div class="space-y-4 p-5 sm:p-6">
        <div>
          <label for="title" class="label">Course title</label>
          <input id="title" name="title" type="text" required maxlength="160" value="{{course.title}}" class="field" placeholder="e.g. Workplace Safety & Onboarding" />
        </div>
        <div>
          <label for="description" class="label">Short description</label>
          <textarea id="description" name="description" rows="3" class="field" placeholder="What the course covers and who it is for.">{{course.description}}</textarea>
        </div>
        <div>
          <label for="objectives" class="label">Learning objectives</label>
          <textarea id="objectives" name="objectives" rows="5" class="field" placeholder="One objective per line. These appear on the course overview.">{{course.objectives}}</textarea>
          <p class="mt-1 text-[11px] text-slate-400">Use one objective per line. The overview preserves line breaks.</p>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label for="categoryId" class="label">Category</label>
            <select id="categoryId" name="categoryId" class="field">
              <option value="">Uncategorized</option>
              {{#each categories}}
                <option value="{{id}}" {{#if (eq id ../course.categoryId)}}selected{{/if}}>{{name}}</option>
              {{/each}}
            </select>
          </div>
          <div>
            <label for="level" class="label">Level</label>
            <select id="level" name="level" class="field">
              <option value="beginner" {{#if (eq course.level "beginner")}}selected{{/if}}>Beginner</option>
              <option value="intermediate" {{#if (eq course.level "intermediate")}}selected{{/if}}>Intermediate</option>
              <option value="advanced" {{#if (eq course.level "advanced")}}selected{{/if}}>Advanced</option>
            </select>
          </div>
          <div>
            <label for="durationHours" class="label">Estimated duration (hours)</label>
            <input id="durationHours" name="durationHours" type="number" min="0.5" step="0.5" value="{{course.durationHours}}" class="field" />
          </div>
          <div>
            <label for="accent" class="label">Course accent color</label>
            <div class="flex items-center gap-3">
              <input id="accent" name="accent" type="color" value="{{#if course.accent}}{{course.accent}}{{else}}#1d4ed8{{/if}}" class="h-10 w-14 cursor-pointer rounded-lg border border-slate-300 bg-white p-1" />
              <span class="text-[11px] text-slate-400">Used on catalog cards and the course header.</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="rounded-2xl border border-slate-200 bg-white shadow-sm">
      <div class="border-b border-slate-100 px-5 py-4">
        <h2 class="text-sm font-bold text-navy-900">Knowledge-check policy</h2>
        <p class="mt-0.5 text-xs text-slate-400">Defaults: 5 questions per attempt, pass with 4 (80%).</p>
      </div>
      <div class="space-y-4 p-5 sm:p-6">
        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label for="questionCount" class="label">Questions per attempt</label>
            <input id="questionCount" name="questionCount" type="number" min="1" max="10" value="{{#if course}}{{course.questionCount}}{{else}}5{{/if}}" class="field" />
            <p class="mt-1 text-[11px] text-slate-400">Randomly selected from the approved bank on every attempt.</p>
          </div>
          <div>
            <label for="passScore" class="label">Correct answers required to pass</label>
            <input id="passScore" name="passScore" type="number" min="1" max="10" value="{{#if course}}{{course.passScore}}{{else}}4{{/if}}" class="field" />
            <p class="mt-1 text-[11px] text-slate-400">Must not exceed the number of questions per attempt.</p>
          </div>
          <div>
            <label for="maxAttempts" class="label">Maximum attempts (0 = unlimited)</label>
            <input id="maxAttempts" name="maxAttempts" type="number" min="0" max="20" value="{{#if course}}{{course.maxAttempts}}{{else}}0{{/if}}" class="field" />
          </div>
          {{#if course}}
            <div>
              <label for="status" class="label">Course status</label>
              <select id="status" name="status" class="field">
                <option value="draft" {{#if (eq course.status "draft")}}selected{{/if}}>Draft — hidden from catalog</option>
                <option value="published" {{#if (eq course.status "published")}}selected{{/if}}>Published — visible to learners</option>
                <option value="archived" {{#if (eq course.status "archived")}}selected{{/if}}>Archived</option>
              </select>
            </div>
          {{/if}}
        </div>

        <div class="space-y-2.5 border-t border-slate-100 pt-4">
          <label class="flex items-start gap-3 text-sm text-slate-600">
            <input type="checkbox" name="allowRetakes" class="mt-0.5 h-4 w-4 rounded accent-brand-600" {{#if course}}{{#if course.allowRetakes}}checked{{/if}}{{else}}checked{{/if}} />
            <span>Allow learners to retake knowledge checks<span class="mt-0.5 block text-[11px] text-slate-400">Subject to the maximum-attempt limit above.</span></span>
          </label>
          <label class="flex items-start gap-3 text-sm text-slate-600">
            <input type="checkbox" name="showExplanations" class="mt-0.5 h-4 w-4 rounded accent-brand-600" {{#if course}}{{#if course.showExplanations}}checked{{/if}}{{else}}checked{{/if}} />
            <span>Show the answer review and explanations after submission</span>
          </label>
          <label class="flex items-start gap-3 text-sm text-slate-600">
            <input type="checkbox" name="certificateEnabled" class="mt-0.5 h-4 w-4 rounded accent-brand-600" {{#if course}}{{#if course.certificateEnabled}}checked{{/if}}{{else}}checked{{/if}} />
            <span>Issue a certificate when the learner completes the course</span>
          </label>
        </div>
      </div>
    </section>
  </div>

  <aside class="space-y-4">
    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <p class="text-[10px] font-bold uppercase tracking-[0.14em] text-slate-400">Publishing checklist</p>
      <ol class="mt-3 space-y-2.5 text-xs text-slate-500">
        <li class="flex gap-2"><span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-brand-500"></span>Create at least one module.</li>
        <li class="flex gap-2"><span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-brand-500"></span>Upload and review a lesson webpage.</li>
        <li class="flex gap-2"><span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-brand-500"></span>Approve at least {{#if course}}{{course.questionCount}}{{else}}5{{/if}} questions per lesson.</li>
        <li class="flex gap-2"><span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-brand-500"></span>Publish each lesson, then the course.</li>
      </ol>
    </div>

    <div class="rounded-2xl bg-navy-900 p-5 text-white">
      <p class="text-[10px] font-bold uppercase tracking-[0.16em] text-brand-300">Instructor control</p>
      <p class="mt-2 text-sm leading-relaxed text-slate-300">Only you (and super administrators) can edit this course. Lessons cannot be published without enough instructor-approved questions.</p>
    </div>

    <button type="submit" class="w-full rounded-xl bg-brand-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-brand-700">
      {{#if course}}Save settings{{else}}Create course →{{/if}}
    </button>
    {{#if course}}
      <a href="/instructor/courses/{{course.id}}/builder" class="block w-full rounded-xl border border-slate-300 px-5 py-3 text-center text-sm font-semibold text-navy-900 transition hover:bg-slate-50">Cancel</a>
    {{else}}
      <a href="/instructor/courses" class="block w-full rounded-xl border border-slate-300 px-5 py-3 text-center text-sm font-semibold text-navy-900 transition hover:bg-slate-50">Cancel</a>
    {{/if}}
  </aside>
</form>

{{> app_end}}
