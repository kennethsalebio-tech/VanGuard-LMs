{{> app_start}}

<div class="mb-4 flex items-center gap-2 text-xs text-slate-400">
  <a href="/instructor/courses" class="hover:text-brand-600">My courses</a>
  <span>/</span>
  <a href="/instructor/lessons/{{lesson.id}}/questions" class="max-w-[220px] truncate hover:text-brand-600">{{lesson.title}}</a>
  <span>/</span>
  <span class="text-slate-600">Edit question</span>
</div>

<div class="mx-auto max-w-3xl">
  <div class="mb-5 flex flex-wrap items-center justify-between gap-3">
    <div>
      <div class="flex items-center gap-2">
        <span class="rounded-full px-2.5 py-1 text-[9px] font-bold uppercase tracking-wide
          {{#if (eq question.status "approved")}}bg-emerald-50 text-emerald-700
          {{else if (eq question.status "pending")}}bg-amber-50 text-amber-700
          {{else}}bg-slate-100 text-slate-500{{/if}}">{{question.status}}</span>
        <span class="text-[10px] capitalize text-slate-400">{{question.generatedBy}} · {{question.type}}</span>
      </div>
      <h1 class="mt-2 text-2xl font-bold tracking-tight text-navy-900">Edit question</h1>
      <p class="mt-1 text-sm text-slate-500">{{lesson.title}}</p>
    </div>
    <a href="/instructor/lessons/{{lesson.id}}/questions" class="rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold text-navy-900 transition hover:bg-slate-50">Back to bank</a>
  </div>

  <form action="/instructor/questions/{{question.id}}/edit" method="POST" class="space-y-5">
    <input type="hidden" name="_csrf" value="{{csrfToken}}" />

    <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6">
      <div>
        <label for="prompt" class="label">Question prompt</label>
        <textarea id="prompt" name="prompt" rows="4" required class="field" placeholder="Question text">{{question.prompt}}</textarea>
      </div>

      <div class="mt-5">
        <p class="label">Answer options</p>
        <p class="mb-2 text-[11px] text-slate-400">Edit the option text and select the single correct answer.</p>
        <div class="space-y-2">
          {{#each options}}
            <div class="flex items-center gap-3 rounded-xl border border-slate-200 bg-slate-50/50 px-3 py-2">
              <input type="radio" name="correct_option" value="{{id}}" class="h-4 w-4 shrink-0 accent-emerald-600" {{#if isCorrect}}checked{{/if}} required />
              <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-white text-xs font-bold text-slate-500 shadow-sm">{{optionLetter @index}}</span>
              <input type="text" name="option_{{id}}" value="{{text}}" required class="field flex-1" />
            </div>
          {{/each}}
        </div>
      </div>

      <div class="mt-5 grid gap-4 sm:grid-cols-2">
        <div>
          <label for="difficulty" class="label">Difficulty</label>
          <select id="difficulty" name="difficulty" class="field">
            <option value="easy" {{#if (eq question.difficulty "easy")}}selected{{/if}}>Easy</option>
            <option value="medium" {{#if (eq question.difficulty "medium")}}selected{{/if}}>Medium</option>
            <option value="hard" {{#if (eq question.difficulty "hard")}}selected{{/if}}>Hard</option>
          </select>
        </div>
        <div>
          <label class="label">Source reference</label>
          <p class="field bg-slate-50 text-slate-500">{{#if question.sourceRef}}{{question.sourceRef}}{{else}}Not specified{{/if}}</p>
        </div>
      </div>

      <div class="mt-4">
        <label for="explanation" class="label">Explanation (shown after submission when enabled)</label>
        <textarea id="explanation" name="explanation" rows="3" class="field" placeholder="Explain why the selected answer is correct.">{{question.explanation}}</textarea>
      </div>
    </section>

    <div class="flex flex-col justify-between gap-3 rounded-2xl border border-slate-200 bg-white p-4 shadow-sm sm:flex-row sm:items-center">
      <p class="text-[11px] leading-relaxed text-slate-500">Saving does not change the approval status. A pending question still requires approval before it can appear in a knowledge check.</p>
      <div class="flex shrink-0 gap-2">
        <a href="/instructor/lessons/{{lesson.id}}/questions" class="rounded-xl border border-slate-300 px-4 py-2.5 text-sm font-semibold text-navy-900 transition hover:bg-slate-50">Cancel</a>
        <button type="submit" class="rounded-xl bg-brand-600 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-700">Save question</button>
      </div>
    </div>
  </form>
</div>

{{> app_end}}
