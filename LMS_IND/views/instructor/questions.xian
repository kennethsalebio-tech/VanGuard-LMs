{{> app_start}}

<div class="mb-4 flex items-center gap-2 text-xs text-slate-400">
  <a href="/instructor/courses" class="hover:text-brand-600">My courses</a>
  <span>/</span>
  <a href="/instructor/courses/{{lesson.courseId}}/builder" class="max-w-[200px] truncate hover:text-brand-600">{{lesson.course.title}}</a>
  <span>/</span>
  <span class="truncate text-slate-600">{{lesson.title}}</span>
</div>

<div class="mb-5 flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
  <div>
    <p class="text-xs font-bold uppercase tracking-[0.16em] text-brand-600">Question bank</p>
    <h1 class="mt-1.5 text-2xl font-bold tracking-tight text-navy-900">{{lesson.title}}</h1>
    <p class="mt-1 text-sm text-slate-500">{{questions.length}} total · {{approved}} approved · {{pending}} pending · {{rejected}} rejected</p>
  </div>
  <div class="flex flex-wrap gap-2">
    <a href="/instructor/lessons/{{lesson.id}}/edit" class="rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold text-navy-900 transition hover:bg-slate-50">Edit lesson</a>
    {{#if pending}}
      <form action="/instructor/lessons/{{lesson.id}}/questions/approve-all" method="POST" data-confirm="Approve all {{pending}} pending questions? Review them first if you have not already.">
        <input type="hidden" name="_csrf" value="{{csrfToken}}" />
        <button type="submit" class="rounded-xl bg-emerald-600 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-emerald-700">Approve all pending</button>
      </form>
    {{/if}}
  </div>
</div>

<div class="mb-5 flex flex-col gap-3 rounded-2xl border {{#if (gte approved requiredQuestions)}}border-emerald-200 bg-emerald-50{{else}}border-amber-200 bg-amber-50{{/if}} px-5 py-4 sm:flex-row sm:items-center sm:justify-between">
  <div>
    <p class="text-sm font-semibold {{#if (gte approved requiredQuestions)}}text-emerald-900{{else}}text-amber-900{{/if}}">
      {{#if (gte approved requiredQuestions)}}The lesson has enough approved questions.{{else}}{{requiredQuestions}} approved questions are required to publish this lesson.{{/if}}
    </p>
    <p class="mt-0.5 text-xs {{#if (gte approved requiredQuestions)}}text-emerald-700{{else}}text-amber-700{{/if}}">
      Each learner attempt draws {{requiredQuestions}} questions at random from the approved pool, with answer order shuffled server-side.
    </p>
  </div>
  <div class="flex shrink-0 items-center gap-2 text-xs font-bold">
    <span class="rounded-full bg-white/70 px-3 py-1.5 text-navy-900">{{approved}} / {{requiredQuestions}} approved</span>
    {{#if engine}}<span class="rounded-full bg-white/70 px-3 py-1.5 capitalize text-slate-600">{{engine}}</span>{{/if}}
  </div>
</div>

<div class="grid gap-6 xl:grid-cols-[minmax(0,1fr)_340px]">
  <div class="space-y-3">
    {{#if questions}}
      {{#each questions}}
        <article class="overflow-hidden rounded-2xl border bg-white shadow-sm {{#if (eq status "approved")}}border-emerald-200{{else if (eq status "pending")}}border-amber-200{{else}}border-slate-200{{/if}}">
          <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-100 px-5 py-3">
            <div class="flex flex-wrap items-center gap-2">
              <span class="rounded-full px-2.5 py-1 text-[9px] font-bold uppercase tracking-wide
                {{#if (eq status "approved")}}bg-emerald-50 text-emerald-700
                {{else if (eq status "pending")}}bg-amber-50 text-amber-700
                {{else}}bg-slate-100 text-slate-500{{/if}}">{{status}}</span>
              <span class="rounded-full bg-slate-100 px-2.5 py-1 text-[9px] font-bold uppercase tracking-wide text-slate-500">{{#if (eq type "true_false")}}True / false{{else}}MCQ{{/if}}</span>
              <span class="rounded-full bg-slate-100 px-2.5 py-1 text-[9px] font-bold uppercase tracking-wide capitalize text-slate-500">{{difficulty}}</span>
              <span class="text-[10px] capitalize text-slate-400">{{generatedBy}}</span>
            </div>
            <div class="flex items-center gap-1.5">
              {{#if (eq status "pending")}}
                <form action="/instructor/questions/{{id}}/approve" method="POST">
                  <input type="hidden" name="_csrf" value="{{../csrfToken}}" />
                  <button type="submit" class="rounded-lg bg-emerald-600 px-2.5 py-1.5 text-[11px] font-semibold text-white transition hover:bg-emerald-700">Approve</button>
                </form>
                <form action="/instructor/questions/{{id}}/reject" method="POST">
                  <input type="hidden" name="_csrf" value="{{../csrfToken}}" />
                  <button type="submit" class="rounded-lg border border-slate-300 px-2.5 py-1.5 text-[11px] font-semibold text-slate-600 transition hover:bg-slate-50">Reject</button>
                </form>
              {{else if (eq status "approved")}}
                <form action="/instructor/questions/{{id}}/reject" method="POST">
                  <input type="hidden" name="_csrf" value="{{../csrfToken}}" />
                  <button type="submit" class="rounded-lg border border-slate-300 px-2.5 py-1.5 text-[11px] font-semibold text-slate-600 transition hover:bg-slate-50">Revoke</button>
                </form>
              {{else}}
                <form action="/instructor/questions/{{id}}/approve" method="POST">
                  <input type="hidden" name="_csrf" value="{{../csrfToken}}" />
                  <button type="submit" class="rounded-lg border border-emerald-300 px-2.5 py-1.5 text-[11px] font-semibold text-emerald-700 transition hover:bg-emerald-50">Re-approve</button>
                </form>
              {{/if}}
              <a href="/instructor/questions/{{id}}/edit" class="rounded-lg border border-slate-300 px-2.5 py-1.5 text-[11px] font-semibold text-navy-900 transition hover:bg-slate-50">Edit</a>
              <form action="/instructor/questions/{{id}}/delete" method="POST" data-confirm="Delete this question permanently?">
                <input type="hidden" name="_csrf" value="{{../csrfToken}}" />
                <button type="submit" class="rounded-lg p-1.5 text-slate-400 transition hover:bg-rose-50 hover:text-rose-600" title="Delete question">
                  <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                </button>
              </form>
            </div>
          </div>
          <div class="px-5 py-4">
            <p class="text-sm font-semibold leading-relaxed text-navy-900">{{prompt}}</p>
            <div class="mt-3 grid gap-2 sm:grid-cols-2">
              {{#each options}}
                <div class="flex items-start gap-2 rounded-lg border px-3 py-2 text-xs {{#if isCorrect}}border-emerald-300 bg-emerald-50 text-emerald-900{{else}}border-slate-200 text-slate-600{{/if}}">
                  <span class="flex h-5 w-5 shrink-0 items-center justify-center rounded-full text-[10px] font-bold {{#if isCorrect}}bg-emerald-600 text-white{{else}}bg-slate-100 text-slate-500{{/if}}">{{optionLetter @index}}</span>
                  <span class="flex-1">{{text}}</span>
                  {{#if isCorrect}}<span class="text-[9px] font-bold uppercase tracking-wide text-emerald-700">Correct</span>{{/if}}
                </div>
              {{/each}}
            </div>
            {{#if explanation}}
              <p class="mt-3 rounded-lg bg-slate-50 px-3 py-2 text-[11px] leading-relaxed text-slate-500"><span class="font-semibold text-slate-700">Explanation:</span> {{explanation}}</p>
            {{/if}}
            {{#if sourceRef}}<p class="mt-2 text-[10px] text-slate-400">Source: {{sourceRef}}</p>{{/if}}
          </div>
        </article>
      {{/each}}
    {{else}}
      <div class="rounded-2xl border border-dashed border-slate-300 bg-white px-6 py-14 text-center">
        <span class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-brand-50 text-brand-600">
          <svg class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        </span>
        <h2 class="mt-4 text-lg font-bold text-navy-900">No questions yet</h2>
        <p class="mx-auto mt-1 max-w-md text-sm text-slate-500">Generate a draft bank from the lesson content, or author a question manually. Generated questions stay pending until you approve them.</p>
      </div>
    {{/if}}
  </div>

  <aside class="space-y-4">
    <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <h2 class="text-sm font-bold text-navy-900">AI-assisted generation</h2>
      <p class="mt-1 text-[11px] leading-relaxed text-slate-500">Generates 20–50 draft questions grounded in the lesson text. If an LLM key is configured it is used; otherwise the local deterministic generator runs.</p>
      <form action="/instructor/lessons/{{lesson.id}}/questions/generate" method="POST" class="mt-3 space-y-3">
        <input type="hidden" name="_csrf" value="{{csrfToken}}" />
        <div>
          <label for="count" class="label">Number of questions</label>
          <input id="count" name="count" type="number" min="20" max="50" value="25" class="field" />
        </div>
        <button type="submit" class="flex w-full items-center justify-center gap-2 rounded-xl bg-brand-600 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-700">
          <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
          Generate draft questions
        </button>
      </form>
      <p class="mt-3 rounded-xl bg-amber-50 p-3 text-[10px] leading-relaxed text-amber-700">Nothing is used automatically. Every generated question is saved as <strong>pending</strong> and must be reviewed and approved by an instructor.</p>
    </section>

    <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <h2 class="text-sm font-bold text-navy-900">Add a question manually</h2>
      <form action="/instructor/lessons/{{lesson.id}}/questions/manual" method="POST" class="mt-3 space-y-3">
        <input type="hidden" name="_csrf" value="{{csrfToken}}" />
        <div>
          <label class="label" for="prompt">Question</label>
          <textarea id="prompt" name="prompt" rows="3" required class="field" placeholder="What should the learner know?"></textarea>
        </div>
        <div class="space-y-2">
          <label class="label">Options — select the correct one</label>
          <div class="flex items-center gap-2"><input type="radio" name="correct" value="0" class="h-4 w-4 accent-emerald-600" required /><input name="option1" type="text" required placeholder="Option A" class="field" /></div>
          <div class="flex items-center gap-2"><input type="radio" name="correct" value="1" class="h-4 w-4 accent-emerald-600" /><input name="option2" type="text" required placeholder="Option B" class="field" /></div>
          <div class="flex items-center gap-2"><input type="radio" name="correct" value="2" class="h-4 w-4 accent-emerald-600" /><input name="option3" type="text" required placeholder="Option C" class="field" /></div>
          <div class="flex items-center gap-2"><input type="radio" name="correct" value="3" class="h-4 w-4 accent-emerald-600" /><input name="option4" type="text" required placeholder="Option D" class="field" /></div>
        </div>
        <div>
          <label class="label" for="explanation">Explanation (optional)</label>
          <textarea id="explanation" name="explanation" rows="2" class="field" placeholder="Why the correct answer is correct."></textarea>
        </div>
        <div>
          <label class="label" for="difficulty">Difficulty</label>
          <select id="difficulty" name="difficulty" class="field">
            <option value="easy">Easy</option>
            <option value="medium" selected>Medium</option>
            <option value="hard">Hard</option>
          </select>
        </div>
        <button type="submit" class="w-full rounded-xl bg-brand-600 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-700">Add and approve question</button>
      </form>
    </section>

    <section class="rounded-2xl bg-navy-900 p-5 text-white">
      <p class="text-[10px] font-bold uppercase tracking-[0.16em] text-brand-300">Review standard</p>
      <p class="mt-2 text-sm leading-relaxed text-slate-300">Check that each question is answerable from the lesson, has exactly one defensible correct answer, and no duplicates. Approve only what you would put in a proctored test.</p>
    </section>
  </aside>
</div>

{{> app_end}}
