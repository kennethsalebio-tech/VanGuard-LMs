{{> app_start}}

<div class="mb-6 flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
  <div>
    <p class="text-xs font-bold uppercase tracking-[0.16em] text-brand-600">Course management</p>
    <h1 class="mt-1.5 text-2xl font-bold tracking-tight text-navy-900 sm:text-3xl">My courses</h1>
    <p class="mt-1 text-sm text-slate-500">Draft, publish, and monitor the courses you own.</p>
  </div>
  <a href="/instructor/courses/new" class="inline-flex items-center gap-2 rounded-xl bg-brand-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-brand-700">
    <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" /></svg>
    Create course
  </a>
</div>

{{#if courses}}
  <div class="space-y-3">
    {{#each courses}}
      <article class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <div class="flex flex-col gap-4 p-5 sm:flex-row sm:items-center">
          <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl text-sm font-bold text-white" style="background-color: {{accent}}">{{initials title}}</span>
          <div class="min-w-0 flex-1">
            <div class="flex flex-wrap items-center gap-2">
              <a href="/instructor/courses/{{id}}/builder" class="truncate text-base font-bold text-navy-900 hover:text-brand-600">{{title}}</a>
              <span class="rounded-full px-2.5 py-0.5 text-[9px] font-bold uppercase tracking-wide
                {{#if (eq status "published")}}bg-emerald-50 text-emerald-700{{else if (eq status "archived")}}bg-slate-100 text-slate-500{{else}}bg-amber-50 text-amber-700{{/if}}">{{status}}</span>
              <span class="rounded-full bg-slate-100 px-2.5 py-0.5 text-[9px] font-bold uppercase tracking-wide text-slate-500">{{level}}</span>
              {{#if category}}<span class="text-[10px] font-semibold text-brand-600">{{category.name}}</span>{{/if}}
            </div>
            <p class="mt-1 line-clamp-1 text-xs text-slate-500">{{description}}</p>
            <div class="mt-2.5 flex flex-wrap items-center gap-x-4 gap-y-1 text-[11px] text-slate-400">
              <span><strong class="font-semibold text-slate-600">{{moduleCount}}</strong> modules</span>
              <span><strong class="font-semibold text-slate-600">{{lessonCount}}</strong> lessons</span>
              <span><strong class="font-semibold text-slate-600">{{learnerCount}}</strong> learners</span>
              <span><strong class="font-semibold text-slate-600">{{approvedQuestions}}</strong> approved questions</span>
              <span><strong class="font-semibold text-slate-600">{{avgProgress}}%</strong> avg progress</span>
            </div>
          </div>
          <div class="flex shrink-0 flex-wrap items-center gap-2">
            <a href="/instructor/courses/{{id}}/edit" class="rounded-lg border border-slate-300 px-3 py-2 text-xs font-semibold text-navy-900 transition hover:bg-slate-50">Settings</a>
            <a href="/instructor/courses/{{id}}/learners" class="rounded-lg border border-slate-300 px-3 py-2 text-xs font-semibold text-navy-900 transition hover:bg-slate-50">Learners</a>
            <a href="/instructor/courses/{{id}}/builder" class="rounded-lg bg-brand-600 px-3 py-2 text-xs font-semibold text-white transition hover:bg-brand-700">Open builder</a>
            <form action="/instructor/courses/{{id}}/archive" method="POST" data-confirm="{{#if (eq status "archived")}}Restore this course to draft?{{else}}Archive this course? Learners will lose catalog access.{{/if}}">
              <input type="hidden" name="_csrf" value="{{csrfToken}}" />
              <button type="submit" class="rounded-lg p-2 text-slate-400 transition hover:bg-slate-100 hover:text-navy-900" title="{{#if (eq status "archived")}}Restore{{else}}Archive{{/if}}">
                <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4" /></svg>
              </button>
            </form>
          </div>
        </div>
        {{#if (eq status "draft")}}
          <div class="border-t border-amber-100 bg-amber-50/60 px-5 py-2.5 text-[11px] text-amber-700">
            Draft courses are hidden from the catalog. Publish the course after its lessons and question banks are ready.
          </div>
        {{/if}}
      </article>
    {{/each}}
  </div>
{{else}}
  <div class="rounded-2xl border border-dashed border-slate-300 bg-white px-6 py-16 text-center">
    <span class="mx-auto flex h-14 w-14 items-center justify-center rounded-2xl bg-brand-50 text-brand-600">
      <svg class="h-7 w-7" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" /></svg>
    </span>
    <h2 class="mt-4 text-lg font-bold text-navy-900">Create your first course</h2>
    <p class="mx-auto mt-1 max-w-md text-sm text-slate-500">Set the assessment policy, add modules, upload a document module, and approve the generated question bank.</p>
    <a href="/instructor/courses/new" class="mt-5 inline-flex rounded-xl bg-brand-600 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-700">Create course</a>
  </div>
{{/if}}

{{> app_end}}
