{{> app_start}}

<div class="mb-4 flex items-center gap-2 text-xs text-slate-400">
  <a href="/instructor/live" class="hover:text-brand-600">Live classroom</a>
  <span>/</span>
  <span class="text-slate-600">New session</span>
</div>

<div class="mb-6">
  <p class="text-xs font-bold uppercase tracking-[0.16em] text-brand-600">Live classroom</p>
  <h1 class="mt-1.5 text-2xl font-bold tracking-tight text-navy-900 sm:text-3xl">Start or schedule a class</h1>
  <p class="mt-1 text-sm text-slate-500">Choose the course, then start immediately or schedule the session. Enrolled learners are notified automatically.</p>
</div>

<div class="grid gap-6 xl:grid-cols-[minmax(0,1fr)_340px]">
  <form action="/instructor/live" method="POST" class="space-y-5">
    <input type="hidden" name="_csrf" value="{{csrfToken}}" />

    <section class="rounded-2xl border border-slate-200 bg-white shadow-sm">
      <div class="border-b border-slate-100 px-5 py-4">
        <h2 class="text-sm font-bold text-navy-900">Session details</h2>
        <p class="mt-0.5 text-xs text-slate-400">The class is created for one course. Only its enrolled learners can join.</p>
      </div>
      <div class="grid gap-4 p-5 sm:grid-cols-2">
        <div class="sm:col-span-2">
          <label for="courseId" class="label">Course</label>
          <select id="courseId" name="courseId" required class="field">
            {{#each courses}}
              <option value="{{id}}" {{#if (eq id ../selectedCourseId)}}selected{{/if}}>{{title}}</option>
            {{/each}}
          </select>
        </div>
        <div class="sm:col-span-2">
          <label for="title" class="label">Session title</label>
          <input id="title" name="title" type="text" maxlength="160" class="field" placeholder="e.g. Routing and Switching — live review" />
        </div>
        <div class="sm:col-span-2">
          <label for="agenda" class="label">Agenda (optional)</label>
          <textarea id="agenda" name="agenda" rows="3" maxlength="2000" class="field" placeholder="What will you cover in this session?"></textarea>
        </div>
        <div>
          <label for="durationMinutes" class="label">Planned duration (minutes)</label>
          <input id="durationMinutes" name="durationMinutes" type="number" min="5" max="480" value="60" class="field" />
        </div>
        <div>
          <span class="label">When</span>
          <div class="space-y-2">
            <label class="flex cursor-pointer items-center gap-2 rounded-xl border border-slate-200 px-3 py-2 text-xs text-slate-600 transition hover:border-brand-300 hover:bg-brand-50/30">
              <input type="radio" name="mode" value="instant" class="h-4 w-4 accent-brand-600" {{#if (eq defaultMode "instant")}}checked{{/if}} />
              Start now
            </label>
            <label class="flex cursor-pointer items-center gap-2 rounded-xl border border-slate-200 px-3 py-2 text-xs text-slate-600 transition hover:border-brand-300 hover:bg-brand-50/30">
              <input type="radio" name="mode" value="schedule" class="h-4 w-4 accent-brand-600" {{#if (eq defaultMode "schedule")}}checked{{/if}} />
              Schedule for later
            </label>
          </div>
        </div>
        <div class="sm:col-span-2">
          <label for="scheduledStart" class="label">Scheduled start (used when scheduling)</label>
          <input id="scheduledStart" name="scheduledStart" type="datetime-local" value="{{defaultStartValue}}" class="field" />
          <p class="mt-1 text-[10px] text-slate-400">Leave blank for an instant class. Scheduled sessions can be started early from the hub.</p>
        </div>
      </div>
    </section>

    <section class="rounded-2xl border border-slate-200 bg-white shadow-sm">
      <div class="border-b border-slate-100 px-5 py-4">
        <h2 class="text-sm font-bold text-navy-900">Participant permissions</h2>
      </div>
      <div class="space-y-3 p-5">
        <label class="flex items-start gap-3 rounded-xl border border-slate-200 px-4 py-3 text-xs text-slate-600">
          <input type="checkbox" name="allowScreenShare" class="mt-0.5 h-4 w-4 accent-brand-600" checked />
          <span><span class="font-semibold text-navy-900">Allow learners to share their screen.</span><br />The host can always share.</span>
        </label>
        <label class="flex items-start gap-3 rounded-xl border border-slate-200 px-4 py-3 text-xs text-slate-600">
          <input type="checkbox" name="allowChat" class="mt-0.5 h-4 w-4 accent-brand-600" checked />
          <span><span class="font-semibold text-navy-900">Enable the meeting chat.</span><br />Messages are stored with the session.</span>
        </label>
        <p class="rounded-xl bg-slate-50 p-3 text-[11px] leading-relaxed text-slate-500">Recording is never started automatically. If you need a recording, use the conference provider’s controls and obtain participants’ consent first.</p>
      </div>
    </section>

    <div class="flex flex-col gap-3 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:flex-row sm:items-center sm:justify-between">
      <p class="text-xs text-slate-500">The meeting room is created only for this course and this session.</p>
      <div class="flex gap-2">
        <a href="/instructor/live" class="rounded-xl border border-slate-300 px-4 py-2.5 text-sm font-semibold text-navy-900 transition hover:bg-slate-50">Cancel</a>
        <button type="submit" class="rounded-xl bg-brand-600 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-700">Create live class</button>
      </div>
    </div>
  </form>

  <aside class="space-y-4">
    <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <h2 class="text-sm font-bold text-navy-900">Who can join</h2>
      <ul class="mt-3 space-y-2.5 text-xs text-slate-500">
        <li class="flex gap-2"><span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-brand-500"></span>You, as the instructor and meeting host.</li>
        <li class="flex gap-2"><span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-brand-500"></span>Every learner enrolled in the selected course.</li>
        <li class="flex gap-2"><span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-brand-500"></span>Nobody else — enrollment is checked on every room request.</li>
      </ul>
    </section>
    <section class="rounded-2xl bg-navy-900 p-5 text-white">
      <p class="text-[10px] font-bold uppercase tracking-[0.16em] text-brand-300">Live classroom</p>
      <p class="mt-2 text-sm leading-relaxed text-slate-300">Camera, microphone, screen sharing and chat are handled by the embedded WebRTC conference. Meeting access tokens are issued per user after the enrollment check.</p>
    </section>
  </aside>
</div>

{{> app_end}}
