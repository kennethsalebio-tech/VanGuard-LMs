{{> app_start}}

<div class="mb-6 flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
  <div>
    <p class="text-xs font-bold uppercase tracking-[0.16em] text-brand-600">Monitoring</p>
    <h1 class="mt-1.5 text-2xl font-bold tracking-tight text-navy-900 sm:text-3xl">Learner monitoring</h1>
    <p class="mt-1 text-sm text-slate-500">Progress and assessment activity for learners across your courses.</p>
  </div>
  <span class="rounded-full border border-slate-200 bg-white px-3 py-1.5 text-xs font-semibold text-slate-600">{{learners.length}} enrollments</span>
</div>

<div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
  {{#if learners}}
    <div class="overflow-x-auto">
      <table class="min-w-full text-left text-sm">
        <thead class="bg-slate-50 text-[10px] uppercase tracking-wide text-slate-500">
          <tr>
            <th class="px-5 py-3 font-semibold">Learner</th>
            <th class="px-4 py-3 font-semibold">Course</th>
            <th class="px-4 py-3 font-semibold">Progress</th>
            <th class="px-4 py-3 font-semibold">Attempts</th>
            <th class="px-4 py-3 font-semibold">Passed</th>
            <th class="px-5 py-3 font-semibold">Last sign-in</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          {{#each learners}}
            <tr class="hover:bg-slate-50/70">
              <td class="px-5 py-3">
                <div class="flex items-center gap-2.5">
                  <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-[10px] font-bold text-white" style="background-color: {{user.avatarColor}}">{{initials user.name}}</span>
                  <div class="min-w-0">
                    <p class="truncate text-xs font-semibold text-navy-900">{{user.name}}</p>
                    <p class="truncate text-[10px] text-slate-400">{{user.email}}{{#if user.department}} · {{user.department.name}}{{/if}}</p>
                  </div>
                </div>
              </td>
              <td class="max-w-[200px] px-4 py-3">
                <a href="/instructor/courses/{{courseId}}/learners" class="truncate text-xs text-slate-600 hover:text-brand-600">{{course.title}}</a>
              </td>
              <td class="px-4 py-3">
                <div class="flex items-center gap-2">
                  <div class="h-1.5 w-20 overflow-hidden rounded-full bg-slate-100">
                    <div class="h-full rounded-full {{#if struggling}}bg-rose-500{{else}}bg-brand-500{{/if}}" style="width: {{#if progress}}{{progress.percent}}{{else}}0{{/if}}%"></div>
                  </div>
                  <span class="text-[11px] font-semibold text-slate-600">{{#if progress}}{{progress.percent}}{{else}}0{{/if}}%</span>
                </div>
              </td>
              <td class="px-4 py-3 text-xs text-slate-600">{{attempts}}</td>
              <td class="px-4 py-3 text-xs font-semibold {{#if passed}}text-emerald-600{{else}}text-slate-400{{/if}}">{{passed}}</td>
              <td class="px-5 py-3 text-xs text-slate-400">{{#if user.lastLoginAt}}{{formatDate user.lastLoginAt}}{{else}}Never{{/if}}</td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  {{else}}
    <div class="px-6 py-14 text-center">
      <span class="mx-auto flex h-12 w-12 items-center justify-center rounded-xl bg-slate-100 text-slate-400">
        <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
      </span>
      <p class="mt-3 text-sm font-semibold text-navy-900">No learners enrolled yet</p>
      <p class="mt-1 text-xs text-slate-500">Enrollments in your published courses will appear here.</p>
    </div>
  {{/if}}
</div>

{{> app_end}}
