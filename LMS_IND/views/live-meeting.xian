{{> app_start}}

<div class="mb-4 flex items-center gap-2 text-xs text-slate-400">
  <a href="/live" class="hover:text-brand-600">Live classes</a>
  <span>/</span>
  <span class="truncate text-slate-600">{{meeting.title}}</span>
</div>

<div class="mb-6 flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
  <div class="min-w-0">
    <div class="flex flex-wrap items-center gap-2">
      <span class="rounded-full px-2.5 py-1 text-[10px] font-bold uppercase tracking-wide
        {{#if (eq meeting.status "live")}}bg-emerald-50 text-emerald-700
        {{else if (eq meeting.status "scheduled")}}bg-amber-50 text-amber-700
        {{else if (eq meeting.status "cancelled")}}bg-rose-50 text-rose-700
        {{else}}bg-slate-100 text-slate-500{{/if}}">{{meeting.status}}</span>
      <span class="rounded-full bg-slate-100 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wide text-slate-500">{{meeting.course.title}}</span>
      {{#if canManage}}<span class="rounded-full bg-brand-600 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wide text-white">Host</span>{{/if}}
    </div>
    <h1 class="mt-2 truncate text-2xl font-bold tracking-tight text-navy-900 sm:text-3xl">{{meeting.title}}</h1>
    <p class="mt-1 text-sm text-slate-500">{{meeting.course.title}} · hosted by {{meeting.instructor.name}}</p>
  </div>
  <div class="flex flex-wrap gap-2">
    {{#if (eq meeting.status "live")}}
      <a href="/live/{{meeting.id}}/room" class="inline-flex items-center gap-2 rounded-xl bg-brand-600 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-700">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" /></svg>
        {{#if canManage}}Enter meeting room{{else}}Join live classroom{{/if}}
      </a>
    {{/if}}
    {{#if canManage}}
      {{#if (eq meeting.status "scheduled")}}
        <form action="/instructor/live/{{meeting.id}}/start" method="POST">
          <input type="hidden" name="_csrf" value="{{csrfToken}}" />
          <button type="submit" class="rounded-xl bg-brand-600 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-700">Start now</button>
        </form>
        <form action="/instructor/live/{{meeting.id}}/cancel" method="POST" data-confirm="Cancel this scheduled live class? Enrolled learners will be notified.">
          <input type="hidden" name="_csrf" value="{{csrfToken}}" />
          <button type="submit" class="rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold text-slate-600 transition hover:bg-slate-50">Cancel class</button>
        </form>
      {{/if}}
      {{#if (eq meeting.status "live")}}
        <form action="/instructor/live/{{meeting.id}}/end" method="POST" data-confirm="End this live class for everyone and save attendance?">
          <input type="hidden" name="_csrf" value="{{csrfToken}}" />
          <button type="submit" class="rounded-xl border border-rose-200 bg-rose-50 px-4 py-2.5 text-sm font-semibold text-rose-700 transition hover:bg-rose-100">End class</button>
        </form>
      {{/if}}
    {{/if}}
    <a href="{{#if canManage}}/instructor/live{{else}}/live{{/if}}" class="rounded-xl border border-slate-300 bg-white px-4 py-2.5 text-sm font-semibold text-navy-900 transition hover:bg-slate-50">All live classes</a>
  </div>
</div>

<div class="grid gap-6 xl:grid-cols-[minmax(0,1fr)_340px]">
  <div class="min-w-0 space-y-5">
    <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-card">
      <div class="grid gap-0 sm:grid-cols-3">
        <div class="bg-navy-900 p-6 text-white">
          <p class="text-[10px] font-bold uppercase tracking-[0.14em] text-brand-300">Invited</p>
          <p class="mt-2 text-3xl font-extrabold">{{counts.invited}}</p>
          <p class="mt-1 text-[11px] text-slate-400">enrolled learners</p>
        </div>
        <div class="border-b border-slate-100 p-6 sm:border-b-0 sm:border-l">
          <p class="text-[10px] font-bold uppercase tracking-[0.14em] text-slate-400">Participating</p>
          <p class="mt-2 text-3xl font-extrabold text-navy-900">{{counts.totalJoined}}</p>
          <p class="mt-1 text-[11px] text-slate-400">in the room now</p>
        </div>
        <div class="border-t border-slate-100 p-6 sm:border-l sm:border-t-0">
          <p class="text-[10px] font-bold uppercase tracking-[0.14em] text-slate-400">Duration</p>
          <p class="mt-2 text-3xl font-extrabold text-navy-900">{{meeting.durationMinutes}}</p>
          <p class="mt-1 text-[11px] text-slate-400">minutes planned</p>
        </div>
      </div>
      <div class="grid gap-4 border-t border-slate-100 px-5 py-5 sm:grid-cols-2">
        <div>
          <p class="text-[10px] font-bold uppercase tracking-[0.14em] text-slate-400">Scheduled</p>
          <p class="mt-1 text-sm font-semibold text-navy-900">{{formatDateTime meeting.scheduledStart}}</p>
          <p class="mt-0.5 text-[11px] text-slate-400">Ends {{formatDateTime meeting.scheduledEnd}}</p>
        </div>
        <div>
          <p class="text-[10px] font-bold uppercase tracking-[0.14em] text-slate-400">Session</p>
          {{#if meeting.startedAt}}
            <p class="mt-1 text-sm font-semibold text-navy-900">Started {{formatDateTime meeting.startedAt}}</p>
          {{else}}
            <p class="mt-1 text-sm font-semibold text-navy-900">Not started yet</p>
          {{/if}}
          {{#if meeting.endedAt}}<p class="mt-0.5 text-[11px] text-slate-400">Ended {{formatDateTime meeting.endedAt}}</p>{{/if}}
        </div>
        <div class="sm:col-span-2">
          <p class="text-[10px] font-bold uppercase tracking-[0.14em] text-slate-400">Conference</p>
          <p class="mt-1 text-xs leading-relaxed text-slate-500">Rooms are private to the course. The LMS issues a temporary meeting token after checking your enrollment, and the room is not listed anywhere else. Camera and microphone media travel directly between participants over encrypted WebRTC.</p>
        </div>
      </div>
    </section>

    {{#if meeting.agenda}}
      <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
        <h2 class="text-sm font-bold text-navy-900">Agenda</h2>
        <p class="mt-2 whitespace-pre-line text-sm leading-relaxed text-slate-600">{{meeting.agenda}}</p>
      </section>
    {{/if}}

    {{#if canManage}}
      <section class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
        <div class="flex items-center justify-between border-b border-slate-100 px-5 py-4">
          <div>
            <h2 class="text-sm font-bold text-navy-900">Attendance</h2>
            <p class="mt-0.5 text-[11px] text-slate-400">Recorded from actual room presence, not from notifications.</p>
          </div>
          <span class="text-[11px] font-semibold text-slate-400">{{participants.length}} record(s)</span>
        </div>
        {{#if participants.length}}
          <div class="overflow-x-auto">
            <table class="min-w-full text-left text-sm">
              <thead class="bg-slate-50 text-[10px] uppercase tracking-wide text-slate-500">
                <tr>
                  <th class="px-5 py-3 font-semibold">Learner</th>
                  <th class="px-4 py-3 font-semibold">Status</th>
                  <th class="px-4 py-3 font-semibold">Joined</th>
                  <th class="px-4 py-3 font-semibold">Left</th>
                  <th class="px-4 py-3 font-semibold">Attended</th>
                  <th class="px-5 py-3 text-right font-semibold">Action</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-100">
                {{#each participants}}
                  {{#if (eq role "learner")}}
                    <tr class="hover:bg-slate-50/70">
                      <td class="px-5 py-3">
                        <div class="flex items-center gap-2.5">
                          <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full text-[10px] font-bold text-white" style="background-color: {{user.avatarColor}}">{{initials user.name}}</span>
                          <div class="min-w-0">
                            <p class="truncate text-xs font-semibold text-navy-900">{{user.name}}</p>
                            <p class="truncate text-[10px] text-slate-400">{{user.email}}</p>
                          </div>
                        </div>
                      </td>
                      <td class="px-4 py-3">
                        <span class="rounded-full px-2.5 py-1 text-[9px] font-bold uppercase tracking-wide
                          {{#if (eq status "joined")}}bg-emerald-50 text-emerald-700
                          {{else if (eq status "invited")}}bg-amber-50 text-amber-700
                          {{else if (eq status "removed")}}bg-rose-50 text-rose-700
                          {{else}}bg-slate-100 text-slate-500{{/if}}">{{status}}</span>
                      </td>
                      <td class="px-4 py-3 text-xs text-slate-500">{{#if joinedAt}}{{formatDateTime joinedAt}}{{else}}—{{/if}}</td>
                      <td class="px-4 py-3 text-xs text-slate-500">{{#if leftAt}}{{formatDateTime leftAt}}{{else}}—{{/if}}</td>
                      <td class="px-4 py-3 text-xs font-semibold text-navy-900">{{#if attendanceSeconds}}{{durationText attendanceSeconds}}{{else}}—{{/if}}</td>
                      <td class="px-5 py-3 text-right">
                        {{#if (eq status "joined")}}
                          <form action="/instructor/live/{{../meeting.id}}/participants/{{userId}}/remove" method="POST" data-confirm="Remove this learner from the live classroom?">
                            <input type="hidden" name="_csrf" value="{{../csrfToken}}" />
                            <button type="submit" class="rounded-lg border border-rose-200 bg-rose-50 px-2.5 py-1.5 text-[10px] font-semibold text-rose-700 transition hover:bg-rose-100">Remove</button>
                          </form>
                        {{else}}
                          <span class="text-[10px] text-slate-400">—</span>
                        {{/if}}
                      </td>
                    </tr>
                  {{/if}}
                {{/each}}
              </tbody>
            </table>
          </div>
        {{else}}
          <p class="px-5 py-8 text-center text-xs text-slate-500">No attendance records yet. Enrolled learners appear after the class is created.</p>
        {{/if}}
      </section>
    {{else}}
      {{#if myParticipant}}
        <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
          <h2 class="text-sm font-bold text-navy-900">Your participation</h2>
          <div class="mt-3 grid gap-3 text-xs text-slate-500 sm:grid-cols-3">
            <div>
              <p class="text-[10px] font-bold uppercase tracking-[0.14em] text-slate-400">Status</p>
              <p class="mt-1 font-semibold capitalize text-navy-900">{{myParticipant.status}}</p>
            </div>
            <div>
              <p class="text-[10px] font-bold uppercase tracking-[0.14em] text-slate-400">Joined</p>
              <p class="mt-1 font-semibold text-navy-900">{{#if myParticipant.joinedAt}}{{formatDateTime myParticipant.joinedAt}}{{else}}Not yet{{/if}}</p>
            </div>
            <div>
              <p class="text-[10px] font-bold uppercase tracking-[0.14em] text-slate-400">Attended</p>
              <p class="mt-1 font-semibold text-navy-900">{{#if myParticipant.attendanceSeconds}}{{durationText myParticipant.attendanceSeconds}}{{else}}—{{/if}}</p>
            </div>
          </div>
        </section>
      {{/if}}
    {{/if}}
  </div>

  <aside class="min-w-0 space-y-4">
    <section class="rounded-2xl bg-navy-900 p-5 text-white">
      <p class="text-[10px] font-bold uppercase tracking-[0.16em] text-brand-300">Before you join</p>
      <ul class="mt-3 space-y-2.5 text-xs text-slate-300">
        <li class="flex gap-2"><span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-brand-400"></span>Allow camera and microphone access in your browser.</li>
        <li class="flex gap-2"><span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-brand-400"></span>Use headphones to avoid echo.</li>
        <li class="flex gap-2"><span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-brand-400"></span>Screen sharing can be turned off by the host.</li>
      </ul>
    </section>
    <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <h2 class="text-sm font-bold text-navy-900">Camera check</h2>
      <p class="mt-1 text-[11px] leading-relaxed text-slate-500">Test your camera before joining. Nothing is recorded or uploaded.</p>
      <div class="relative mt-3 aspect-video overflow-hidden rounded-xl bg-navy-900">
        <video id="camera-preview" autoplay playsinline muted class="hidden h-full w-full object-cover"></video>
        <div id="camera-preview-placeholder" class="absolute inset-0 flex items-center justify-center px-3 text-center text-[11px] text-slate-400">Camera preview is off</div>
      </div>
      <select id="camera-device" class="field mt-3 hidden text-xs" aria-label="Camera device"></select>
      <p id="camera-check-status" class="mt-2 text-[11px] leading-relaxed text-slate-500">Your browser will ask for camera permission when you test.</p>
      <div class="mt-3 flex flex-wrap gap-2">
        <button id="camera-check-start" type="button" class="rounded-xl bg-brand-600 px-3 py-2 text-xs font-semibold text-white transition hover:bg-brand-700">Test camera</button>
        <button id="camera-check-stop" type="button" class="hidden rounded-xl border border-slate-300 bg-white px-3 py-2 text-xs font-semibold text-slate-600 transition hover:bg-slate-50">Stop preview</button>
      </div>
    </section>
    <section class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <h2 class="text-sm font-bold text-navy-900">Only enrolled learners</h2>
      <p class="mt-1 text-[11px] leading-relaxed text-slate-500">The room verifies that you are enrolled in {{meeting.course.title}}. Learners from other courses cannot join, even with the link.</p>
    </section>
  </aside>
</div>

<script src="/js/live-camera-check.js" defer></script>

{{> app_end}}
