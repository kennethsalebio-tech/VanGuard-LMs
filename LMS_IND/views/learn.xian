{{> app_start}}

<div class="mb-4 flex flex-wrap items-center gap-2 text-xs text-slate-400">
  <a href="/courses" class="hover:text-brand-600">Courses</a>
  <span>/</span>
  <a href="/courses/{{lesson.courseId}}" class="max-w-[180px] truncate hover:text-brand-600">{{lesson.course.title}}</a>
  <span>/</span>
  <span class="max-w-[220px] truncate text-slate-600">{{lesson.title}}</span>
</div>

<div class="grid gap-6 xl:grid-cols-[280px_minmax(0,1fr)_300px]">
  <aside class="hidden xl:block">
    <div class="sticky top-24 rounded-2xl border border-slate-200 bg-white shadow-sm">
      <div class="border-b border-slate-100 px-4 py-4">
        <p class="text-[10px] font-bold uppercase tracking-[0.14em] text-slate-400">Course content</p>
        <p class="mt-1 line-clamp-2 text-sm font-bold text-navy-900">{{lesson.course.title}}</p>
      </div>
      <nav class="max-h-[calc(100vh-14rem)] overflow-y-auto p-2">
        {{#each modules}}
          <div class="mb-2">
            <p class="px-2 py-2 text-[10px] font-bold uppercase tracking-[0.12em] text-slate-400">{{title}}</p>
            <div class="space-y-0.5">
              {{#each lessons}}
                <a href="/learn/{{id}}" class="flex items-start gap-2.5 rounded-lg px-2 py-2 text-xs transition {{#if (eq id ../../lesson.id)}}bg-brand-50 font-semibold text-brand-800{{else}}text-slate-600 hover:bg-slate-50{{/if}}">
                  {{#if (eq progress.status "completed")}}
                    <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-emerald-700"><svg class="h-2.5 w-2.5" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg></span>
                  {{else if (eq progress.status "locked")}}
                    <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full bg-slate-100 text-slate-400"><svg class="h-2.5 w-2.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" /></svg></span>
                  {{else}}
                    <span class="mt-0.5 flex h-4 w-4 shrink-0 items-center justify-center rounded-full border-2 border-brand-400"></span>
                  {{/if}}
                  <span class="min-w-0 flex-1 leading-snug">{{title}}</span>
                </a>
              {{/each}}
            </div>
          </div>
        {{/each}}
      </nav>
      <div class="border-t border-slate-100 p-3">
        <a href="/courses/{{lesson.courseId}}" class="flex items-center justify-center rounded-lg border border-slate-300 px-3 py-2 text-xs font-semibold text-navy-900 transition hover:bg-slate-50">Course overview</a>
      </div>
    </div>
  </aside>

  <article class="min-w-0">
    <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-card">
      <div class="border-b border-slate-100 px-6 py-5 sm:px-8">
        <div class="flex flex-wrap items-center gap-2">
          <span class="rounded-full bg-brand-50 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wide text-brand-700">{{lesson.module.title}}</span>
          <span class="rounded-full bg-slate-100 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wide text-slate-600">{{lesson.durationMinutes}} min</span>
          {{#if preview}}<span class="rounded-full bg-amber-100 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wide text-amber-800">Preview</span>{{/if}}
          {{#if (eq progress.status "completed")}}<span class="rounded-full bg-emerald-50 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wide text-emerald-700">Completed</span>{{/if}}
        </div>
        <h1 class="mt-3 text-2xl font-extrabold tracking-tight text-navy-900 sm:text-3xl">{{lesson.title}}</h1>
        {{#if lesson.summary}}<p class="mt-2 text-sm leading-relaxed text-slate-500">{{lesson.summary}}</p>{{/if}}
      </div>

      <div class="lesson-body px-6 py-7 sm:px-8">
        {{{lesson.content.html}}}
      </div>

      {{#if lesson.resources.length}}
        <div class="border-t border-slate-100 bg-slate-50/60 px-6 py-5 sm:px-8">
          <p class="text-[10px] font-bold uppercase tracking-[0.14em] text-slate-400">Learning resources</p>
          <div class="mt-3 space-y-2">
            {{#each lesson.resources}}
              {{#if isDownloadable}}
                <a href="/resources/{{id}}/download" class="flex items-center gap-3 rounded-xl border border-slate-200 bg-white px-4 py-3 transition hover:border-brand-300 hover:bg-brand-50/40">
                  <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-navy-50 text-navy-700"><svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" /></svg></span>
                  <div class="min-w-0 flex-1">
                    <p class="truncate text-xs font-semibold text-navy-900">{{title}}</p>
                    <p class="text-[10px] text-slate-400">Original module file · downloadable</p>
                  </div>
                  <span class="text-[10px] font-bold uppercase tracking-wide text-brand-600">Download</span>
                </a>
              {{/if}}
            {{/each}}
          </div>
        </div>
      {{/if}}

      <div class="flex flex-col gap-3 border-t border-slate-100 px-6 py-5 sm:flex-row sm:items-center sm:justify-between sm:px-8">
        {{#if prevLesson}}
          <a href="/learn/{{prevLesson.id}}" class="inline-flex items-center gap-2 rounded-xl border border-slate-300 px-4 py-2.5 text-sm font-semibold text-navy-900 transition hover:bg-slate-50">
            <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M11 17l-5-5m0 0l5-5m-5 5h12" /></svg>
            Previous lesson
          </a>
        {{else}}<span></span>{{/if}}

        {{#if (eq progress.status "completed")}}
          {{#if nextLesson}}
            <a href="/learn/{{nextLesson.id}}" class="inline-flex items-center gap-2 rounded-xl bg-brand-600 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-700">
              Next lesson
              <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
            </a>
          {{else}}
            <a href="/courses/{{lesson.courseId}}" class="inline-flex items-center gap-2 rounded-xl bg-emerald-600 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-emerald-700">Finish course</a>
          {{/if}}
        {{/if}}
      </div>
    </div>
  </article>

  <aside class="space-y-4">
    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <p class="text-[10px] font-bold uppercase tracking-[0.14em] text-slate-400">Knowledge check</p>
      {{#if preview}}
        <p class="mt-2 text-sm leading-relaxed text-slate-600">You are previewing as staff. Knowledge checks, progress, and certificates are not recorded for instructors.</p>
        <a href="/instructor/lessons/{{lesson.id}}/questions" class="mt-4 flex items-center justify-center rounded-xl bg-brand-600 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-700">Manage question bank</a>
      {{else}}
        <div class="mt-3 flex items-end justify-between">
          <div>
            <p class="text-2xl font-extrabold text-navy-900">{{approvedCount}}</p>
            <p class="text-[11px] text-slate-400">approved questions</p>
          </div>
          <div class="text-right">
            <p class="text-2xl font-extrabold text-navy-900">{{requiredQuestions}}</p>
            <p class="text-[11px] text-slate-400">drawn per attempt</p>
          </div>
        </div>
        <div class="mt-3 h-2 overflow-hidden rounded-full bg-slate-100">
          <div class="h-full rounded-full bg-brand-500" style="width: {{#if (gt approvedCount requiredQuestions)}}100{{else}}{{approvedCount}}{{/if}}%"></div>
        </div>

        {{#if (eq progress.status "completed")}}
          <div class="mt-4 rounded-xl border border-emerald-200 bg-emerald-50 p-3">
            <p class="text-xs font-semibold text-emerald-800">Passed · best {{progress.bestScore}}/{{progress.totalQuestions}}</p>
            <p class="mt-0.5 text-[10px] text-emerald-600">{{progress.attempts}} attempt(s) recorded</p>
          </div>
          {{#if lesson.course.allowRetakes}}
            <a href="/learn/{{lesson.id}}/quiz" class="mt-3 flex items-center justify-center rounded-xl border border-slate-300 px-4 py-2.5 text-sm font-semibold text-navy-900 transition hover:bg-slate-50">Retake the check</a>
          {{/if}}
        {{else}}
          {{#if (lt approvedCount requiredQuestions)}}
            <p class="mt-4 rounded-xl bg-amber-50 p-3 text-xs leading-relaxed text-amber-700">The instructor is still preparing enough approved questions. Study the lesson and check back shortly.</p>
          {{else}}
            <a href="/learn/{{lesson.id}}/quiz" class="mt-4 flex items-center justify-center gap-2 rounded-xl bg-brand-600 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-brand-700">
              Take the knowledge check
              <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" /></svg>
            </a>
          {{/if}}
          <p class="mt-2 text-center text-[10px] text-slate-400">Pass {{lesson.course.passScore}} of {{lesson.course.questionCount}} to unlock the next lesson.</p>
        {{/if}}
      {{/if}}
    </div>

    <div class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm">
      <p class="text-[10px] font-bold uppercase tracking-[0.14em] text-slate-400">Lesson progress</p>
      <p class="mt-2 text-sm font-semibold capitalize text-navy-900">{{progress.status}}</p>
      <p class="mt-1 text-[11px] leading-relaxed text-slate-500">Unlocks are enforced on the server. Opening a locked lesson URL directly is rejected.</p>
    </div>

    {{#if (eq progress.status "completed")}}
      {{#unless nextLesson}}
        <div class="rounded-2xl border border-emerald-200 bg-emerald-50 p-5">
          <p class="text-[10px] font-bold uppercase tracking-[0.14em] text-emerald-700">Final lesson</p>
          <p class="mt-2 text-sm text-emerald-900">You have completed the last lesson. Check the course overview for certificate availability.</p>
          <a href="/certificates" class="mt-3 inline-flex text-xs font-bold text-emerald-800 underline underline-offset-4">View certificates</a>
        </div>
      {{/unless}}
    {{/if}}

    <div class="rounded-2xl bg-navy-900 p-5 text-white">
      <p class="text-[10px] font-bold uppercase tracking-[0.16em] text-brand-300">Study tip</p>
      <p class="mt-2 text-sm leading-relaxed text-slate-300">Read the full lesson before starting the check. Each attempt draws a different random set, so memorizing a single set will not help.</p>
    </div>
  </aside>
</div>

{{> app_end}}
