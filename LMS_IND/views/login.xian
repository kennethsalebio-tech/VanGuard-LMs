{{> head}}
<body class="min-h-full bg-white text-slate-700 antialiased">
  <div class="grid min-h-screen lg:grid-cols-[1.02fr_1fr]">
    <aside class="relative hidden overflow-hidden border-r border-slate-200 bg-[#f7fafe] p-12 lg:flex lg:flex-col lg:justify-between">
      <div class="pointer-events-none absolute inset-0 hero-grid"></div>
      <div class="pointer-events-none absolute -right-24 top-16 h-80 w-80 rounded-full bg-brand-100/70 blur-2xl"></div>
      <div class="pointer-events-none absolute -bottom-24 -left-16 h-80 w-80 rounded-full bg-emerald-100/50 blur-2xl"></div>

      <a href="/" class="relative flex items-center gap-3">
        <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-brand-500 shadow-lg shadow-brand-500/20">
          <svg class="h-5 w-5 text-white" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" /></svg>
        </span>
        <span>
          <span class="block text-[15px] font-extrabold leading-tight tracking-tight text-navy-900">Vanguard Learning</span>
          <span class="mt-0.5 block text-[9px] font-bold uppercase tracking-[0.16em] text-slate-400">Integrated LMS</span>
        </span>
      </a>

      <div class="relative max-w-md">
        <span class="eyebrow">Welcome back</span>
        <h1 class="mt-5 text-[2.4rem] font-extrabold leading-[1.1] tracking-[-0.03em] text-navy-900">
          Learning that<br /><span class="text-brand-500">proves itself.</span>
        </h1>
        <p class="mt-4 text-[14px] leading-relaxed text-slate-600">
          Pick up your lessons, review your progress, and keep every certificate within reach.
        </p>

        <div class="mt-8 space-y-3">
          <div class="flex items-start gap-3 rounded-2xl border border-slate-200 bg-white p-4">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-brand-50 text-brand-600">
              <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" /></svg>
            </span>
            <div>
              <p class="text-[12px] font-bold text-navy-900">Instructor-controlled question banks</p>
              <p class="mt-1 text-[11px] leading-relaxed text-slate-500">Every generated question is reviewed before it reaches a knowledge check.</p>
            </div>
          </div>
          <div class="flex items-start gap-3 rounded-2xl border border-slate-200 bg-white p-4">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-emerald-50 text-emerald-600">
              <svg class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>
            </span>
            <div>
              <p class="text-[12px] font-bold text-navy-900">Automatic lesson unlocking</p>
              <p class="mt-1 text-[11px] leading-relaxed text-slate-500">Pass the randomized check and the next lesson opens immediately.</p>
            </div>
          </div>
        </div>
      </div>

      <p class="relative text-[11px] text-slate-400">© 2026 Vanguard Learning · Integrated LMS</p>
    </aside>

    <div class="flex flex-col">
      <div class="flex items-center justify-between gap-3 border-b border-slate-100 px-5 py-4 lg:hidden">
        <a href="/" class="flex min-w-0 items-center gap-2.5">
          <span class="flex h-8 w-8 items-center justify-center rounded-lg bg-brand-500">
            <svg class="h-4 w-4 text-white" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" /></svg>
          </span>
          <span class="truncate text-[13px] font-extrabold text-navy-900">Vanguard Learning</span>
        </a>
        <a href="/register" class="shrink-0 whitespace-nowrap text-[12px] font-semibold text-brand-600">Create account</a>
      </div>

      <div class="flex flex-1 items-center justify-center px-5 py-10 sm:px-10">
        <div class="w-full max-w-[390px]">
          <span class="eyebrow">Sign in</span>
          <h2 class="mt-4 text-[1.8rem] font-extrabold tracking-tight text-navy-900">Welcome back</h2>
          <p class="mt-2 text-[13px] text-slate-500">Sign in to continue your training.</p>

          <div class="mt-6">{{> flash}}</div>

          {{#if googleEnabled}}
          <a href="/auth/google{{#if next}}?next={{next}}{{/if}}" class="mt-6 flex w-full items-center justify-center gap-2.5 rounded-xl border border-slate-200 bg-white px-4 py-3 text-[13px] font-semibold text-slate-700 transition hover:border-slate-300 hover:bg-slate-50">
            <svg class="h-4 w-4" viewBox="0 0 24 24" aria-hidden="true">
              <path fill="#4285F4" d="M21.6 12.23c0-.71-.06-1.4-.18-2.07H12v3.92h5.38a4.6 4.6 0 0 1-2 3.02v2.54h3.24c1.9-1.75 2.98-4.33 2.98-7.41Z"/>
              <path fill="#34A853" d="M12 22c2.7 0 4.96-.9 6.62-2.36l-3.24-2.54c-.9.6-2.05.96-3.38.96-2.61 0-4.82-1.76-5.61-4.12H3.04v2.62A10 10 0 0 0 12 22Z"/>
              <path fill="#FBBC05" d="M6.39 13.94a6 6 0 0 1 0-3.88V7.44H3.04a10 10 0 0 0 0 9.12l3.35-2.62Z"/>
              <path fill="#EA4335" d="M12 5.94c1.47 0 2.79.5 3.83 1.5l2.87-2.88A9.62 9.62 0 0 0 12 2a10 10 0 0 0-8.96 5.44l3.35 2.62C7.18 7.7 9.39 5.94 12 5.94Z"/>
            </svg>
            Continue with Google
          </a>
          <div class="relative mt-5">
            <div class="absolute inset-0 flex items-center"><span class="w-full border-t border-slate-200"></span></div>
            <div class="relative flex justify-center"><span class="bg-white px-3 text-[10px] font-semibold uppercase tracking-[0.12em] text-slate-400">or sign in with email</span></div>
          </div>
          {{/if}}

          <form action="/login" method="POST" class="mt-6 space-y-4">
            <input type="hidden" name="_csrf" value="{{csrfToken}}" />
            <input type="hidden" name="next" value="{{next}}" />
            <div>
              <label for="email" class="label">Work email</label>
              <input id="email" name="email" type="email" autocomplete="email" required class="field" placeholder="you@company.com" />
            </div>
            <div>
              <div class="flex items-center justify-between">
                <label for="password" class="label">Password</label>
                <a href="/forgot-password" class="mb-1 text-[11px] font-semibold text-brand-600 hover:text-brand-700">Forgot password?</a>
              </div>
              <input id="password" name="password" type="password" autocomplete="current-password" required class="field" placeholder="••••••••" />
            </div>
           
<button
  type="submit"
  class="group flex w-full items-center justify-center gap-3 rounded-xl bg-blue-600 px-6 py-3.5 text-base font-semibold text-white shadow-md shadow-blue-600/20 transition-all duration-300 hover:-translate-y-0.5 hover:bg-blue-700 hover:shadow-lg hover:shadow-blue-600/30 active:translate-y-0 active:scale-[0.98] focus:outline-none focus:ring-4 focus:ring-blue-500/20"
>
  <span>Sign in</span>
  <svg
    class="h-5 w-5 transition-transform duration-300 group-hover:translate-x-1"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    viewBox="0 0 24 24"
  >
    <path
      stroke-linecap="round"
      stroke-linejoin="round"
      d="M13 7l5 5m0 0l-5 5m5-5H6"
    />
  </svg>
</button>

          </form>

          <p class="mt-5 text-center text-[12px] text-slate-500">
            New to Vanguard Learning? <a href="/register" class="font-semibold text-brand-600 hover:text-brand-700">Create a learner account</a>
          </p>

          <p class="mt-6 text-center text-[10px] leading-relaxed text-slate-400">
            Access is protected by role-based authorization. Staff accounts are provisioned by an administrator.
          </p>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
