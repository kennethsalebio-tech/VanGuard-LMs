<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Payment result · Vanguard Billing</title>
  <link rel="stylesheet" href="/lms.css" />
  <style>
    .sandbox-wrap { max-width: 560px; margin: 48px auto; padding: 0 20px 60px; font-family: "DM Sans", system-ui, sans-serif; }
    .sandbox-card { background: #fff; border: 1px solid #e2e8f0; border-radius: 18px; padding: 28px; box-shadow: 0 18px 45px -30px rgba(11,31,58,.35); }
    .sandbox-banner { background: #fff7ed; border: 1px solid #fed7aa; color: #9a3412; border-radius: 12px; padding: 12px 14px; font-size: 13px; line-height: 1.5; margin-bottom: 22px; }
    .sandbox-row { display: flex; justify-content: space-between; gap: 16px; padding: 9px 0; font-size: 14px; border-bottom: 1px dashed #e2e8f0; }
    .sandbox-row:last-child { border-bottom: 0; }
    .sandbox-row span { color: #64748b; }
    .sandbox-row strong { color: #0b1f3a; text-align: right; }
  </style>
</head>
<body class="lms-body">
  <div class="sandbox-wrap">
    <div class="brand" style="margin-bottom: 18px;">
      <span class="brand-mark">V<span>.</span></span>
      <span class="brand-copy"><strong>vanguard</strong><small>BILLING SERVICE</small></span>
    </div>

    <div class="sandbox-card">
      <div class="sandbox-banner">
        <strong>SANDBOX TEST MODE.</strong> Results below come from the simulated provider. No real payment was collected.
      </div>

      <p class="eyebrow">PAYMENT RESULT</p>

      {{#if payment}}
        <h1 style="font-size: 22px; color: #0b1f3a; margin: 6px 0 16px; text-transform: capitalize;">
          {{#if (eq payment.status "paid")}}Payment verified{{else if (eq payment.status "pending")}}Payment pending{{else if (eq payment.status "refunded")}}Payment refunded{{else}}Payment not completed{{/if}}
        </h1>

        <div class="sandbox-row"><span>Reference</span><strong>{{payment.reference}}</strong></div>
        <div class="sandbox-row"><span>Course</span><strong>{{payment.courseTitle}}</strong></div>
        <div class="sandbox-row"><span>Amount</span><strong>{{payment.currency}} {{payment.amount}}</strong></div>
        <div class="sandbox-row"><span>Status</span><strong style="text-transform: capitalize;">{{payment.status}}</strong></div>
        {{#if payment.receiptNumber}}
          <div class="sandbox-row"><span>Receipt</span><strong>{{payment.receiptNumber}}</strong></div>
        {{/if}}

        <p style="margin: 22px 0 0;">
          <a class="button button-primary" href="{{returnUrl}}">Return to LMS to continue</a>
        </p>
        <p style="font-size: 12px; color: #94a3b8; margin-top: 14px; line-height: 1.6;">
          Course access is granted by the LMS only after it confirms this payment directly with the billing API. Bookmarking this page never unlocks a course.
        </p>
      {{else}}
        <h1 style="font-size: 22px; color: #0b1f3a; margin: 6px 0 16px;">Payment not found</h1>
        <p style="font-size: 14px; color: #64748b;">That payment reference does not exist on this billing service.</p>
        <p style="margin: 22px 0 0;"><a class="button button-primary" href="{{returnUrl}}">Return to LMS</a></p>
      {{/if}}
    </div>
  </div>
</body>
</html>
