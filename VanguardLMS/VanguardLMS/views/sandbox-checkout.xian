<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Sandbox checkout · Vanguard Billing</title>
  <link rel="stylesheet" href="/lms.css" />
  <style>
    .sandbox-wrap { max-width: 560px; margin: 48px auto; padding: 0 20px 60px; font-family: "DM Sans", system-ui, sans-serif; }
    .sandbox-card { background: #fff; border: 1px solid #e2e8f0; border-radius: 18px; padding: 28px; box-shadow: 0 18px 45px -30px rgba(11,31,58,.35); }
    .sandbox-banner { background: #fff7ed; border: 1px solid #fed7aa; color: #9a3412; border-radius: 12px; padding: 12px 14px; font-size: 13px; line-height: 1.5; margin-bottom: 22px; }
    .sandbox-row { display: flex; justify-content: space-between; gap: 16px; padding: 9px 0; font-size: 14px; border-bottom: 1px dashed #e2e8f0; }
    .sandbox-row:last-child { border-bottom: 0; }
    .sandbox-row span { color: #64748b; }
    .sandbox-row strong { color: #0b1f3a; text-align: right; }
    .sandbox-total { font-size: 28px; font-weight: 800; color: #0b1f3a; margin: 10px 0 2px; }
    .sandbox-actions { display: flex; flex-direction: column; gap: 10px; margin-top: 24px; }
    .sandbox-actions form { margin: 0; }
    .sandbox-actions .button { width: 100%; justify-content: center; }
    .sandbox-muted { font-size: 12px; color: #94a3b8; margin-top: 18px; line-height: 1.6; }
  </style>
</head>
<body class="lms-body">
  <div class="sandbox-wrap">
    <div class="brand" style="margin-bottom: 18px;">
      <span class="brand-mark">V<span>.</span></span>
      <span class="brand-copy"><strong>vanguard</strong><small>BILLING SERVICE</small></span>
    </div>

    <div class="sandbox-card">
      <div class="sandbox-banner">
        <strong>SANDBOX TEST MODE.</strong> This page simulates a payment provider. No card is charged and no real money moves. A payment only becomes verified when a signed provider callback reaches the billing service.
      </div>

      <p class="eyebrow">COURSE CHECKOUT</p>
      <h1 style="font-size: 22px; color: #0b1f3a; margin: 6px 0 4px;">{{payment.courseTitle}}</h1>
      <p style="color: #64748b; font-size: 13px; margin: 0 0 18px;">Reference {{payment.reference}}</p>

      <div class="sandbox-row"><span>Learner</span><strong>{{payment.learnerName}}</strong></div>
      <div class="sandbox-row"><span>Email</span><strong>{{payment.learnerEmail}}</strong></div>
      <div class="sandbox-row"><span>Status</span><strong style="text-transform: capitalize;">{{payment.status}}</strong></div>

      <p class="sandbox-total">{{payment.currency}} {{payment.amount}}</p>
      <p style="color: #64748b; font-size: 13px; margin: 0;">Amount payable in Philippine pesos</p>

      {{#if canPay}}
        <div class="sandbox-actions">
          <form action="/checkout/{{payment.reference}}/pay" method="POST">
            <input type="hidden" name="outcome" value="paid" />
            <button type="submit" class="button button-primary">Simulate successful payment</button>
          </form>
          <form action="/checkout/{{payment.reference}}/pay" method="POST">
            <input type="hidden" name="outcome" value="failed" />
            <button type="submit" class="button button-outline">Simulate a failed payment</button>
          </form>
          <form action="/checkout/{{payment.reference}}/pay" method="POST">
            <input type="hidden" name="outcome" value="cancelled" />
            <button type="submit" class="button button-outline">Cancel this payment</button>
          </form>
        </div>
      {{else}}
        <div class="sandbox-actions">
          <a class="button button-primary" href="/checkout/{{payment.reference}}/done">View payment result</a>
        </div>
      {{/if}}

      <p class="sandbox-muted">
        Identity of this transaction is verified by reference on the billing server. Any learner can only reach this page with the unguessable reference issued to their own checkout.
      </p>
    </div>
  </div>
</body>
</html>
